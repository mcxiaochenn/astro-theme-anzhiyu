---
import PageLayout from "@/layouts/PageLayout.astro";
import { getSiteData } from "@/data/site-data";

interface AlbumGroup {
  class_name: string;
  description?: string;
  cover?: string;
  path_name?: string;
  top_background?: string;
}

const albums = getSiteData<AlbumGroup[]>("album") ?? [];
const topBg = albums[0]?.top_background || "/img/demo/anime/anime-02-tall.jpg";
---

<PageLayout title="相册集" showAside={false} showPageTitle={false} pageType="album">
  <div id="album">
    <div
      class="author-content author-content-item album single"
      style={`background: url(${topBg}) top / cover no-repeat;`}
    >
      <div class="card-content">
        <div class="author-content-item-tips">相册集</div>
        <span class="author-content-item-title">这里是我的相册集哦😯</span>
        <div class="content-bottom">
          <div class="tips">每一张照片都是一次美好的记忆。</div>
        </div>
        <div class="banner-button-group">
          <a class="banner-button" href="/about/">
            <i class="anzhiyufont anzhiyu-icon-arrow-circle-right" style="font-size: 1.5rem" />
            <span class="banner-button-text">关于本人</span>
          </a>
        </div>
      </div>
    </div>

    <div class="card-album">
      {
        albums.map((item, idx) => {
          const href = item.path_name || `/album/${idx + 1}/`;
          const cover = item.cover || "/img/default_cover.jpg";
          return (
            <a class="card" href={href} style="text-decoration: none;">
              <img class="card_cover no-lightbox" src={cover} alt={item.class_name} loading="lazy" />
              <div class="card__content">
                <p class="card__category">{item.class_name}</p>
                <h3 class="card__heading">{item.description}</h3>
              </div>
            </a>
          );
        })
      }
      <div class="album-content-nocover" />
      <div class="album-content-nocover" />
      <div class="album-content-nocover" />
    </div>
  </div>
</PageLayout>
