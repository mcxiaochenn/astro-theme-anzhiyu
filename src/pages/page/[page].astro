---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryBar from "@/components/home/CategoryBar.astro";
import PostCard from "@/components/home/PostCard.astro";
import Pagination from "@/components/home/Pagination.astro";
import { siteConfig } from "@/config";
import { aggregateCategories, getAllPosts } from "@/utils/posts";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const pageSize = siteConfig.pageSize;
  const totalPages = Math.ceil(posts.length / pageSize);
  const paths = [];
  for (let p = 2; p <= totalPages; p++) {
    paths.push({
      params: { page: String(p) },
      props: {
        currentPage: p,
        totalPages,
        pagePosts: posts.slice((p - 1) * pageSize, p * pageSize),
        categories: aggregateCategories(posts),
      },
    });
  }
  return paths;
}

const { currentPage, totalPages, pagePosts, categories } = Astro.props;
---

<BaseLayout title={`第 ${currentPage} 页`} pageType="anzhiyu">
  <div class="recent-posts" id="recent-posts">
    <CategoryBar categories={categories} />
    {pagePosts.map((post, i) => <PostCard post={post} index={i} />)}
    <Pagination currentPage={currentPage} totalPages={totalPages} />
  </div>
</BaseLayout>
