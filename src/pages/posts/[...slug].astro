---
import { render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import { getAllPosts, getPostUrl, getRelatedPosts } from "@/utils/posts";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post, idx) => {
    const slug = getPostUrl(post).replace(/^\/posts\//, "").replace(/\/$/, "");
    return {
      params: { slug },
      props: {
        post,
        prev: idx > 0 ? posts[idx - 1] : undefined,
        next: idx < posts.length - 1 ? posts[idx + 1] : undefined,
        related: getRelatedPosts(post, posts, 4),
      },
    };
  });
}

const { post, prev, next, related } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} prev={prev} next={next} related={related}>
  <Content />
</PostLayout>
