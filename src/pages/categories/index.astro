---
import PageLayout from "@/layouts/PageLayout.astro";
import { aggregateCategories, getAllPosts } from "@/utils/posts";

const posts = await getAllPosts();
const categories = aggregateCategories(posts);
---

<PageLayout title="分类" showAside={false} pageType="categories">
  <div id="tag">
    <div class="category-lists" id="tag-page-tags">
      {
        categories.map((cat) => (
          <a href={`/categories/${encodeURIComponent(cat.name)}/`} id={`/categories/${cat.name}/`}>
            <span class="tags-punctuation">
              <i class="anzhiyufont anzhiyu-icon-folder-open" />
            </span>
            {cat.name}
            <span class="tagsPageCount">{cat.count}</span>
          </a>
        ))
      }
    </div>
  </div>
</PageLayout>
