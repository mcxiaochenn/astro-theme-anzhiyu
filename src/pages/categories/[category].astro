---
import PageLayout from "@/layouts/PageLayout.astro";
import PostCard from "@/components/home/PostCard.astro";
import { aggregateCategories, getAllPosts } from "@/utils/posts";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const categories = aggregateCategories(posts);
  return categories.map((cat) => ({
    params: { category: cat.name },
    props: { categoryName: cat.name, posts: cat.posts },
  }));
}

const { categoryName, posts } = Astro.props;
---

<PageLayout title={`分类：${categoryName}`}>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {posts.map((post, i) => <PostCard post={post} index={i} />)}
  </div>
</PageLayout>
