---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryBar from "@/components/home/CategoryBar.astro";
import ArticleSort from "@/components/archive/ArticleSort.astro";
import { aggregateCategories, getAllPosts, normalizeCategoryList } from "@/utils/posts";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const categories = aggregateCategories(posts);
  return categories.map((cat) => ({
    params: { category: cat.name },
    props: {
      categoryName: cat.name,
      categories,
      posts: posts.filter((p) => normalizeCategoryList(p.data.categories).includes(cat.name)),
    },
  }));
}

const { categoryName, categories, posts } = Astro.props;
---

<BaseLayout title={`分类: ${categoryName}`} pageType="categories">
  <div id="category">
    <CategoryBar categories={categories} activeCategory={categoryName} />
    <ArticleSort title={`分类 - ${categoryName}`} posts={posts} />
  </div>
</BaseLayout>
