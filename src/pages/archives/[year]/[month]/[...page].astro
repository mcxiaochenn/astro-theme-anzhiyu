---
/**
 * P2-9 · 月归档与分页：`/archives/2025/04/`（以及 `/archives/2025/04/page/2/`）
 *
 * 上游 hexo-generator-archive 的 `monthly: true` 分支，模板仍是 `layout/archive.pug`：
 * `page.posts` 是该月文章，`getArchiveLength()` 返回该月文章数，标题经
 * `findArchivesTitle` 按 `aside.card_archives.format`（`MMMM YYYY`）格式化成「四月 2025」。
 *
 * 路由参数：`[year]` + `[month]` + rest `[...page]`。
 *   - `/archives/2025/04/`        → `{ year: '2025', month: '04', page: undefined }`
 *   - `/archives/2025/04/page/2/` → `{ year: '2025', month: '04', page: 'page/2' }`
 * 月份补零是 URL 约定（`archive_generator` 的路径格式），与 frontmatter 的 `MM` 对齐。
 */
import type { GetStaticPaths } from 'astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ArticleSort from '@/components/archive/ArticleSort.astro'
import Pagination from '@/components/archive/Pagination.astro'
import '../../../../styles/upstream/index.styl'
import {
  ARCHIVE_PER_PAGE,
  BASELINE_SITE,
  SITE_PER_PAGE,
  articlesSortTitle,
  archivesTitle,
  filterArchivePosts,
  hexoPageUrl,
  loadArchiveSite,
  pageCount,
  slicePage,
  toArticleSortPosts,
  urlFor,
} from '../../_data.ts'

export const getStaticPaths: GetStaticPaths = async () => {
  const data = await loadArchiveSite()
  // 年月组合（按出现顺序去重；生成顺序不影响产物）
  const months = new Map<string, { year: string; month: string }>()
  for (const post of data.posts) {
    const year = String(post.year)
    const month = String(post.month).padStart(2, '0')
    months.set(`${year}-${month}`, { year, month })
  }
  return [...months.values()].flatMap(({ year, month }) => {
    const posts = filterArchivePosts(data, { year, month })
    const total = pageCount(posts.length, ARCHIVE_PER_PAGE)
    return Array.from({ length: total }, (_, index) => {
      const current = index + 1
      return {
        params: {
          year,
          month,
          page: current === 1 ? undefined : `page/${current}`,
        },
        props: { year, month, current, total },
      }
    })
  })
}

interface Props {
  year: string
  month: string
  current: number
  total: number
}

const { year, month, current, total } = Astro.props as Props
const data = await loadArchiveSite()
const page = { year, month }
const posts = toArticleSortPosts(
  slicePage(filterArchivePosts(data, page), ARCHIVE_PER_PAGE, current),
)
---

<BaseLayout
  site={BASELINE_SITE}
  title={archivesTitle(page, data)}
  ogType="website"
  pageType="page"
  pageUrl={hexoPageUrl(BASELINE_SITE, Astro.url.pathname)}
>
  <div id="archive">
    <div class="article-sort-title">{articlesSortTitle(data, page)}</div>
    <ArticleSort posts={posts} current={current} perPage={SITE_PER_PAGE} />
    <Pagination
      current={current}
      total={total}
      basePath={urlFor(`/archives/${year}/${month}/`)}
    />
  </div>
</BaseLayout>
