---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleSort from "@/components/archive/ArticleSort.astro";
import { getAllPosts } from "@/utils/posts";

const posts = await getAllPosts();
---

<BaseLayout title="文章归档" pageType="archive">
  <ArticleSort title="文章总览" posts={posts} />
</BaseLayout>
