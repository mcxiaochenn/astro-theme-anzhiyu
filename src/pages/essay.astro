---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageBanner from "@/components/page/PageBanner.astro";
import { getSiteData } from "@/data/site-data";

interface EssayEntry {
  content: string;
  date?: string;
  image?: string[];
}

interface EssaySection {
  title?: string;
  subTitle?: string;
  tips?: string;
  buttonText?: string;
  buttonLink?: string;
  top_background?: string;
  essay_list?: EssayEntry[];
}

const section = (getSiteData<EssaySection[]>("essay") ?? [])[0] ?? {};
const list = section.essay_list ?? [];
---

<BaseLayout title={section.title || "即刻短文"} description={section.subTitle}>
  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-6">
    <PageBanner
      tips="ESSAY"
      title={section.title || "即刻短文"}
      subTitle={section.tips || section.subTitle}
      background={section.top_background}
      buttonText={section.buttonText}
      buttonLink={section.buttonLink}
    />

    <div class="bber-list">
      {
        list.map((item) => (
          <article class="bber-item anzhiyu-card anzhiyu-card-hover">
            <div class="bber-content">{item.content}</div>
            {item.image && item.image.length > 0 && (
              <div class="bber-images">
                {item.image.map((src) => (
                  <img src={src} alt="说说配图" class="bber-img" loading="lazy" />
                ))}
              </div>
            )}
            <hr class="bber-hr" />
            <div class="bber-bottom">
              <time class="bber-date">🕒 {item.date ?? ""}</time>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .bber-list {
    column-count: 3;
    column-gap: 1rem;
  }

  .bber-item {
    break-inside: avoid;
    margin-bottom: 1rem;
    padding: 1.15rem 1.25rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bber-content {
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--anzhiyu-fontcolor);
  }

  .bber-images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .bber-img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: 8px;
  }

  .bber-hr {
    border: 0;
    border-top: 1px dashed var(--anzhiyu-card-border);
    margin: 0.2rem 0;
  }

  .bber-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .bber-date {
    font-size: 0.76rem;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--anzhiyu-secondbg);
    color: var(--anzhiyu-secondtext);
  }

  @media (max-width: 1024px) {
    .bber-list {
      column-count: 2;
    }
  }

  @media (max-width: 640px) {
    .bber-list {
      column-count: 1;
    }
  }
</style>
