---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomeTop from "@/components/home/HomeTop.astro";
import BbTimeList from "@/components/home/BbTimeList.svelte";
import CategoryBar from "@/components/home/CategoryBar.astro";
import PostCard from "@/components/home/PostCard.astro";
import Pagination from "@/components/home/Pagination.astro";
import { siteConfig, themeConfig } from "@/config";
import { aggregateCategories, getAllPosts } from "@/utils/posts";
import { getSiteData } from "@/data/site-data";

const allPosts = await getAllPosts();
const categories = aggregateCategories(allPosts);
const pageSize = siteConfig.pageSize;
const totalPages = Math.max(1, Math.ceil(allPosts.length / pageSize));
const pagePosts = allPosts.slice(0, pageSize);

const essayData = getSiteData<Array<{ essay_list?: { content: string; date?: string; image?: string[] }[] }>>("essay");
const essayItems = essayData?.[0]?.essay_list?.slice(0, 10) ?? [];
---

<BaseLayout isHome={true} pageType="anzhiyu">
  <Fragment slot="top-area">
    {themeConfig.home.bbTimeEnable && <BbTimeList client:idle items={essayItems} />}
    <HomeTop posts={allPosts} />
  </Fragment>

  <div class="recent-posts" id="recent-posts">
    <CategoryBar categories={categories} />
    {pagePosts.map((post, i) => <PostCard post={post} index={i} />)}
    <Pagination currentPage={1} totalPages={totalPages} />
  </div>
</BaseLayout>
