---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 - 页面未找到">
  <div class="max-w-xl mx-auto px-6 py-20 text-center">
    <div class="anzhiyu-card p-8 flex flex-col items-center gap-4">
      <div class="text-6xl font-black text-[var(--anzhiyu-main)]">404</div>
      <h1 class="text-xl font-bold m-0">抱歉，页面未找到</h1>
      <p class="text-sm text-[var(--anzhiyu-secondtext)] m-0">
        你访问的页面可能已被移动、删除或链接有误。
      </p>
      <a
        href="/"
        class="mt-2 px-6 py-2.5 rounded-full bg-[var(--anzhiyu-main)] text-white font-semibold text-sm hover:opacity-90 transition-opacity"
      >
        返回首页
      </a>
    </div>
  </div>
</BaseLayout>
