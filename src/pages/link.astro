---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageBanner from "@/components/page/PageBanner.astro";
import { getSiteData } from "@/data/site-data";

interface FriendItem {
  name: string;
  link: string;
  avatar: string;
  descr?: string;
  siteshot?: string;
  tag?: string;
  color?: string;
}

interface LinkGroup {
  class_name: string;
  flink_style?: string;
  class_desc?: string;
  link_list: FriendItem[];
}

const groups = getSiteData<LinkGroup[]>("link") ?? [];
---

<BaseLayout title="友人帐">
  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-6">
    <PageBanner
      tips="FRIENDS"
      title="与数百名博主一起进步"
      subTitle="有朋自远方来，不亦乐乎"
      background="/img/demo/anime/anime-05-tall.jpg"
      buttonText="关于我"
      buttonLink="/about/"
    />

    <div class="flex flex-col gap-10 mt-6">
      {
        groups.map((group) => (
          <section>
            <div class="mb-4">
              <h2 class="text-xl font-extrabold m-0">{group.class_name}</h2>
              {group.class_desc && (
                <p class="text-sm text-[var(--anzhiyu-secondtext)] mt-1 mb-0">{group.class_desc}</p>
              )}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {group.link_list.map((item) => (
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flink-card anzhiyu-card anzhiyu-card-hover group"
                >
                  {item.tag && <span class="site-card-tag">{item.tag}</span>}
                  {item.siteshot && (
                    <div class="siteshot-wrap">
                      <img src={item.siteshot} alt={item.name} class="siteshot-img" loading="lazy" />
                    </div>
                  )}
                  <div class="flink-meta">
                    <img src={item.avatar} alt={item.name} class="flink-avatar" loading="lazy" />
                    <div class="min-w-0 flex-1">
                      <div class="flink-name">{item.name}</div>
                      {item.descr && <div class="flink-desc">{item.descr}</div>}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .flink-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 12px;
    transition: transform 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  }

  .flink-card:hover {
    transform: translateY(-3px);
  }

  .site-card-tag {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--anzhiyu-main);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
  }

  .siteshot-wrap {
    width: 100%;
    height: 130px;
    overflow: hidden;
    background: var(--anzhiyu-secondbg);
  }

  .siteshot-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .flink-card:hover .siteshot-img {
    transform: scale(1.06);
  }

  .flink-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
  }

  .flink-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--anzhiyu-card-border);
    transition: transform 0.35s ease;
  }

  .flink-card:hover .flink-avatar {
    transform: scale(0.92);
  }

  .flink-name {
    font-weight: 700;
    font-size: 0.96rem;
    color: var(--anzhiyu-fontcolor);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .flink-card:hover .flink-name {
    color: var(--anzhiyu-main);
  }

  .flink-desc {
    font-size: 0.8rem;
    color: var(--anzhiyu-secondtext);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 2px;
  }
</style>
