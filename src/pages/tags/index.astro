---
import PageLayout from "@/layouts/PageLayout.astro";
import { aggregateTags, getAllPosts } from "@/utils/posts";

const posts = await getAllPosts();
const tags = aggregateTags(posts);
---

<PageLayout title="标签" showAside={false} pageType="tags">
  <div class="tag-cloud-list is-center">
    <div id="tag">
      <div id="tag-page-tags">
        {
          tags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag.name)}/`} id={`/tags/${tag.name}/`}>
              <span class="tags-punctuation">
                <i class="anzhiyufont anzhiyu-icon-hashtag" />
              </span>
              {tag.name}
              <span class="tagsPageCount">{tag.count}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</PageLayout>
