---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleSort from "@/components/archive/ArticleSort.astro";
import { aggregateTags, getAllPosts } from "@/utils/posts";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const tags = aggregateTags(posts);
  return tags.map((tag) => ({
    params: { tag: tag.name },
    props: {
      tagName: tag.name,
      allTags: tags,
      posts: posts.filter((p) => (p.data.tags ?? []).includes(tag.name)),
    },
  }));
}

const { tagName, allTags, posts } = Astro.props;
---

<BaseLayout title={`标签: ${tagName}`} pageType="tag">
  <div id="tag">
    <div id="tag-page-tags">
      {
        allTags.map((t) => (
          <a
            href={`/tags/${encodeURIComponent(t.name)}/`}
            class:list={[{ select: t.name === tagName }]}
          >
            <span class="tags-punctuation">
              <i class="anzhiyufont anzhiyu-icon-hashtag" />
            </span>
            {t.name}
            <span class="tagsPageCount">{t.count}</span>
          </a>
        ))
      }
    </div>
    <ArticleSort title={`标签 - ${tagName}`} posts={posts} />
  </div>
</BaseLayout>
