---
import PageLayout from "@/layouts/PageLayout.astro";
import { getSiteData } from "@/data/site-data";

interface GearItem {
  name: string;
  specification?: string;
  description?: string;
  image: string;
  link?: string;
}

interface GearCategory {
  title: string;
  description?: string;
  equipment_list?: GearItem[];
}

interface EquipmentSection {
  class_name: string;
  description?: string;
  tip?: string;
  top_background?: string;
  good_things?: GearCategory[];
}

const data = getSiteData<EquipmentSection[]>("equipment") ?? [];
---

<PageLayout title="我的装备" showAside={false} showPageTitle={false} pageType="equipment">
  <div id="equipment">
    {
      data.map((group) => (
        <>
          <div
            class="author-content author-content-item fcirclePage single"
            style={
              group.top_background
                ? `background: url(${group.top_background}) left 37% / cover no-repeat !important;`
                : undefined
            }
          >
            <div class="card-content">
              <div class="author-content-item-tips">{group.class_name}</div>
              <span class="author-content-item-title">{group.description}</span>
              <div class="content-bottom">
                <div class="tips">{group.tip}</div>
              </div>
            </div>
          </div>

          {(group.good_things ?? []).map((thing) => (
            <div class="goodthings-item">
              <h2 class="goodthings-title">{thing.title}</h2>
              {thing.description && <div class="goodthings-item-description">{thing.description}</div>}
              <div class="equipment-item">
                <div class="equipment-item-content">
                  {(thing.equipment_list ?? []).map((item) => {
                    const external = Boolean(item.link && item.link.startsWith("http"));
                    return (
                      <div class="equipment-item-content-item">
                        <div class="equipment-item-content-item-cover">
                          <img class="equipment-item-content-item-image" src={item.image} alt={item.name} loading="lazy" />
                        </div>
                        <div class="equipment-item-content-item-info">
                          <div
                            class="equipment-item-content-item-name"
                            data-copy-name={item.name}
                            title={`点击复制名称：${item.name}`}
                          >
                            {item.name}
                          </div>
                          {item.specification && (
                            <div class="equipment-item-content-item-specification">{item.specification}</div>
                          )}
                          {item.description && (
                            <div class="equipment-item-content-item-description">{item.description}</div>
                          )}
                          <div class="equipment-item-content-item-toolbar">
                            {item.link && (
                              <a
                                class="equipment-item-content-item-link"
                                href={item.link}
                                target={external ? "_blank" : undefined}
                                rel={external ? "noopener noreferrer" : undefined}
                              >
                                {external ? "详情" : "查看文章"}
                              </a>
                            )}
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          ))}
        </>
      ))
    }
  </div>
</PageLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(".equipment-item-content-item-name").forEach((el) => {
      el.addEventListener("click", async () => {
        const name = el.dataset.copyName || "";
        if (!name) return;
        try {
          await navigator.clipboard.writeText(name);
          window.dispatchEvent(new CustomEvent("anzhiyu:toast", { detail: { message: `已复制装备名称【${name}】` } }));
        } catch {
          /* ignore */
        }
      });
    });
  });
</script>
