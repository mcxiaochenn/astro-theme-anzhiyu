---
import { ClientRouter } from "astro:transitions";
import SEOHead from "@/components/common/SEOHead.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import Rightside from "@/components/common/Rightside.astro";
import GlobalOverlays from "@/components/common/GlobalOverlays.astro";
import { siteConfig } from "@/config";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: Date;
  updatedTime?: Date;
  transparentHeader?: boolean;
  isPost?: boolean;
  hasComments?: boolean;
  mainColor?: string;
}

const {
  title,
  description,
  image,
  article = false,
  publishedTime,
  updatedTime,
  transparentHeader = false,
  isPost = false,
  hasComments = false,
  mainColor,
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.language} style={mainColor ? `--anzhiyu-main: ${mainColor}; --anzhiyu-theme: ${mainColor};` : undefined}>
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      article={article}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
    />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class:list={[{ post: isPost }]}>
    <Header pageTitle={title || siteConfig.title} transparent={transparentHeader} />
    <main id="main-content" class="min-h-[calc(100vh-220px)]">
      <slot />
    </main>
    <Footer />
    <Rightside isPost={isPost} hasComments={hasComments} />
    <GlobalOverlays />
    <slot name="overlays" />
  </body>
</html>
