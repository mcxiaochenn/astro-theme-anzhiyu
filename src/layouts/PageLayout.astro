---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Comments from "@/components/comments/Comments.astro";

interface Props {
  title: string;
  description?: string;
  showAside?: boolean;
  pageType?: string;
  hasComments?: boolean;
  showPageTitle?: boolean;
}

const {
  title,
  description,
  showAside = true,
  pageType = "page",
  hasComments = false,
  showPageTitle = true,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  showAside={showAside}
  pageType={pageType}
  hasComments={hasComments}
>
  <div id="page">
    {showPageTitle && <h1 class="page-title">{title}</h1>}
    <slot />
    {hasComments && <Comments enable={true} />}
  </div>
</BaseLayout>
