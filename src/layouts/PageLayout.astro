---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Sidebar from "@/components/sidebar/Sidebar.astro";
import { themeConfig } from "@/config";

interface Props {
  title: string;
  description?: string;
  aside?: boolean;
  hasComments?: boolean;
}

const { title, description, aside = true, hasComments = false } = Astro.props;
---

<BaseLayout title={title} description={description} hasComments={hasComments}>
  <div class="layout-shell">
    <div class="layout-main">
      <div class="anzhiyu-card p-6 md:p-8">
        <h1 class="text-2xl md:text-3xl font-extrabold mb-6 mt-0">{title}</h1>
        <slot />
      </div>
      <slot name="comments" />
    </div>
    {aside && themeConfig.sidebar.enable && <Sidebar showAuthor={true} />}
  </div>
  <slot name="overlays" slot="overlays" />
</BaseLayout>
