---
import type { MarkdownHeading } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostHeader from "@/components/post/PostHeader.astro";
import PostToc from "@/components/post/PostToc.astro";
import PostAiAbstract from "@/components/post/PostAiAbstract.astro";
import PostCopyright from "@/components/post/PostCopyright.astro";
import PostRelated from "@/components/post/PostRelated.astro";
import Comments from "@/components/comments/Comments.astro";
import { themeConfig } from "@/config";
import { getPostStats, getPostUrl, type PostEntry } from "@/utils/posts";

interface Props {
  post: PostEntry;
  headings: MarkdownHeading[];
  prev?: PostEntry;
  next?: PostEntry;
  related: PostEntry[];
}

const { post, headings, prev, next, related } = Astro.props;
const { words, minutes } = getPostStats(post);
const cover = typeof post.data.cover === "string" ? post.data.cover : "/img/default_cover.jpg";
const showToc = themeConfig.post.toc && headings.some((h) => h.depth >= 1 && h.depth <= 4);

const aiSummary =
  typeof post.data.ai === "string"
    ? post.data.ai
    : post.data.ai === false
      ? ""
      : themeConfig.post.aiAbstract
        ? post.data.description ?? ""
        : "";
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={cover}
  article={true}
  publishedTime={post.data.date}
  updatedTime={post.data.updated}
  isPost={true}
  topImg={post.data.top_img === false ? false : typeof post.data.top_img === "string" ? post.data.top_img : cover}
  showAside={post.data.aside !== false}
  showToc={showToc}
  hasComments={post.data.comments !== false}
  mainColor={post.data.main_color}
>
  <PostHeader slot="post-header" post={post} words={words} minutes={minutes} />

  {showToc && <PostToc slot="aside-sticky" headings={headings} />}

  <div id="post">
    {aiSummary && <PostAiAbstract summary={aiSummary} />}

    <article class="post-content" id="article-container" data-pagefind-body>
      <slot />
    </article>

    {
      post.data.copyright !== false && themeConfig.post.copyright && (
        <PostCopyright post={post} url={getPostUrl(post)} />
      )
    }

    <PostRelated
      prev={prev}
      next={next}
      related={themeConfig.post.relatedPosts ? related : []}
    />

    <Comments enable={post.data.comments !== false} />
  </div>

  <slot name="overlays" slot="overlays" />
</BaseLayout>
