---
/**
 * ShortcutKey.astro — 上游 `layout/includes/shortcutKey.pug` 的逐节点移植（Batch A · A5）。
 *
 * 挂载点：BaseLayout 里 `layout.pug:80-81`（sidebar.pug:78 之后、rightside.pug:82 之前），
 * 门控 `theme.shortcutKey.enable`（上游 layout.pug:80 的 if，本组件 self-gate）。
 *
 * DOM 结构逐节点复刻 shortcutKey.pug:15-23（**类名拼写保持上游原样**：
 * `keyboardTitle` 带 a，`keybordList` / `keybordItem` 少 a——上游即如此，勿"修正"，
 * diff 硬门禁按上游 DOM 对拍）：
 *
 *   #keyboard-tips(class='')
 *     .keyboardTitle= _p('shortcut.title')
 *     .keybordList
 *       .keybordItem × 11（keyGroup > .key="shift "+字母；keyContent > .content=i18n）
 *
 * 键位顺序与上游 shortcutKey.pug:2-14 逐条一致：
 *   K=close_shortcut, A=toggle_console, M=play_music, D=toggle_mode, S=search,
 *   R=random, H=home, F=fish_pond, L=links, P=about, I=context_menu。
 *
 * 消费链（元素存在时不再 TypeError）：main.js:1644 `#keyboard-tips` add("show")、
 * :1686 remove("show")、:1693-1694 querySelector + remove("show")。
 * 注意 main.js:1752 的注册前提还有 `#consoleKeyboard`（Console 面板键盘开关）。
 */
import { getThemeConfig, readFlag } from '../../config/theme-context.ts'
import type { SiteConfig } from '../../utils/url-utils.ts'
import { tp } from '../../i18n/index.ts'

interface Props {
  /** 站点元数据（`tp` 按 `site.language` 查词典）。 */
  site: SiteConfig
}

const { site } = Astro.props

const theme = getThemeConfig()
const lang = site.language
const _p = (key: string) => tp(key, lang)

/** 上游 shortcutKey.pug:2-14 的 11 条键位（顺序、键字母、i18n 键逐条一致）。 */
const shortcutItems = [
  { key: 'K', content: _p('shortcut.close_shortcut') },
  { key: 'A', content: _p('shortcut.toggle_console') },
  { key: 'M', content: _p('shortcut.play_music') },
  { key: 'D', content: _p('shortcut.toggle_mode') },
  { key: 'S', content: _p('shortcut.search') },
  { key: 'R', content: _p('shortcut.random') },
  { key: 'H', content: _p('shortcut.home') },
  { key: 'F', content: _p('shortcut.fish_pond') },
  { key: 'L', content: _p('shortcut.links') },
  { key: 'P', content: _p('shortcut.about') },
  { key: 'I', content: _p('shortcut.context_menu') },
]
---

{readFlag(theme.shortcutKey, 'enable') && (
  <div id="keyboard-tips" class="">
    <div class="keyboardTitle">{_p('shortcut.title')}</div>
    <div class="keybordList">
      {shortcutItems.map((item) => (
        <div class="keybordItem">
          <div class="keyGroup">
            <div class="key">{`shift ${item.key}`}</div>
          </div>
          <div class="keyContent">
            <div class="content">{item.content}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
)}
