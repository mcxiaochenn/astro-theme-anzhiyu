---
/**
 * CardConsoleTags.astro — 上游 `layout/includes/widget/card_console_tags.pug`（P3-1）。
 *
 * 与 `card_tags.pug` 结构相同，只是读 `theme.centerConsole.card_tags`。
 */
import { getThemeConfig, readFlag } from '../../config/theme-context.ts'
import { createUrlFor } from '../../utils/url-utils.ts'
import { cloudTags } from '../../utils/helpers.ts'
import type { SiteTagItem } from '../../data/site-stats.ts'

interface Props {
  tags: SiteTagItem[]
}

const { tags } = Astro.props
const theme = getThemeConfig()
const urlFor = createUrlFor('/')

interface ConsoleTagsConfig {
  enable?: boolean
  limit?: number
  color?: boolean
  highlightTags?: string[] | null
}

const config = theme.centerConsole.card_tags as ConsoleTagsConfig
const tagLimit = config.limit === 0 ? 0 : config.limit || 40
const useColor = readFlag(config, 'color')
const highlightTags = (config.highlightTags ?? []) as string[]

const cloud = cloudTags(
  {
    tags: tags.map((tag) => ({ name: tag.name, path: tag.path, length: tag.length })),
    minfontsize: 1.05,
    maxfontsize: 1.05,
    limit: tagLimit,
    unit: 'rem',
    color: useColor,
    highlightTags,
  },
  { urlFor },
)
---

{
  config.enable && tags.length > 0 && (
    <>
      <div class="card-tags">
        <div class="item-headline" />
        <div class="card-tag-cloud" set:html={cloud} />
      </div>
      <hr />
    </>
  )
}
