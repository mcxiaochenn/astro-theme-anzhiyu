---
/**
 * CardAuthor.astro — 上游 `layout/includes/widget/card_author.pug`（P3-1）。
 *
 * ```pug
 * if theme.aside.card_author.enable
 *   .card-widget.card-info
 *     .card-content
 *       if theme.author_status.enable
 *         .author-info__sayhi#author-info__sayhi(onclick="anzhiyu.changeSayHelloText()")
 *       .author-info-avatar
 *         img.avatar-img(src=url_for(theme.avatar.img) …)
 *         if theme.author_status.enable && theme.author_status.statusImg
 *           .author-status > img.g-status
 *       .author-info__description!= theme.aside.card_author.description || config.description
 *       if theme.social
 *         .author-info__bottom-group …
 * ```
 *
 * 两个上游语义：
 *  1. 描述是 `!=`（原样 HTML），所以用 `set:html`；
 *  2. 头像会被站级 lazyload 过滤器改写（`post_lazyload.js`）。这里直接输出
 *     改写后的最终形态；`onerror` 取上游 `<img>` 自带的那一条（lazyload 插入的
 *     同名属性在 baseline 里排在前面，浏览器与 `scripts/diff-html.mjs` 都按最后一个取值）。
 *
 * 头像的 `onerror` 用 `theme.error_img.flink`（不是 `post_page`），这是上游这一行的
 * 固定取值，见 `card_author.pug:6`。
 */
import { getThemeConfig, readString } from '../../config/theme-context.ts'
import { createUrlFor, type SiteConfig } from '../../utils/url-utils.ts'
import { resolveImageLazyload } from '../post/post-list.ts'

interface Props {
  /**
   * 站点元数据：`config.author` / `config.subtitle` / `config.description`。
   * BaseLayout 目前不透传 site（P3-1 的写入范围不允许改布局），缺省用中性站点；
   * 因此 `card_author.description` 为空时描述会退化成空，属已知限制。
   */
  site?: SiteConfig
}

const { site } = Astro.props
const theme = getThemeConfig()
const urlFor = createUrlFor('/')

const authorStatusEnabled = theme.author_status.enable
const statusImg = readString(theme.author_status, 'statusImg')
const description =
  (theme.aside.card_author.description as string | null | undefined) || site?.description || ''
const avatarImg = readString(theme.avatar, 'img')
const errorFlink = readString(theme.error_img, 'flink', '/img/friend_404.gif')
const lazyload = resolveImageLazyload()
const avatarSrc = lazyload.enabled ? lazyload.placeholder : urlFor(avatarImg)
/**
 * 站级 lazyload 过滤器会在 `src=` 后插入一条 `onerror="this.onerror=null,this.src=…"`，
 * 它排在 pug 自带的 `onerror` 前面；baseline 解析后生效的是**第一条**（post_page）。
 * 关闭 lazyload 时才回到 pug 自带那条（flink）。
 */
const avatarOnError = lazyload.enabled
  ? `this.onerror=null,this.src="${lazyload.errorPostPage}"`
  : `this.onerror=null;this.src='${errorFlink}'`
const nameLink = theme.aside.card_author.name_link || '/'

interface SocialEntry {
  title: string
  href: string
  icon: string
  animation: string
}
const rawSocial = theme.social
const socialEntries: SocialEntry[] =
  rawSocial && typeof rawSocial === 'object' && !Array.isArray(rawSocial)
    ? Object.entries(rawSocial as Record<string, unknown>).map(([title, value]) => {
        const parts = String(value ?? '').split('||')
        return {
          title: title.trim(),
          href: parts[0].trim(),
          icon: parts[1] ? parts[1].trim() : '',
          animation: parts[2] ? parts[2].trim() : 'faa-tada',
        }
      })
    : []
---

{
  theme.aside.card_author.enable && (
    <div class="card-widget card-info">
      <div class="card-content">
        {authorStatusEnabled && (
          <div
            class="author-info__sayhi"
            id="author-info__sayhi"
            onclick="anzhiyu.changeSayHelloText()"
          />
        )}
        <div class="author-info-avatar">
          <img
            class="avatar-img"
            src={avatarSrc}
            onerror={avatarOnError}
            data-lazy-src={lazyload.enabled ? urlFor(avatarImg) : undefined}
            alt="avatar"
          />
          {authorStatusEnabled && statusImg && (
            <div class="author-status">
              <img src={urlFor(statusImg)} class="g-status" alt="status" />
            </div>
          )}
        </div>
        <div class="author-info__description" set:html={description} />
        {socialEntries.length > 0 && (
          <div class="author-info__bottom-group">
            <a class="author-info__bottom-group-left" href={urlFor(nameLink)}>
              <h1 class="author-info__name">{site?.author}</h1>
              <div class="author-info__desc">{site?.subtitle}</div>
            </a>
            <div class="card-info-social-icons is-center">
              {socialEntries.map((entry) => (
                <a
                  class="social-icon faa-parent animated-hover"
                  href={urlFor(entry.href)}
                  target="_blank"
                  title={entry.title}
                >
                  {entry.icon.startsWith('fa') ? (
                    <i class={`${entry.icon} ${entry.animation}`} />
                  ) : entry.icon.startsWith('icon') ? (
                    <svg class={`icon ${entry.animation}`} aria-hidden="true">
                      <use xlink:href={`#${entry.icon}`} />
                    </svg>
                  ) : entry.icon.startsWith('anzhiyu') ? (
                    <i class={`anzhiyufont ${entry.icon}`} />
                  ) : null}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  )
}
