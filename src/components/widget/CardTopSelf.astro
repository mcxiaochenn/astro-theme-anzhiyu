---
/**
 * CardTopSelf.astro — 上游 `layout/includes/widget/card_top_self.pug`（P3-1）。
 *
 * ```pug
 * if site.data.widget && site.data.widget.top
 *   each item in site.data.widget.top
 *     .card-widget(class=item.class_name id=item.id_name)
 *       .item-headline
 *         i(class=item.icon)
 *         span=item.name
 *       .item-content
 *         !=item.html
 * ```
 *
 * 数据源（`site.data.widget`）在当前站点还没有对应物；调用方不传时输出为空。
 */
import type { WidgetDataItem } from '../../data/widget-data.ts'

interface Props {
  items?: WidgetDataItem[]
}

const { items = [] } = Astro.props
---

{
  items.map((item) => (
    <div class:list={['card-widget', item.class_name]} id={item.id_name}>
      <div class="item-headline">
        <i class={item.icon} />
        <span>{item.name}</span>
      </div>
      <div class="item-content" set:html={item.html ?? ''} />
    </div>
  ))
}
