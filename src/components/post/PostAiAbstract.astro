---
import { siteConfig } from "@/config";

interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

{
  summary && (
    <div class="post-ai-description" data-ai-summary={summary}>
      <div class="ai-title">
        <i class="anzhiyufont anzhiyu-icon-bilibili" />
        <div class="ai-title-text">AI-摘要</div>
        <i
          class="anzhiyufont anzhiyu-icon-arrow-rotate-right"
          id="ai-replay-btn"
          title="重新生成打字效果"
          style="cursor: pointer;"
        />
        <div id="ai-tag">{siteConfig.title} GPT</div>
      </div>
      <div class="ai-explanation" id="ai-explanation-box">
        {summary}
      </div>
    </div>
  )
}

<script>
  document.addEventListener("astro:page-load", () => {
    const wrap = document.querySelector<HTMLElement>(".post-ai-description");
    const box = document.getElementById("ai-explanation-box");
    const replayBtn = document.getElementById("ai-replay-btn");
    if (!wrap || !box) return;
    const text = wrap.dataset.aiSummary || "";
    if (!text) return;

    let timer: number | undefined;
    const play = () => {
      window.clearInterval(timer);
      box.textContent = "";
      let idx = 0;
      timer = window.setInterval(() => {
        idx += 1;
        box.textContent = text.slice(0, idx);
        if (idx >= text.length) window.clearInterval(timer);
      }, 24);
    };

    play();
    replayBtn?.addEventListener("click", play);
  });
</script>
