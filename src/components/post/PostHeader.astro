---
import { Icon } from "astro-icon/components";
import { formatDate, normalizeCategoryList, type PostEntry } from "@/utils/posts";

interface Props {
  post: PostEntry;
  words: number;
  minutes: number;
}

const { post, words, minutes } = Astro.props;
const cover = typeof post.data.cover === "string" ? post.data.cover : "/img/default_cover.jpg";
const categories = normalizeCategoryList(post.data.categories);
const tags = post.data.tags ?? [];
---

<div class="post-top-cover">
  <div class="cover-bg" style={`background-image: url('${cover}')`}></div>
  <div class="cover-mask"></div>
  <div class="post-info">
    <div class="post-firstinfo">
      <div class="meta-firstline">
        {
          categories.map((cat) => (
            <a href={`/categories/${encodeURIComponent(cat)}/`} class="post-meta-cat">
              {cat}
            </a>
          ))
        }
        {
          tags.slice(0, 4).map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag)}/`} class="post-meta-tag">
              #{tag}
            </a>
          ))
        }
      </div>
    </div>

    <h1 class="post-title">{post.data.title}</h1>

    <div class="post-meta-secondline">
      {
        post.data.date && (
          <span class="meta-item">
            <Icon name="fa6-regular:calendar" class="w-3.5 h-3.5" />
            <span>发表于 {formatDate(post.data.date)}</span>
          </span>
        )
      }
      {
        post.data.updated && (
          <span class="meta-item">
            <Icon name="fa6-solid:clock-rotate-left" class="w-3.5 h-3.5" />
            <span>更新于 {formatDate(post.data.updated)}</span>
          </span>
        )
      }
      <span class="meta-item">
        <Icon name="fa6-regular:file-word" class="w-3.5 h-3.5" />
        <span>字数 {words}</span>
      </span>
      <span class="meta-item">
        <Icon name="fa6-regular:clock" class="w-3.5 h-3.5" />
        <span>约 {minutes} 分钟</span>
      </span>
    </div>
  </div>
</div>

<style>
  .post-top-cover {
    position: relative;
    width: 100%;
    min-height: 280px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--anzhiyu-theme-deep);
    color: var(--anzhiyu-white);
  }

  .cover-bg {
    position: absolute;
    inset: -20px;
    background-size: cover;
    background-position: center;
    filter: blur(18px) brightness(0.7);
    transform: scale(1.08);
  }

  .cover-mask {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.65) 100%);
  }

  .post-info {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .meta-firstline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .post-meta-cat {
    padding: 0.2rem 0.65rem;
    border-radius: var(--anzhiyu-radius);
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(6px);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .post-meta-cat:hover {
    background: var(--anzhiyu-white);
    color: var(--anzhiyu-main);
  }

  .post-meta-tag {
    font-size: 0.82rem;
    opacity: 0.88;
  }

  .post-meta-tag:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .post-title {
    margin: 0;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    font-weight: 800;
    line-height: 1.3;
    color: #fff;
  }

  .post-meta-secondline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    opacity: 0.9;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
</style>
