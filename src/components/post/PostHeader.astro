---
import { themeConfig } from "@/config";
import { formatDate, normalizeCategoryList, type PostEntry } from "@/utils/posts";

interface Props {
  post: PostEntry;
  words: number;
  minutes: number;
}

const { post, words, minutes } = Astro.props;
const cover = typeof post.data.cover === "string" ? post.data.cover : "/img/default_cover.jpg";
const categories = normalizeCategoryList(post.data.categories);
const tags = post.data.tags ?? [];
const createdStr = post.data.date ? formatDate(post.data.date) : "";
const updatedStr = post.data.updated ? formatDate(post.data.updated) : createdStr;
const formattedWords = words >= 1000 ? `${(words / 1000).toFixed(1)}k` : String(words);
---

<div id="post-info">
  <div id="post-firstinfo">
    <div class="meta-firstline">
      <a class="post-meta-original" title="该文章为原创文章，注意版权协议">
        原创
      </a>
      {
        categories.length > 0 && (
          <span class="post-meta-categories">
            {categories.map((cat) => (
              <a class="post-meta-categories" href={`/categories/${encodeURIComponent(cat)}/`}>
                {cat}
              </a>
            ))}
          </span>
        )
      }
      {
        tags.length > 0 && (
          <span class="article-meta tags">
            {tags.map((tag) => (
              <a class="article-meta__tags" href={`/tags/${encodeURIComponent(tag)}/`}>
                <span>
                  <i class="anzhiyufont anzhiyu-icon-hashtag" />
                  {tag}
                </span>
              </a>
            ))}
          </span>
        )
      }
    </div>
  </div>

  <h1 class="post-title">{post.data.title}</h1>

  <div id="post-meta">
    <div class="meta-firstline">
      {
        createdStr && (
          <span class="post-meta-date">
            <i class="anzhiyufont anzhiyu-icon-calendar-days post-meta-icon" />
            <span class="post-meta-label">发表于</span>
            <time
              class="post-meta-date-created"
              datetime={post.data.date?.toISOString()}
              title={`发表于 ${createdStr}`}
            >
              {createdStr}
            </time>
            {updatedStr && (
              <>
                <span class="post-meta-separator" />
                <i class="anzhiyufont anzhiyu-icon-history post-meta-icon" />
                <span class="post-meta-label">更新于</span>
                <time
                  class="post-meta-date-updated"
                  datetime={(post.data.updated ?? post.data.date)?.toISOString()}
                  title={`更新于 ${updatedStr}`}
                >
                  {updatedStr}
                </time>
              </>
            )}
          </span>
        )
      }
    </div>

    <div class="meta-secondline">
      <span class="post-meta-wordcount">
        <i class="anzhiyufont anzhiyu-icon-file-word post-meta-icon" title="文章字数" />
        <span class="post-meta-label" title="文章字数">字数总计:</span>
        <span class="word-count" title="文章字数">{formattedWords}</span>
        <span class="post-meta-separator" />
        <i class="anzhiyufont anzhiyu-icon-clock post-meta-icon" title="阅读时长" />
        <span class="post-meta-label" title="阅读时长">阅读时长:</span>
        <span>{minutes}分钟</span>
      </span>

      {
        themeConfig.post.copyright && themeConfig.post.copyrightLocation && (
          <>
            <span class="post-meta-separator" />
            <span class="post-meta-position" title={`作者IP属地为${themeConfig.post.copyrightLocation}`}>
              <i class="anzhiyufont anzhiyu-icon-location-dot" />
              {themeConfig.post.copyrightLocation}
            </span>
          </>
        )
      }
    </div>
  </div>
</div>

<section class="main-hero-waves-area waves-area" aria-hidden="true">
  <svg
    class="waves-svg"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 24 150 28"
    preserveAspectRatio="none"
    shape-rendering="auto"
  >
    <defs>
      <path
        id="gentle-wave"
        d="M -160 44 c 30 0 58 -18 88 -18 s 58 18 88 18 s 58 -18 88 -18 s 58 18 88 18 v 44 h -352 Z"
      />
    </defs>
    <g class="parallax">
      <use href="#gentle-wave" x="48" y="0" />
      <use href="#gentle-wave" x="48" y="3" />
      <use href="#gentle-wave" x="48" y="5" />
      <use href="#gentle-wave" x="48" y="7" />
    </g>
  </svg>
</section>

<div id="post-top-cover">
  <img id="post-top-bg" class="nolazyload" src={cover} alt={post.data.title} />
</div>
