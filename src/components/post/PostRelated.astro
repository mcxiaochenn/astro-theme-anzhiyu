---
import { formatDate, getPostUrl, type PostEntry } from "@/utils/posts";

interface Props {
  prev?: PostEntry;
  next?: PostEntry;
  related: PostEntry[];
}

const { prev, next, related } = Astro.props;
const coverOf = (p: PostEntry) =>
  typeof p.data.cover === "string" ? p.data.cover : "/img/default_cover.jpg";
---

{
  (prev || next) && (
    <nav class="pagination-post" id="pagination">
      {prev && (
        <div class:list={["prev-post", next ? "pull-left" : "pull-full"]}>
          <a href={getPostUrl(prev)} title={prev.data.title}>
            <img class="prev-cover no-lightbox" src={coverOf(prev)} alt={prev.data.title} loading="lazy" />
            <div class="pagination-info">
              <div class="label">上一篇</div>
              <div class="prev_info">{prev.data.title}</div>
            </div>
          </a>
        </div>
      )}
      {next && (
        <div class:list={["next-post", prev ? "pull-right" : "pull-full"]}>
          <a href={getPostUrl(next)} title={next.data.title}>
            <img class="next-cover no-lightbox" src={coverOf(next)} alt={next.data.title} loading="lazy" />
            <div class="pagination-info">
              <div class="label">下一篇</div>
              <div class="next_info">{next.data.title}</div>
            </div>
          </a>
        </div>
      )}
    </nav>
  )
}

{
  related.length > 0 && (
    <div class="relatedPosts">
      <div class="headline">
        <i class="anzhiyufont anzhiyu-icon-thumbs-up fa-fw" style="font-size: 1.5rem; margin-right: 4px" />
        <span>猜你喜欢</span>
      </div>
      <div class="relatedPosts-list">
        {related.map((post) => {
          const url = getPostUrl(post);
          const dateStr = post.data.date ? formatDate(post.data.date) : "";
          return (
            <div>
              <a href={url} title={post.data.title}>
                <img class="cover no-lightbox" src={coverOf(post)} alt={post.data.title} loading="lazy" />
                <div class="content is-center">
                  {dateStr && (
                    <div class="date">
                      <i class="anzhiyufont anzhiyu-icon-calendar-days fa-fw" /> {dateStr}
                    </div>
                  )}
                  <div class="title">{post.data.title}</div>
                </div>
              </a>
            </div>
          );
        })}
      </div>
    </div>
  )
}
