---
import { Icon } from "astro-icon/components";
import { siteConfig, themeConfig } from "@/config";

interface Props {
  title: string;
  url: string;
}

const { url } = Astro.props;
const fullUrl = new URL(url, siteConfig.url).toString();
---

<div class="post-copyright anzhiyu-card">
  <Icon name="fa6-brands:creative-commons" class="copyright-cc-watermark" aria-hidden="true" />
  <div class="post-copyright__author">
    <span class="post-copyright-meta">文章作者</span>
    <span class="post-copyright-info">
      <a href="/about/">{siteConfig.author}</a>
    </span>
  </div>
  <div class="post-copyright__type">
    <span class="post-copyright-meta">文章链接</span>
    <span class="post-copyright-info">
      <a href={fullUrl} class="break-all">{fullUrl}</a>
    </span>
  </div>
  <div class="post-copyright__notice">
    <span class="post-copyright-meta">版权声明</span>
    <span class="post-copyright-info">
      本博客所有文章除特别声明外，均采用
      <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer" class="underline text-[var(--anzhiyu-main)]">
        CC BY-NC-SA 4.0
      </a>
      许可协议。转载请注明来源 {siteConfig.title}！
    </span>
  </div>

  {
    themeConfig.post.reward.enable && (
      <div class="post-reward">
        <button type="button" id="reward-toggle-btn" class="reward-button">
          <Icon name="fa6-solid:heart" class="w-4 h-4" />
          <span>打赏作者</span>
        </button>
        <div id="reward-qr-box" class="reward-qr-box hidden">
          {themeConfig.post.reward.wechat && (
            <div class="reward-qr-item">
              <img src={themeConfig.post.reward.wechat} alt="微信赞赏" loading="lazy" />
              <span>微信</span>
            </div>
          )}
          {themeConfig.post.reward.alipay && (
            <div class="reward-qr-item">
              <img src={themeConfig.post.reward.alipay} alt="支付宝赞赏" loading="lazy" />
              <span>支付宝</span>
            </div>
          )}
        </div>
      </div>
    )
  }
</div>

<style>
  .post-copyright {
    position: relative;
    margin-top: 2rem;
    padding: 1.25rem 1.45rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.9rem;
    overflow: hidden;
  }

  .copyright-cc-watermark {
    position: absolute;
    right: -18px;
    top: -18px;
    width: 110px;
    height: 110px;
    opacity: 0.06;
    pointer-events: none;
  }

  .post-copyright__author,
  .post-copyright__type,
  .post-copyright__notice {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .post-copyright-meta {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--anzhiyu-main);
    color: var(--anzhiyu-white);
    font-size: 0.78rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .post-copyright-info a:hover {
    color: var(--anzhiyu-main);
  }

  .post-reward {
    margin-top: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--anzhiyu-card-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .reward-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.48rem 1.25rem;
    border-radius: var(--anzhiyu-radius-full);
    background: var(--anzhiyu-red);
    color: var(--anzhiyu-white);
    border: none;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .reward-button:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }

  .reward-qr-box {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }

  .reward-qr-box.hidden {
    display: none;
  }

  .reward-qr-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--anzhiyu-secondtext);
  }

  .reward-qr-item img {
    width: 130px;
    height: 130px;
    border-radius: var(--anzhiyu-radius);
    object-fit: cover;
    border: var(--style-border);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    document.getElementById("reward-toggle-btn")?.addEventListener("click", () => {
      document.getElementById("reward-qr-box")?.classList.toggle("hidden");
    });
  });
</script>
