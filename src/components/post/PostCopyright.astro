---
import PostPtool from "./PostPtool.astro";
import { profileConfig, siteConfig } from "@/config";
import { aggregateCategories, aggregateTags, getAllPosts, normalizeCategoryList, type PostEntry } from "@/utils/posts";

interface Props {
  post: PostEntry;
  url: string;
}

const { post, url } = Astro.props;
const fullUrl = new URL(url, siteConfig.url).toString();
const cover = typeof post.data.cover === "string" ? post.data.cover : "/img/default_cover.jpg";
const categories = normalizeCategoryList(post.data.categories);
const tags = post.data.tags ?? [];

const allPosts = await getAllPosts();
const catCounts = Object.fromEntries(aggregateCategories(allPosts).map((c) => [c.name, c.count]));
const tagCounts = Object.fromEntries(aggregateTags(allPosts).map((t) => [t.name, t.count]));
---

<div class="post-copyright">
  <div class="copyright-cc-box">
    <i class="anzhiyufont anzhiyu-icon-copyright" />
  </div>

  <div class="post-copyright__author_box">
    <a class="post-copyright__author_img" href="/about/" title={siteConfig.author}>
      <img
        class="post-copyright__author_img_back no-lightbox"
        src={profileConfig.avatar}
        alt={siteConfig.author}
        loading="lazy"
      />
      <img
        class="post-copyright__author_img_front no-lightbox"
        src={profileConfig.avatar}
        alt={siteConfig.author}
        loading="lazy"
      />
    </a>
    <div class="post-copyright__author_name">{post.data.copyright_author || siteConfig.author}</div>
    <div class="post-copyright__author_desc">{siteConfig.subtitle}</div>
  </div>

  <div class="post-copyright__post__info">
    <a class="post-copyright__original" title="该文章为原创文章，注意版权协议" href={url}>
      原创
    </a>
    <a class="post-copyright-title" href="javascript:void(0);" data-copy-url={fullUrl} id="copyright-copy-title">
      <span>{post.data.title}</span>
    </a>
  </div>

  <PostPtool title={post.data.title} url={url} cover={cover} />

  <div class="post-copyright__notice">
    <span class="post-copyright-info">
      本文是原创文章，采用{" "}
      <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">
        CC BY-NC-SA 4.0
      </a>{" "}
      协议，完整转载请注明来自 <a href="/">{siteConfig.title}</a>。
    </span>
  </div>
</div>

<div class="post-tools-right">
  <div class="tag_share">
    <div class="post-meta__box">
      {
        categories.length > 0 && (
          <div class="post-meta__box__category-list">
            {categories.map((cat) => (
              <a class="post-meta__box__categoryes" href={`/categories/${encodeURIComponent(cat)}/`}>
                <span class="categoryes-punctuation">
                  <i class="anzhiyufont anzhiyu-icon-inbox" />
                </span>
                {cat}
                <span class="categoryesPageCount">{catCounts[cat] ?? 1}</span>
              </a>
            ))}
          </div>
        )
      }
      {
        tags.length > 0 && (
          <div class="post-meta__box__tag-list">
            {tags.map((tag) => (
              <a class="post-meta__box__tags" href={`/tags/${encodeURIComponent(tag)}/`}>
                <span class="tags-punctuation">
                  <i class="anzhiyufont anzhiyu-icon-tag" />
                </span>
                {tag}
                <span class="tagsPageCount">{tagCounts[tag] ?? 1}</span>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const el = document.getElementById("copyright-copy-title");
    el?.addEventListener("click", async (e) => {
      e.preventDefault();
      const u = el.getAttribute("data-copy-url") || window.location.href;
      try {
        await navigator.clipboard.writeText(u);
        window.dispatchEvent(new CustomEvent("anzhiyu:toast", { detail: { message: "已复制文章链接" } }));
      } catch {
        /* ignore */
      }
    });
  });
</script>
