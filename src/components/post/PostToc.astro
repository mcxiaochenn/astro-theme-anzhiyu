---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 1 && h.depth <= 4);
---

{
  filtered.length > 0 && (
    <div id="card-toc" class="card-widget">
      <div class="item-headline">
        <i class="anzhiyufont anzhiyu-icon-bars" />
        <span>目录</span>
        <span class="toc-percentage" id="toc-percentage">0</span>
      </div>
      <div class="toc-content is-expand">
        <ol class="toc">
          {filtered.map((h, idx) => (
            <li class={`toc-item toc-level-${h.depth}`}>
              <a class="toc-link" href={`#${h.slug}`} data-toc-slug={h.slug}>
                <span class="toc-number">{idx + 1}.</span>{" "}
                <span class="toc-text">{h.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  )
}

<script>
  document.addEventListener("astro:page-load", () => {
    const tocCard = document.getElementById("card-toc");
    if (!tocCard) return;
    const links = Array.from(tocCard.querySelectorAll<HTMLAnchorElement>(".toc-link"));
    const pctEl = document.getElementById("toc-percentage");
    const article = document.getElementById("article-container");
    if (!links.length) return;

    const headingEls = links
      .map((l) => {
        const slug = l.dataset.tocSlug;
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => Boolean(el));

    const updateToc = () => {
      const y = window.scrollY;
      if (article && pctEl) {
        const rect = article.getBoundingClientRect();
        const top = rect.top + y;
        const total = Math.max(1, article.offsetHeight - window.innerHeight * 0.5);
        const pct = Math.min(100, Math.max(0, Math.round(((y - top + 120) / total) * 100)));
        pctEl.textContent = String(pct);
      }

      let activeSlug = headingEls[0]?.id;
      for (const h of headingEls) {
        if (h.getBoundingClientRect().top <= 110) {
          activeSlug = h.id;
        } else {
          break;
        }
      }
      links.forEach((l) => {
        l.classList.toggle("active", l.dataset.tocSlug === activeSlug);
      });
    };

    window.addEventListener("scroll", updateToc, { passive: true });
    updateToc();
  });
</script>
