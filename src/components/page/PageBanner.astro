---
interface Props {
  tips?: string;
  title: string;
  subTitle?: string;
  background?: string;
  buttonText?: string;
  buttonLink?: string;
}

const {
  tips = "FEATURE",
  title,
  subTitle,
  background = "/img/default_cover.jpg",
  buttonText,
  buttonLink,
} = Astro.props;
---

<div class="author-content-item page-banner" style={`background-image: url('${background}')`}>
  <div class="banner-mask"></div>
  <div class="card-content">
    <div class="author-content-item-tips">{tips}</div>
    <span class="author-content-item-title">{title}</span>
    <div class="content-bottom">
      {subTitle && <div class="tips">{subTitle}</div>}
      {
        buttonText && buttonLink && (
          <a href={buttonLink} class="banner-button">
            {buttonText}
          </a>
        )
      }
    </div>
  </div>
</div>

<style>
  .page-banner {
    position: relative;
    height: 320px;
    border-radius: 14px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    margin-bottom: 1.5rem;
    color: #fff;
    border: var(--style-border);
  }

  .banner-mask {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.28) 0%, rgba(0, 0, 0, 0.68) 100%);
  }

  .card-content {
    position: relative;
    z-index: 2;
    height: 100%;
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
  }

  .author-content-item-tips {
    font-size: 0.78rem;
    opacity: 0.85;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .author-content-item-title {
    font-size: 2.15rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .content-bottom {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tips {
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .banner-button {
    padding: 0.45rem 1.15rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .banner-button:hover {
    background: var(--anzhiyu-main);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .page-banner {
      height: 240px;
    }

    .card-content {
      padding: 1.25rem;
    }

    .author-content-item-title {
      font-size: 1.65rem;
    }
  }
</style>
