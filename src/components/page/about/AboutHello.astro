---
/**
 * AboutHello — 上游 `layout/includes/page/about.pug:51-58`。
 *
 * 光标 + 三个形变块的初始 transform 是硬编码的（上游 `:52-56` 写死
 * `translate(721px,180px)`），真正的鼠标跟随在 `initAboutPage()` 里（Phase 4）。
 */
interface Props {
  helloAbout?: string
}

const { helloAbout } = Astro.props
const transform = 'translate:none;rotate:none;scale:none;transform:translate(721px,180px)'
---

<div class="hello-about">
  <div class="cursor" style={transform} />
  <div class="shapes">
    <div class="shape shape-1" style={transform} />
    <div class="shape shape-2" style={transform} />
    <div class="shape shape-3" style={transform} />
  </div>
  <div class="content">
    <h1>{helloAbout}</h1>
  </div>
</div>
