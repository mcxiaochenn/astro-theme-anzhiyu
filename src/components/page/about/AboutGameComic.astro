---
/**
 * AboutGameComic — 上游 `layout/includes/page/about.pug:176-196`。
 *
 * - 原神卡片：`.loading-bar` 只在 `game_title === '原神'` 时显示（`:184` 的
 *   三元写成 `style=${title != "原神" ? "display: none" : ""}`，标题是「原神」时
 *   pug 输出空 style，最终产物里这条属性消失）；
 * - 追番卡片：`comic_list` 存在时逐个输出外链封面（`:192-196`）。
 */
import type { AboutComic, AboutGame } from './types.ts'
import { imageAttrs, urlFor } from './shared.ts'

interface Props {
  game?: AboutGame
  comic?: AboutComic
}

const { game, comic } = Astro.props
const isGenshin = game?.game_title === '原神'
const comicList = comic?.comic_list
---

<div class="author-content-item game-yuanshen" style={`background: url(${game?.game_bg}) top / cover no-repeat;`}>
  <div class="card-content">
    <div class="author-content-item-tips">{game?.game_tips}</div>
    <span class="author-content-item-title">{game?.game_title}</span>
    <div class="content-bottom">
      <div class="icon-group">
        <div class="loading-bar" role="presentation" aria-hidden="true" style={isGenshin ? undefined : 'display: none'} />
      </div>
      <div class="tips game-yuanshen-uid">{game?.game_uid}</div>
    </div>
  </div>
</div>
<div class="author-content-item comic-content">
  <div class="card-content">
    <div class="author-content-item-tips">{comic?.comic_tips}</div>
    <div class="author-content-item-title">{comic?.comic_title}</div>
    <div class="comic-box">
      {comicList?.map((item) => (
        <a class="comic-item" href={item.href} target="_blank" title={item.name}>
          <div class="comic-item-cover">
            <img {...imageAttrs(urlFor(item.cover ?? ''))} alt={item.name} />
          </div>
        </a>
      ))}
    </div>
  </div>
</div>
