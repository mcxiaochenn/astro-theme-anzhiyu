---
/**
 * AboutReward — 上游 `layout/includes/page/about.pug:224-286`。
 *
 * 整块由 `item.reward_list` 的存在性控制（`:225`）。两套排序是上游原样：
 *   - 名单按 `amount` 倒序（`:233`，`sort` 会就地改数组）；
 *   - 「最新更新时间」按 `datatime` 倒序（`:226`）。
 * 日期文本是 `new Date(…).toISOString().slice(0, -14)`，只保留年月日。
 */
import type { AboutRewardItem } from './types.ts'
import { _p, rewardDate } from './shared.ts'
import AboutRewardTube from './AboutRewardTube.astro'

interface Props {
  list?: AboutRewardItem[]
}

const { list } = Astro.props
const hasList = Boolean(list)
const items = [...(list ?? [])].sort((a, b) => (b.amount ?? 0) - (a.amount ?? 0))
const latest = [...(list ?? [])].sort(
  (a, b) => new Date(b.datatime ?? 0).getTime() - new Date(a.datatime ?? 0).getTime(),
)[0]
const totalPeople = _p('about.total_people', `<b>${list?.length ?? 0}</b>`)
---

{
  hasList && (
    <div class="author-content">
      <div class="author-content-item single reward" id="about-reward">
        <div class="author-content-item-tips">{_p('about.thanks')}</div>
        <span class="author-content-item-title">{_p('about.reward_list')}</span>
        <div class="author-content-item-description">
          {_p('about.reward_thanks')}
          <div class="reward-list-all">
            {items.map((item) => (
              <div class="reward-list-item">
                <div class="reward-list-item-name">{item.name}</div>
                <div class="reward-list-bottom-group">
                  {(item.amount ?? 0) >= 50 ? (
                    <div class="reward-list-item-money" style="background:var(--anzhiyu-yellow)">
                      {`¥${item.amount}`}
                    </div>
                  ) : (
                    <div class="reward-list-item-money">
                      {`¥${item.amount ?? ''}${item.suffix ? item.suffix : ''}`}
                    </div>
                  )}
                  <div class="datatime reward-list-item-time" datatime={item.datatime}>
                    {rewardDate(item.datatime)}
                  </div>
                </div>
              </div>
            ))}
          </div>
          {latest && (
            <div class="reward-list-updateDate">
              {_p('about.last_update')}
              <time class="datatime reward-list-updateDate-time" datatime={latest.datatime}>
                {rewardDate(latest.datatime)}
              </time>
            </div>
          )}
        </div>
        <div class="about-reward">
          <div id="con" />
          <div id="TA-con" onclick="anzhiyu.rewardShowConsole()">
            <div id="text-con">
              <div id="linght" />
              <div id="TA">{_p('about.charge_for_ta')}</div>
            </div>
          </div>
          <div id="tube-con">
            <AboutRewardTube color="#e5e9ef" />
          </div>
          <div id="mask">
            <AboutRewardTube color="#f25d8e" />
          </div>
          <div id="orange-mask">
            <AboutRewardTube color="#ffd52b" />
          </div>
          <p id="people" set:html={totalPeople} />
        </div>
      </div>
    </div>
  )
}
