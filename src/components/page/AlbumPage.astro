---
/**
 * AlbumPage.astro — 相册集页（`page.type === 'album'`，P3-2）。
 *
 * 上游 `layout/includes/page/album.pug:1-22`：
 *
 *   #album
 *     .author-content.author-content-item.album.single   ← 背景取 page.top_background
 *       .card-content …（相册集 / 标题 / 提示 / 「关于本人」按钮）
 *     .card-album
 *       each i in site.data.album
 *         .card(onclick=pjax.loadUrl(i.path_name))
 *           img.card_cover[src=i.cover]
 *           .card__content > p.card__category + h3.card__heading
 *       .album-content-nocover ×3                        ← 占位（布局用）
 */
import type { AlbumGroup } from './types.ts'

interface Props {
  /** 上游 `site.data.album`。 */
  data?: AlbumGroup[]
  /** 上游 `page.top_background`（frontmatter）。 */
  topBackground?: string
}

const { data = [], topBackground } = Astro.props
---

<div id="album">
  <div
    class="author-content author-content-item album single"
    style={topBackground ? `background: url(${topBackground}) top / cover no-repeat;` : ''}
  >
    <div class="card-content">
      <div class="author-content-item-tips">相册集</div>
      <span class="author-content-item-title">这里是我的相册集哦😯</span>
      <div class="content-bottom">
        <div class="tips">每一张照片都是一次美好的记忆。</div>
      </div>
      <div class="banner-button-group">
        <a class="banner-button" onclick='pjax.loadUrl("/about/")'>
          <i class="anzhiyufont anzhiyu-icon-arrow-circle-right" style="font-size: 1.5rem" />
          <span class="banner-button-text">关于本人</span>
        </a>
      </div>
    </div>
  </div>
  <div class="card-album">
    {data.map((item) => (
      <div class="card" onclick={`pjax.loadUrl("${item.path_name}")`}>
        <img class="card_cover" src={item.cover} />
        <div class="card__content">
          <p class="card__category">{item.class_name}</p>
          <h3 class="card__heading">{item.description}</h3>
        </div>
      </div>
    ))}
    <div class="album-content-nocover" />
    <div class="album-content-nocover" />
    <div class="album-content-nocover" />
  </div>
</div>
