---
/**
 * TodolistPage.astro — 待办清单页（`page.type === 'todolist'`，P7-4 兼容页）。
 *
 * 上游：**1.6.14** `layout/includes/page/todolist.pug`（1.7.1 删除了这个分支与模板，
 * 真实站仍然有 `/todolist/` 页面，迁移后不能丢内容）。结构对照：
 *
 *   #todolist-box
 *     .author-content.author-content-item.todolist.single   ← 顶部卡片（背景取 page.top_background）
 *       .card-content
 *         .author-content-item-tips Todo
 *         span.author-content-item-title 待办清单
 *         .content-bottom
 *         .tips 耽误太多时间，事情可就做不完了
 *         .banner-button-group > a.banner-button[onclick=pjax.loadUrl("/about/")]
 *     #todolist-main
 *       #todolist-left   ← site.data.todolist 里 seat === 'left' 的分组
 *       #todolist-right  ← seat === 'right' 的分组
 *
 * 数据是站点侧 `source/_data/todolist.yml`（Astro 侧 `data/todolist.yml`，由站点路由
 * 用 `getSiteData('todolist')` 读进来当 props 传），主题包不碰文件系统。
 * 图标走 FontAwesome（`fa-regular fa-circle[-check]`），与 1.6.14 产物一致。
 */
import type { TodoGroup, TodoItem } from './types.ts'

interface Props {
  /** `site.data.todolist`（`{ class_name, seat, todo_list }[]`）。 */
  data?: TodoGroup[]
  /** `page.top_background`：顶部卡片的背景图 URL。 */
  topBackground?: string
}

const { data = [], topBackground } = Astro.props

/** `page.top_background` 存在时按上游拼成内联背景（`background: url(...) top / cover no-repeat;`）。 */
const cardStyle = topBackground
  ? `background: url(${topBackground}) top / cover no-repeat;`
  : ''

/** 按 `seat` 过滤分组（上游 `if i.seat == 'left'` / `'right'`）。 */
const groupsOf = (seat: 'left' | 'right'): TodoGroup[] =>
  data.filter((group) => group && group.seat === seat)

/** 一条待办：`class` 与图标由 `completed` 决定。 */
const itemsOf = (group: TodoGroup): TodoItem[] =>
  Array.isArray(group.todo_list) ? group.todo_list : []
---

<div id="todolist-box">
  <div class:list={['author-content', 'author-content-item', 'todolist', 'single']} style={cardStyle || undefined}>
    <div class="card-content">
      <div class="author-content-item-tips">Todo</div>
      <span class="author-content-item-title">待办清单</span>
      <div class="content-bottom" />
      <div class="tips">耽误太多时间，事情可就做不完了</div>
      <div class="banner-button-group">
        <a class="banner-button" onclick='pjax.loadUrl("/about/")'>
          <i class="anzhiyufont anzhiyu-icon-arrow-circle-right" style="font-size: 1.5rem" />
          <span class="banner-button-text">我的更多</span>
        </a>
      </div>
    </div>
  </div>
  <div id="todolist-main">
    <div id="todolist-left">
      {
        groupsOf('left').map((group) => (
          <div class="todolist-item">
            <h3 class="todolist-title">{group.class_name}</h3>
            <ul class="todolist-ul">
              {itemsOf(group).map((item) => (
                <li class={item.completed ? 'todolist-li-done' : 'todolist-li'}>
                  <i
                    class={
                      item.completed
                        ? 'fa-regular fa-circle-check'
                        : 'fa-regular fa-circle'
                    }
                  />
                  <span>{item.content}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div id="todolist-right">
      {
        groupsOf('right').map((group) => (
          <div class="todolist-item">
            <h3 class="todolist-title">{group.class_name}</h3>
            <ul class="todolist-ul">
              {itemsOf(group).map((item) => (
                <li class={item.completed ? 'todolist-li-done' : 'todolist-li'}>
                  <i
                    class={
                      item.completed
                        ? 'fa-regular fa-circle-check'
                        : 'fa-regular fa-circle'
                    }
                  />
                  <span>{item.content}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</div>
