---
import AnIcon from "./AnIcon.astro";
import Console from "@/components/console/Console.svelte";
import { navConfig, profileConfig, siteConfig, themeConfig } from "@/config";
import { aggregateCategories, aggregateTags, getAllPosts } from "@/utils/posts";

interface Props {
  pageTitle?: string;
  isHome?: boolean;
  isPost?: boolean;
  topImg?: string | false;
}

const {
  pageTitle = siteConfig.title,
  isHome = false,
  isPost = false,
  topImg,
} = Astro.props;

const posts = await getAllPosts();
const tags = aggregateTags(posts).map((t) => ({ name: t.name, count: t.count }));
const categories = aggregateCategories(posts);

// 构建按月归档供中控台使用
const archiveMap = new Map<string, { label: string; year: number; month: number; count: number }>();
for (const p of posts) {
  const d = p.data.date ?? new Date();
  const y = d.getFullYear();
  const m = d.getMonth() + 1;
  const key = `${y}-${String(m).padStart(2, "0")}`;
  const item = archiveMap.get(key) ?? { label: `${y}年${String(m).padStart(2, "0")}月`, year: y, month: m, count: 0 };
  item.count += 1;
  archiveMap.set(key, item);
}
const archiveMonths = Array.from(archiveMap.values()).slice(0, 8);

const homeImg = themeConfig.header.indexImg;
const resolvedTopImg = isPost
  ? topImg !== false
    ? topImg || "/img/default_cover.jpg"
    : false
  : isHome
    ? homeImg
    : topImg !== undefined
      ? topImg
      : themeConfig.header.defaultTopImg;

const pageHeaderClass =
  resolvedTopImg === false
    ? "not-top-img"
    : isPost
      ? "post-bg"
      : isHome
        ? "full_page"
        : "not-home-page";

const headerStyle =
  !isPost && typeof resolvedTopImg === "string" && resolvedTopImg
    ? resolvedTopImg.includes("gradient") || resolvedTopImg.includes("url(")
      ? `background: ${resolvedTopImg};`
      : `background-image: url('${resolvedTopImg}');`
    : undefined;
---

<header id="page-header" class={pageHeaderClass} style={headerStyle}>
  <nav id="nav">
    <div id="nav-group">
      <span id="blog_name">
        {
          navConfig.siteMenu.enable && (
            <div class="back-home-button" tabindex="-1">
              <i class="anzhiyufont anzhiyu-icon-grip-vertical" />
              <div class="back-menu-list-groups">
                {navConfig.siteMenu.groups.map((group) => (
                  <div class="back-menu-list-group">
                    <div class="back-menu-list-title">{group.title}</div>
                    <div class="back-menu-list">
                      {group.items.map((item) => (
                        <a
                          class="back-menu-item"
                          href={item.link}
                          target={item.link.startsWith("http") ? "_blank" : undefined}
                          rel={item.link.startsWith("http") ? "noopener noreferrer" : undefined}
                          title={item.name}
                        >
                          <img class="back-menu-item-icon" src={item.icon} alt={item.name} loading="lazy" />
                          <span class="back-menu-item-text">{item.name}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )
        }
        <a id="site-name" href="/" accesskey="h" title="返回博客主页">
          <div class="title">{siteConfig.title}</div>
          <i class="anzhiyufont anzhiyu-icon-house-chimney" />
        </a>
      </span>

      <div class="mask-name-container">
        <div id="name-container">
          <a id="page-name" href="javascript:void(0);" title="回到顶部">{pageTitle}</a>
        </div>
      </div>

      <div id="menus">
        <div class="menus_items">
          {
            navConfig.menu.map((item) =>
              item.children && item.children.length > 0 ? (
                <div class="menus_item">
                  <a class="site-page" href="javascript:void(0);">
                    {item.icon && <AnIcon name={item.icon} class="faa-tada" />}
                    <span>{" " + item.name}</span>
                  </a>
                  <ul class="menus_item_child">
                    {item.children.map((sub) => (
                      <li>
                        <a
                          class="site-page child faa-parent animated-hover"
                          href={sub.link === "#random-post" ? "javascript:void(0);" : sub.link}
                          data-random-post={sub.link === "#random-post" ? "true" : undefined}
                        >
                          {sub.icon && <AnIcon name={sub.icon} class="faa-tada" />}
                          <span>{" " + sub.name}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <div class="menus_item">
                  <a
                    class="site-page faa-parent animated-hover"
                    href={item.link || "/"}
                    data-random-post={item.link === "#random-post" ? "true" : undefined}
                  >
                    {item.icon && <AnIcon name={item.icon} class="faa-tada" />}
                    <span>{" " + item.name}</span>
                  </a>
                </div>
              ),
            )
          }
        </div>
      </div>

      <div id="nav-right">
        {
          navConfig.travelling && (
            <div class="nav-button only-home" id="travellings_button" title="随机前往一个开往项目网站">
              <a
                class="site-page"
                href="https://www.travellings.cn/go.html"
                target="_blank"
                rel="external nofollow noreferrer"
                title="开往-友链接力"
              >
                <i class="anzhiyufont anzhiyu-icon-train" />
              </a>
            </div>
          )
        }
        {
          navConfig.randomPost && (
            <div class="nav-button" id="randomPost_button" title="随机前往一篇文章">
              <a class="site-page" href="javascript:void(0);" data-random-post="true" title="随机前往一篇文章">
                <i class="anzhiyufont anzhiyu-icon-dice" />
              </a>
            </div>
          )
        }
        {
          themeConfig.features.search && (
            <div class="nav-button" id="search-button" title="站内搜索 (Ctrl+K)">
              <a class="site-page social-icon search" href="javascript:void(0);" accesskey="s" title="搜索">
                <i class="anzhiyufont anzhiyu-icon-magnifying-glass" />
                <span> 搜索</span>
              </a>
            </div>
          )
        }
        {
          themeConfig.features.console && (
            <>
              <input id="center-console" type="checkbox" aria-label="中控台开关" />
              <label class="widget" for="center-console" title="中控台">
                <i class="left" />
                <i class="widget center" />
                <i class="widget right" />
              </label>
            </>
          )
        }
        <Console
          client:load
          tags={tags}
          archives={archiveMonths}
          postCount={posts.length}
          categoryCount={categories.length}
        />
        <div class="nav-button" id="nav-totop" title="返回顶部">
          <a class="totopbtn" href="javascript:void(0);">
            <i class="anzhiyufont anzhiyu-icon-arrow-up" />
            <span id="percent">0</span>
          </a>
        </div>
        <div id="toggle-menu">
          <a class="site-page" href="javascript:void(0);" title="展开菜单">
            <i class="anzhiyufont anzhiyu-icon-bars" />
          </a>
        </div>
      </div>
    </div>
  </nav>

  {
    resolvedTopImg !== false &&
      (isPost ? (
        <slot name="post-header" />
      ) : isHome ? (
        <>
          <div id="site-info">
            <h1 id="site-title">{siteConfig.title}</h1>
            {themeConfig.header.subtitleTyping.length > 0 && (
              <div id="site-subtitle">
                <span id="subtitle" data-subtitles={JSON.stringify(themeConfig.header.subtitleTyping)}>
                  {themeConfig.header.subtitleTyping[0]}
                </span>
              </div>
            )}
            {profileConfig.social.length > 0 && (
              <div id="site_social_icons">
                {profileConfig.social.map((entry) => (
                  <a
                    class="social-icon faa-parent animated-hover"
                    href={entry.url}
                    target={entry.url.startsWith("http") ? "_blank" : undefined}
                    rel={entry.url.startsWith("http") ? "noopener noreferrer" : undefined}
                    title={entry.name}
                  >
                    <AnIcon name={entry.icon} class={entry.animation || "faa-tada"} />
                  </a>
                ))}
              </div>
            )}
          </div>
          <div id="scroll-down">
            <i class="anzhiyufont anzhiyu-icon-angle-down scroll-down-effects" />
          </div>
        </>
      ) : (
        <div id="page-site-info">
          <h1 id="site-title">{pageTitle}</h1>
        </div>
      ))
  }
</header>
