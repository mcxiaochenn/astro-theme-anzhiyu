---
import { getAllPosts, getPostUrl } from "@/utils/posts";
import { commentConfig, musicConfig, themeConfig } from "@/config";
import ContextMenu from "@/components/console/ContextMenu.svelte";
import ShortcutModal from "@/components/console/ShortcutModal.svelte";
import SearchDialog from "@/components/search/SearchDialog.svelte";
import MusicBall from "@/components/music/MusicBall.svelte";
import CommentBarrage from "@/components/comments/CommentBarrage.svelte";

interface Props {
  isPost?: boolean;
}

const { isPost = false } = Astro.props;

const posts = await getAllPosts();
const postUrls = posts.map((p) => getPostUrl(p));
const fallbackPosts = posts.map((p) => ({
  title: p.data.title,
  url: getPostUrl(p),
  description: p.data.description,
  tags: p.data.tags,
}));
---

{themeConfig.features.rightMenu && <ContextMenu client:load postUrls={postUrls} />}
{themeConfig.features.shortcutKey && <ShortcutModal client:load postUrls={postUrls} />}
{themeConfig.features.search && <SearchDialog client:load fallbackPosts={fallbackPosts} />}
{
  isPost && commentConfig.barrage && (
    <CommentBarrage
      client:idle
      enable={commentConfig.barrage}
      provider={commentConfig.provider}
      twikooEnvId={commentConfig.twikoo?.envId}
    />
  )
}

<div transition:persist="nav-music">
  <MusicBall
    client:idle
    enable={musicConfig.enable}
    playlistId={musicConfig.meting.id}
    server={musicConfig.meting.server}
    type={musicConfig.meting.type}
  />
</div>

<div id="anzhiyu-toast" role="status" aria-live="polite"></div>
<div id="anzhiyu-lightbox" aria-hidden="true">
  <img src="" alt="" />
</div>

<script is:inline define:vars={{ postUrls }}>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll('[data-random-post="true"]').forEach((el) => {
      if (el.dataset.randBound === "1") return;
      el.dataset.randBound = "1";
      el.addEventListener("click", (e) => {
        e.preventDefault();
        if (postUrls.length > 0) {
          const url = postUrls[Math.floor(Math.random() * postUrls.length)];
          window.location.href = url;
        }
      });
    });
  });
</script>

<script>
  import "@/scripts/anzhiyu-client";
</script>
