---
import { siteConfig, themeConfig } from "@/config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: Date;
  updatedTime?: Date;
  mainColor?: string;
}

const {
  title,
  description = siteConfig.description,
  image = "/img/default_cover.jpg",
  article = false,
  publishedTime,
  updatedTime,
  mainColor,
} = Astro.props;

const fullTitle = title ? `${title} | ${siteConfig.title}` : `${siteConfig.title} - ${siteConfig.subtitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteConfig.url);
const imageURL = image.startsWith("http") ? image : new URL(image, Astro.site || siteConfig.url).toString();
const defaultMode = themeConfig.displayMode;
const lightThemeColor = mainColor || themeConfig.themeColor.light;
const darkThemeColor = mainColor || themeConfig.themeColor.dark;
---

<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
<title>{fullTitle}</title>
<meta name="author" content={siteConfig.author} />
<meta name="description" content={description} />
<meta name="keywords" content={siteConfig.keywords.join(",")} />
<meta name="theme-color" content="#f7f9fe" id="meta-theme-color" />
<link rel="icon" href={siteConfig.favicon} />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
<link rel="preload" href="/fonts/anzhiyufont.woff2" as="font" type="font/woff2" crossorigin />

<!-- Open Graph -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:title" content={fullTitle} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={siteConfig.language} />
<meta property="og:image" content={imageURL} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />

<script
  is:inline
  define:vars={{
    defaultMode,
    lightThemeColor,
    darkThemeColor,
    hasCustomMainColor: Boolean(mainColor),
  }}
>
  (function () {
    function resolveTheme() {
      const saved = localStorage.getItem("anzhiyu-theme");
      if (saved === "dark" || saved === "light") return saved;
      if (defaultMode === "dark" || defaultMode === "light") return defaultMode;
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }

    function applyRootState(doc) {
      const mode = resolveTheme();
      const root = doc.documentElement;
      root.setAttribute("data-theme", mode);
      const activeColor = mode === "dark" ? darkThemeColor : lightThemeColor;
      root.style.setProperty("--anzhiyu-theme", activeColor);
      root.style.setProperty("--anzhiyu-main", activeColor);
      if (hasCustomMainColor) {
        root.style.setProperty("--anzhiyu-theme-op", activeColor + "23");
        root.style.setProperty("--anzhiyu-theme-op-deep", activeColor + "dd");
        root.style.setProperty("--anzhiyu-main-op", activeColor + "23");
      }
      const meta = doc.getElementById("meta-theme-color");
      if (meta) {
        meta.setAttribute("content", mode === "dark" ? "#18171d" : "#f7f9fe");
      }
    }

    applyRootState(document);

    if (!window.__anzhiyuThemeBound) {
      window.__anzhiyuThemeBound = true;
      document.addEventListener("astro:before-swap", (ev) => {
        if (ev.newDocument) applyRootState(ev.newDocument);
      });
      document.addEventListener("astro:after-swap", () => {
        applyRootState(document);
        if (localStorage.getItem("anzhiyu-hide-aside") === "true") {
          document.getElementById("content-inner")?.classList.add("hide-aside");
          document.documentElement.classList.add("hide-aside");
        }
      });
    }
  })();
</script>
