---
import { siteConfig, themeConfig } from "@/config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: Date;
  updatedTime?: Date;
}

const {
  title,
  description = siteConfig.description,
  image = "/img/default_cover.jpg",
  article = false,
  publishedTime,
  updatedTime,
} = Astro.props;

const fullTitle = title ? `${title} | ${siteConfig.title}` : `${siteConfig.title} - ${siteConfig.subtitle}`;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).toString();
const ogImage = image.startsWith("http") ? image : new URL(image, siteConfig.url).toString();
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={siteConfig.keywords.join(", ")} />
<meta name="author" content={siteConfig.author} />
<link rel="icon" href={siteConfig.favicon} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />

<!-- Open Graph -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:image" content={ogImage} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- 防止暗色模式首屏闪烁，并在 ClientRouter 视图切换后保持同步 -->
<script is:inline define:vars={{ defaultMode: themeConfig.displayMode }}>
  (function () {
    function resolveTheme() {
      const saved = localStorage.getItem("anzhiyu-theme");
      if (saved === "dark" || saved === "light") return saved;
      if (defaultMode === "dark" || defaultMode === "light") return defaultMode;
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }

    function applyTheme(doc) {
      const theme = resolveTheme();
      const root = doc.documentElement;
      root.setAttribute("data-theme", theme);
      root.classList.toggle("dark", theme === "dark");
    }

    applyTheme(document);

    document.addEventListener("astro:before-swap", (e) => {
      applyTheme(e.newDocument);
    });
  })();
</script>
