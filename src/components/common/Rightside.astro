---
import { commentConfig, themeConfig } from "@/config";

interface Props {
  isPost?: boolean;
  hasComments?: boolean;
  showAside?: boolean;
  showToc?: boolean;
}

const {
  isPost = false,
  hasComments = false,
  showAside = true,
  showToc = false,
} = Astro.props;

const commentsActive = hasComments && commentConfig.provider !== "none";
const barrageActive = isPost && commentConfig.barrage;
---

<div id="rightside">
  <div id="rightside-config-hide">
    {
      isPost && themeConfig.features.readMode && (
        <button id="readmode" type="button" title="阅读模式">
          <i class="anzhiyufont anzhiyu-icon-book-open" />
        </button>
      )
    }
    {
      themeConfig.features.translate && (
        <button id="translateLink" type="button" title="简繁转换">
          繁
        </button>
      )
    }
    <button id="darkmode" type="button" title="浅色和深色模式转换">
      <i class="anzhiyufont anzhiyu-icon-circle-half-stroke" />
    </button>
    {
      showAside && themeConfig.sidebar.enable && (
        <button id="hide-aside-btn" type="button" title="单栏和双栏切换">
          <i class="anzhiyufont anzhiyu-icon-arrows-left-right" />
        </button>
      )
    }
  </div>

  <div id="rightside-config-show">
    <button id="rightside-config" type="button" title="设置">
      <i class="anzhiyufont anzhiyu-icon-gear" />
    </button>
    {
      isPost && showToc && (
        <button class="close" id="mobile-toc-button" type="button" title="目录">
          <i class="anzhiyufont anzhiyu-icon-list-ul" />
        </button>
      )
    }
    {
      commentsActive && (
        <a id="to_comment" href="#post-comment" title="直达评论">
          <i class="anzhiyufont anzhiyu-icon-comments" />
        </a>
      )
    }
    {
      barrageActive && (
        <a id="switch-commentBarrage" href="javascript:void(0);" title="开关热评弹幕">
          <i class="anzhiyufont anzhiyu-icon-danmu" />
        </a>
      )
    }
    <button id="go-up" type="button" title="回到顶部">
      <i class="anzhiyufont anzhiyu-icon-arrow-up" />
    </button>
  </div>
</div>
