---
import AnIcon from "./AnIcon.astro";
import { profileConfig, siteConfig } from "@/config";
import { getSiteData } from "@/data/site-data";

const startYear = new Date(siteConfig.footer.since).getFullYear();
const currentYear = new Date().getFullYear();
const yearPrefix =
  startYear && startYear !== currentYear
    ? `©${startYear} - ${currentYear} By `
    : `©${currentYear} By `;

const half = Math.ceil(profileConfig.social.length / 2);
const leftSocial = profileConfig.social.slice(0, half);
const rightSocial = profileConfig.social.slice(half);

interface FriendGroup {
  link_list?: { name: string; link: string }[];
}
const linkGroups = getSiteData<FriendGroup[]>("link") ?? [];
const allFriends = linkGroups.flatMap((g) => g.link_list ?? []);
const initialFriends = allFriends.slice(0, 3);
---

<footer id="footer">
  <div id="footer-wrap">
    {
      profileConfig.social.length > 0 && (
        <div id="footer_deal">
          {leftSocial.map((s) => (
            <a
              class="deal_link"
              href={s.url}
              target={s.url.startsWith("http") ? "_blank" : undefined}
              rel={s.url.startsWith("http") ? "noopener noreferrer" : undefined}
              title={s.name}
            >
              <AnIcon name={s.icon} />
            </a>
          ))}
          <img
            class="footer_mini_logo entered loaded"
            id="footer-mini-logo"
            title="返回顶部"
            src={profileConfig.avatar}
            alt={siteConfig.author}
            width="50"
            height="50"
          />
          {rightSocial.map((s) => (
            <a
              class="deal_link"
              href={s.url}
              target={s.url.startsWith("http") ? "_blank" : undefined}
              rel={s.url.startsWith("http") ? "noopener noreferrer" : undefined}
              title={s.name}
            >
              <AnIcon name={s.icon} />
            </a>
          ))}
        </div>
      )
    }

    {
      siteConfig.footer.links && siteConfig.footer.links.length > 0 && (
        <div id="anzhiyu-footer">
          {siteConfig.footer.links.map((group) => (
            <div class="footer-group">
              <div class="footer-title">{group.title}</div>
              <div class="footer-links">
                {group.items.map((item) => (
                  <a
                    class="footer-item"
                    href={item.link}
                    target={item.external || item.link.startsWith("http") ? "_blank" : undefined}
                    rel={item.external || item.link.startsWith("http") ? "noopener noreferrer" : undefined}
                    title={item.name}
                  >
                    {item.name}
                  </a>
                ))}
              </div>
            </div>
          ))}
          {allFriends.length > 0 && (
            <div class="footer-group">
              <div class="footer-title-group">
                <div class="footer-title">友链</div>
                <a
                  class="random-friends-btn"
                  id="footer-random-friends-btn"
                  href="javascript:void(0);"
                  title="换一批友情链接"
                  data-friends={JSON.stringify(allFriends)}
                >
                  <i class="anzhiyufont anzhiyu-icon-arrow-rotate-right" />
                </a>
              </div>
              <div class="footer-links" id="friend-links-in-footer">
                {initialFriends.map((f) => (
                  <a class="footer-item" href={f.link} target="_blank" rel="noopener noreferrer" title={f.name}>
                    {f.name}
                  </a>
                ))}
                <a class="footer-item" href="/link/" title="更多友链">更多</a>
              </div>
            </div>
          )}
        </div>
      )
    }

    {
      siteConfig.footer.runtimeEnable && (
        <div id="workboard">
          {siteConfig.footer.workBadge?.enable && (
            <img
              class="workSituationImg boardsign"
              src={siteConfig.footer.workBadge.img}
              alt={siteConfig.footer.workBadge.description}
              title={siteConfig.footer.workBadge.description}
            />
          )}
          <div id="runtimeTextTip" data-since={siteConfig.footer.since}>
            本站已稳定运行 <span id="footer-runtime-days">0</span> 天
          </div>
        </div>
      )
    }

    {
      siteConfig.footer.badges && siteConfig.footer.badges.length > 0 && (
        <p id="ghbdages">
          {siteConfig.footer.badges.map((b) => (
            <a
              class="github-badge"
              target="_blank"
              rel="noopener noreferrer"
              href={b.link}
              style="margin-inline:5px"
              data-title={b.title}
              title={b.title}
            >
              <img src={b.img} alt={b.alt || b.title} loading="lazy" />
            </a>
          ))}
        </p>
      )
    }
  </div>

  <div id="footer-bar">
    <div class="footer-bar-links">
      <div class="footer-bar-left">
        <div id="footer-bar-tips">
          <div class="copyright">
            {yearPrefix}
            <a class="footer-bar-link" href="/about/" title={siteConfig.author}>
              {siteConfig.author}
            </a>
          </div>
          {siteConfig.footer.icp && (
            <a
              class="footer-bar-link"
              href={siteConfig.footer.icp.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {siteConfig.footer.icp.text}
            </a>
          )}
        </div>
      </div>
      <div class="footer-bar-right">
        {
          (siteConfig.footer.barLinks ?? []).map((item) => (
            <a
              class="footer-bar-link"
              href={item.link}
              target={item.external || item.link.startsWith("http") ? "_blank" : undefined}
              rel={item.external || item.link.startsWith("http") ? "noopener noreferrer" : undefined}
              title={item.text}
            >
              {item.text}
            </a>
          ))
        }
        {
          siteConfig.footer.ccLink && (
            <a
              class="footer-bar-link cc"
              href={siteConfig.footer.ccLink}
              target="_blank"
              rel="noopener noreferrer"
              title="CC BY-NC-SA 4.0 许可协议"
            >
              <i class="anzhiyufont anzhiyu-icon-copyright-line" />
              <i class="anzhiyufont anzhiyu-icon-creative-commons-by-line" />
              <i class="anzhiyufont anzhiyu-icon-creative-commons-nc-line" />
              <i class="anzhiyufont anzhiyu-icon-creative-commons-nd-line" />
            </a>
          )
        }
      </div>
    </div>
  </div>
</footer>
