---
import { Icon } from "astro-icon/components";
import { formatDate, getPostUrl, type PostEntry } from "@/utils/posts";

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

<div class="card-widget anzhiyu-card p-4">
  <div class="flex items-center gap-2 font-bold text-sm mb-3">
    <Icon name="fa6-solid:clock-rotate-left" class="w-4 h-4 text-[var(--anzhiyu-main)]" />
    <span>最新文章</span>
  </div>
  <div class="flex flex-col gap-3">
    {
      posts.map((post) => {
        const cover = typeof post.data.cover === "string" ? post.data.cover : "/img/default_cover.jpg";
        return (
          <a href={getPostUrl(post)} class="recent-item group">
            <img src={cover} alt={post.data.title} class="recent-thumb" loading="lazy" />
            <div class="min-w-0 flex-1">
              <div class="text-sm font-semibold line-clamp-2 group-hover:text-[var(--anzhiyu-main)] transition-colors">
                {post.data.title}
              </div>
              {post.data.date && (
                <time class="text-xs text-[var(--anzhiyu-secondtext)] mt-0.5 block">
                  {formatDate(post.data.date)}
                </time>
              )}
            </div>
          </a>
        );
      })
    }
  </div>
</div>

<style>
  .recent-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .recent-thumb {
    width: 56px;
    height: 56px;
    border-radius: var(--anzhiyu-radius);
    object-fit: cover;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .recent-item:hover .recent-thumb {
    transform: scale(1.05);
  }
</style>
