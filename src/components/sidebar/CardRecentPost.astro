---
import { formatDate, getPostUrl, type PostEntry } from "@/utils/posts";

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <div class="card-widget card-recent-post">
      <div class="item-headline">
        <i class="anzhiyufont anzhiyu-icon-history" />
        <span>最新文章</span>
      </div>
      <div class="aside-list">
        {posts.map((post) => {
          const url = getPostUrl(post);
          const cover = typeof post.data.cover === "string" ? post.data.cover : "/img/default_cover.jpg";
          const dateStr = post.data.date ? formatDate(post.data.date) : "";
          return (
            <div class="aside-list-item">
              <a class="thumbnail" href={url} title={post.data.title}>
                <img src={cover} alt={post.data.title} loading="lazy" />
              </a>
              <div class="content">
                <a class="title" href={url} title={post.data.title}>
                  {post.data.title}
                </a>
                {dateStr && (
                  <time datetime={post.data.date?.toISOString()} title={`发表于 ${dateStr}`}>
                    {dateStr}
                  </time>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )
}
