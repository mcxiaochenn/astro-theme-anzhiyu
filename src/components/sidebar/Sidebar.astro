---
import { themeConfig } from "@/config";
import {
  aggregateCategories,
  aggregateTags,
  getAllPosts,
  getPostStats,
} from "@/utils/posts";
import CardAuthor from "./CardAuthor.astro";
import CardWeixin from "./CardWeixin.astro";
import CardAnnouncement from "./CardAnnouncement.astro";
import CardRecentPost from "./CardRecentPost.astro";
import CardCategories from "./CardCategories.astro";
import CardTags from "./CardTags.astro";
import CardArchives from "./CardArchives.astro";
import CardWebinfo from "./CardWebinfo.astro";

interface Props {
  showAuthor?: boolean;
  isPost?: boolean;
}

const { showAuthor = true, isPost = false } = Astro.props;
const posts = await getAllPosts();
const categories = aggregateCategories(posts);
const tags = aggregateTags(posts);
const totalWords = posts.reduce((acc, p) => acc + getPostStats(p).words, 0);

const archiveMap = new Map<string, { label: string; count: number }>();
for (const p of posts) {
  const d = p.data.date ?? new Date();
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
  const label = `${d.getFullYear()} ${String(d.getMonth() + 1).padStart(2, "0")}`;
  const item = archiveMap.get(key) ?? { label, count: 0 };
  item.count += 1;
  archiveMap.set(key, item);
}
const archives = Array.from(archiveMap.values());
---

<div id="aside-content" class="aside-content">
  {showAuthor && <CardAuthor postCount={posts.length} tagCount={tags.length} categoryCount={categories.length} />}
  <CardAnnouncement />
  <CardWeixin />
  {!isPost && themeConfig.sidebar.showCategories && <CardCategories categories={categories} />}

  <div class="sticky_layout">
    <slot name="sticky" />
    <CardRecentPost posts={posts.slice(0, themeConfig.sidebar.recentPostsCount)} />
    {
      !isPost && (
        <div class="card-widget">
          {themeConfig.sidebar.showTags && <CardTags tags={tags} bare={true} />}
          {themeConfig.sidebar.showArchives && <CardArchives archives={archives} bare={true} />}
          {themeConfig.sidebar.showWebinfo && (
            <CardWebinfo postCount={posts.length} totalWords={totalWords} bare={true} />
          )}
        </div>
      )
    }
  </div>
</div>
