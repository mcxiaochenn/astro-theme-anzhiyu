---
interface TagItem {
  name: string;
  count: number;
}

interface Props {
  tags: TagItem[];
  bare?: boolean;
}

const { tags, bare = false } = Astro.props;
---

{
  tags.length > 0 &&
    (bare ? (
      <div class="card-tags">
        <div class="item-headline">
          <i class="anzhiyufont anzhiyu-icon-tags" />
          <span>标签</span>
        </div>
        <div class="card-tag-cloud">
          {tags.slice(0, 40).map((t) => (
            <a href={`/tags/${encodeURIComponent(t.name)}/`} style="font-size: 1em;">
              {t.name}
              <sup>{t.count}</sup>
            </a>
          ))}
        </div>
        {tags.length > 40 && (
          <a class="tags-cloud-more" href="/tags/">查看全部</a>
        )}
      </div>
    ) : (
      <div class="card-widget card-tags">
        <div class="item-headline">
          <i class="anzhiyufont anzhiyu-icon-tags" />
          <span>标签</span>
        </div>
        <div class="card-tag-cloud">
          {tags.slice(0, 40).map((t) => (
            <a href={`/tags/${encodeURIComponent(t.name)}/`} style="font-size: 1em;">
              {t.name}
              <sup>{t.count}</sup>
            </a>
          ))}
        </div>
      </div>
    ))
}
