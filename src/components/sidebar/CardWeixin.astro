---
import { profileConfig } from "@/config";

const { enable, face, backFace } = profileConfig.weixinCard;
---

{
  enable && face && backFace && (
    <div class="card-widget anzhiyu-right-widget" id="card-wechat">
      <div id="flip-wrapper">
        <div id="flip-content">
          <div class="face" style={`background: url(${face}) center center / 100% no-repeat`} />
          <div class="back face" style={`background: url(${backFace}) center center / 100% no-repeat`} />
        </div>
      </div>
    </div>
  )
}
