---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";

interface Props {
  postCount: number;
  totalWords: number;
}

const { postCount, totalWords } = Astro.props;
const startTime = new Date(siteConfig.footer.since).getTime();
const runDays = Math.max(1, Math.floor((Date.now() - startTime) / 86_400_000));
const wordsText = totalWords >= 1000 ? `${(totalWords / 1000).toFixed(1)}k` : String(totalWords);
---

<div class="card-widget card-webinfo anzhiyu-card p-4">
  <div class="flex items-center gap-2 font-bold text-sm mb-3">
    <Icon name="fa6-solid:chart-line" class="w-4 h-4 text-[var(--anzhiyu-main)]" />
    <span>网站资讯</span>
  </div>
  <div class="webinfo flex flex-col gap-2.5 text-sm">
    <div class="webinfo-item">
      <div class="item-name">
        <Icon name="fa6-regular:newspaper" class="w-3.5 h-3.5 text-[var(--anzhiyu-secondtext)]" />
        <span>文章数目：</span>
      </div>
      <div class="item-count">{postCount} 篇</div>
    </div>
    <div class="webinfo-item">
      <div class="item-name">
        <Icon name="fa6-solid:clock-rotate-left" class="w-3.5 h-3.5 text-[var(--anzhiyu-secondtext)]" />
        <span>已运行时间：</span>
      </div>
      <div class="item-count">{runDays} 天</div>
    </div>
    <div class="webinfo-item">
      <div class="item-name">
        <Icon name="fa6-solid:font" class="w-3.5 h-3.5 text-[var(--anzhiyu-secondtext)]" />
        <span>本站总字数：</span>
      </div>
      <div class="item-count">{wordsText}</div>
    </div>
  </div>
</div>

<style>
  .webinfo-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .item-name {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--anzhiyu-secondtext);
  }

  .item-count {
    font-weight: 700;
  }
</style>
