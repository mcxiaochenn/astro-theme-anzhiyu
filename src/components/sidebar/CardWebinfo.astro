---
import { siteConfig } from "@/config";

interface Props {
  postCount: number;
  totalWords: number;
  bare?: boolean;
}

const { postCount, totalWords, bare = false } = Astro.props;
const formattedWords =
  totalWords >= 1000 ? `${(totalWords / 1000).toFixed(1)}k` : String(totalWords);
const sinceMs = new Date(siteConfig.footer.since).getTime();
const initialDays = Math.max(1, Math.floor((Date.now() - sinceMs) / 86400000));
---

<div class:list={[!bare && "card-widget", "card-webinfo"]}>
  <div class="item-headline">
    <i class="anzhiyufont anzhiyu-icon-chart-line" />
    <span>网站资讯</span>
  </div>
  <div class="webinfo">
    <div class="webinfo-item">
      <div class="webinfo-item-title">
        <i class="anzhiyufont anzhiyu-icon-file-lines" />
        <div class="item-name">文章数目 :</div>
      </div>
      <div class="item-count">{postCount}</div>
    </div>

    <div class="webinfo-item">
      <div class="webinfo-item-title">
        <i class="anzhiyufont anzhiyu-icon-stopwatch" />
        <div class="item-name">已运行时间 :</div>
      </div>
      <div class="item-count" id="runtimeshow" data-publishDate={siteConfig.footer.since}>
        {initialDays} 天
      </div>
    </div>

    <div class="webinfo-item">
      <div class="webinfo-item-title">
        <i class="anzhiyufont anzhiyu-icon-font" />
        <div class="item-name">本站总字数 :</div>
      </div>
      <div class="item-count">{formattedWords}</div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const el = document.getElementById("runtimeshow");
    if (!el) return;
    const pub = el.getAttribute("data-publishDate");
    if (!pub) return;
    const days = Math.max(1, Math.floor((Date.now() - new Date(pub).getTime()) / 86400000));
    el.textContent = `${days} 天`;
  });
</script>
