---
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "@/config";

interface Props {
  postCount: number;
  tagCount: number;
  categoryCount: number;
}

const { postCount, tagCount, categoryCount } = Astro.props;
---

<div class="card-widget card-info anzhiyu-card">
  <div class="card-info-top">
    <div class="author-say">{profileConfig.greeting}</div>
    <div class="author-avatar-wrap">
      <img src={profileConfig.avatar} alt={profileConfig.name} class="author-avatar" loading="eager" />
      <span class="author-status" title="在线状态">{profileConfig.statusEmoji}</span>
    </div>
    <div class="author-name">{profileConfig.name}</div>
    <div class="author-bio">{profileConfig.bio}</div>
  </div>

  <div class="card-info-data">
    <a href="/archives/" class="data-item">
      <span class="headline">文章</span>
      <span class="length-num">{postCount}</span>
    </a>
    <a href="/tags/" class="data-item">
      <span class="headline">标签</span>
      <span class="length-num">{tagCount}</span>
    </a>
    <a href="/categories/" class="data-item">
      <span class="headline">分类</span>
      <span class="length-num">{categoryCount}</span>
    </a>
  </div>

  <div class="card-info-social">
    {
      profileConfig.social.map((s) => (
        <a
          href={s.url}
          target={s.url.startsWith("http") ? "_blank" : undefined}
          rel={s.url.startsWith("http") ? "noopener noreferrer" : undefined}
          class="social-icon"
          title={s.name}
          aria-label={s.name}
        >
          <Icon name={s.icon} class="w-4 h-4" />
        </a>
      ))
    }
  </div>

  <a href="/about/" class="card-info-btn">
    <Icon name="fa6-solid:paper-plane" class="w-3.5 h-3.5" />
    <span>认识 {siteConfig.author}</span>
  </a>
</div>

<style>
  .card-info {
    position: relative;
    padding: 1.25rem;
    background: linear-gradient(155deg, var(--anzhiyu-main) 0%, var(--anzhiyu-theme-deep) 100%);
    color: var(--anzhiyu-white);
    border: none;
    overflow: hidden;
  }

  .card-info-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .author-say {
    font-size: 0.78rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--anzhiyu-radius-full);
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(6px);
    margin-bottom: 0.9rem;
  }

  .author-avatar-wrap {
    position: relative;
    width: 96px;
    height: 96px;
    margin-bottom: 0.75rem;
  }

  .author-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid rgba(255, 255, 255, 0.85);
    transition: transform 0.5s ease;
  }

  .card-info:hover .author-avatar {
    transform: rotate(360deg);
  }

  .author-status {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--anzhiyu-card-bg);
    color: var(--anzhiyu-fontcolor);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .author-name {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .author-bio {
    margin-top: 0.35rem;
    font-size: 0.82rem;
    opacity: 0.9;
    line-height: 1.5;
  }

  .card-info-data {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 1rem 0;
    padding: 0.65rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    text-align: center;
  }

  .data-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    transition: opacity 0.2s ease;
  }

  .data-item:hover {
    opacity: 0.8;
  }

  .headline {
    font-size: 0.78rem;
    opacity: 0.85;
  }

  .length-num {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .card-info-social {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .social-icon:hover {
    background: var(--anzhiyu-white);
    color: var(--anzhiyu-main);
    transform: translateY(-2px);
  }

  .card-info-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0.5rem 1rem;
    border-radius: var(--anzhiyu-radius-full);
    background: rgba(255, 255, 255, 0.2);
    font-size: 0.88rem;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .card-info-btn:hover {
    background: var(--anzhiyu-white);
    color: var(--anzhiyu-main);
  }
</style>
