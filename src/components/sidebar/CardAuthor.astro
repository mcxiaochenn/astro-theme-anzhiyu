---
import AnIcon from "@/components/common/AnIcon.astro";
import { profileConfig, siteConfig } from "@/config";

interface Props {
  postCount?: number;
  tagCount?: number;
  categoryCount?: number;
}

const { postCount: _p = 0, tagCount: _t = 0, categoryCount: _c = 0 } = Astro.props;
void _p;
void _t;
void _c;
---

<div class="card-widget card-info">
  <div class="card-content">
    <div class="author-info__sayhi" id="author-info__sayhi" title="点击切换问候语">
      {profileConfig.greeting}
    </div>

    <div class="author-info-avatar">
      <img class="avatar-img" src={profileConfig.avatar} alt={profileConfig.name} />
      {
        profileConfig.statusImg ? (
          <div class="author-status">
            <img src={profileConfig.statusImg} class="g-status" alt="status" />
          </div>
        ) : profileConfig.statusEmoji ? (
          <div class="author-status" title="在线状态">
            <span class="g-status" style="display:flex;align-items:center;justify-content:center;font-size:14px;">
              {profileConfig.statusEmoji}
            </span>
          </div>
        ) : null
      }
    </div>

    <div class="author-info__description" set:html={profileConfig.bio} />

    {
      profileConfig.social.length > 0 && (
        <div class="author-info__bottom-group">
          <a class="author-info__bottom-group-left" href="/about/">
            <h1 class="author-info__name">{profileConfig.name}</h1>
            <div class="author-info__desc">{siteConfig.subtitle}</div>
          </a>
          <div class="card-info-social-icons is-center">
            {profileConfig.social.slice(0, 2).map((s) => (
              <a
                class="social-icon faa-parent animated-hover"
                href={s.url}
                target={s.url.startsWith("http") ? "_blank" : undefined}
                rel={s.url.startsWith("http") ? "noopener noreferrer" : undefined}
                title={s.name}
              >
                <AnIcon name={s.icon} class={s.animation || "faa-tada"} />
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</div>
