---
/**
 * common.astro — 上游 `layout/includes/third-party/newest-comments/common.pug:1-75`（P5-1）。
 *
 * 产出 `window.newestComments`（changeContent / generateHtml / run）。
 * 门控：`theme.newest_comments.enable` + `theme.comments.use` 非空。
 * 读 `theme.newest_comments.avatar` 与 `theme.lazyload.enable`（决定 data-lazy-src/src）。
 * 注意：上游 layout 未直接 include common.pug（疑似遗留/外部注入），接线时应与
 * newest-comments/index.astro 一同挂在 additional-js 段并置于其之前。
 */
import { getThemeConfig } from '../../../config/theme-context.ts'
import { renderNewestCommentsCommon } from './render.mjs'

interface Props {
  page?: Record<string, unknown>
  [key: string]: unknown
}

const theme = getThemeConfig()
const html = renderNewestCommentsCommon(theme, Astro.props)
---

<Fragment set:html={html} />
