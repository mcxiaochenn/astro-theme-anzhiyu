---
import { Icon } from "astro-icon/components";
import { formatDate, getPostUrl, normalizeCategoryList, type PostEntry } from "@/utils/posts";

interface Props {
  post: PostEntry;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const url = getPostUrl(post);
const cover = typeof post.data.cover === "string" ? post.data.cover : "/img/default_cover.jpg";
const categories = normalizeCategoryList(post.data.categories);
const isPinned = Boolean(post.data.sticky || post.data.top);
---

<article class="recent-post-item anzhiyu-card anzhiyu-card-hover animate-slide-in" style={`animation-delay: ${Math.min(index * 40, 320)}ms`}>
  <a href={url} class="post_cover" aria-label={post.data.title}>
    <img src={cover} alt={post.data.title} class="post-bg" loading={index < 4 ? "eager" : "lazy"} />
    {
      isPinned && (
        <span class="badge-pin">
          <Icon name="fa6-solid:thumbtack" class="w-3 h-3" />
          <span>置顶</span>
        </span>
      )
    }
  </a>

  <div class="recent-post-info">
    <div class="post-info-top">
      {
        categories.length > 0 && (
          <a href={`/categories/${encodeURIComponent(categories[0])}/`} class="post-cat">
            {categories[0]}
          </a>
        )
      }
      <a href={url} class="article-title">
        {post.data.title}
      </a>
    </div>

    {
      post.data.description && (
        <p class="article-desc">{post.data.description}</p>
      )
    }

    <div class="article-meta-wrap">
      <div class="article-tags">
        {
          (post.data.tags ?? []).slice(0, 3).map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag)}/`} class="article-tag">
              #{tag}
            </a>
          ))
        }
      </div>
      {
        post.data.date && (
          <time class="article-date" datetime={post.data.date.toISOString()}>
            <Icon name="fa6-regular:calendar" class="w-3 h-3" />
            <span>{formatDate(post.data.date)}</span>
          </time>
        )
      }
    </div>
  </div>
</article>

<style>
  .recent-post-item {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }

  .post_cover {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--anzhiyu-secondbg);
  }

  .post-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--animation-in);
  }

  .recent-post-item:hover .post-bg {
    transform: scale(1.06);
  }

  .badge-pin {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.18rem 0.55rem;
    border-radius: var(--anzhiyu-radius-full);
    background: var(--anzhiyu-main);
    color: var(--anzhiyu-white);
    font-size: 0.74rem;
    font-weight: 700;
  }

  .recent-post-info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    padding: 1rem 1.15rem;
    gap: 0.55rem;
  }

  .post-info-top {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .post-cat {
    align-self: flex-start;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--anzhiyu-main);
  }

  .article-title {
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--anzhiyu-fontcolor);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .recent-post-item:hover .article-title {
    color: var(--anzhiyu-main);
  }

  .article-desc {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--anzhiyu-secondtext);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-meta-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.35rem;
    font-size: 0.78rem;
    color: var(--anzhiyu-secondtext);
  }

  .article-tags {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    overflow: hidden;
  }

  .article-tag {
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .article-tag:hover {
    color: var(--anzhiyu-main);
  }

  .article-date {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }
</style>
