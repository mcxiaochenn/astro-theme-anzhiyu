---
import { formatDate, getPostUrl, normalizeCategoryList, type PostEntry } from "@/utils/posts";

interface Props {
  post: PostEntry;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const url = getPostUrl(post);
const hasExplicitNoCover = post.data.cover === false;
const cover = typeof post.data.cover === "string" ? post.data.cover : "/img/default_cover.jpg";
const categories = normalizeCategoryList(post.data.categories);
const tags = post.data.tags ?? [];
const isPinned = Boolean(post.data.sticky || post.data.top);
const isNewest = index === 0 && !isPinned;
const coverSide = index % 2 === 0 ? "left_radius" : "right_radius right";
const dateStr = post.data.date ? formatDate(post.data.date) : "";
const dateIso = post.data.date ? post.data.date.toISOString() : "";
---

<div class="recent-post-item">
  {
    !hasExplicitNoCover && (
      <div class={`post_cover ${coverSide}`}>
        <a href={url} title={post.data.title}>
          <img
            class="post_bg"
            src={cover}
            alt={post.data.title}
            loading={index < 4 ? "eager" : "lazy"}
          />
        </a>
      </div>
    )
  }

  <div class:list={["recent-post-info", { "no-cover": hasExplicitNoCover }]}>
    <div class="recent-post-info-top">
      <div class="recent-post-info-top-tips">
        {
          isPinned && (
            <span class="article-meta sticky-warp">
              <i class="anzhiyufont anzhiyu-icon-thumbtack sticky" />
              <span class="sticky">置顶</span>
            </span>
          )
        }
        {categories.map((cat) => <div class="article-categories-original">{cat}</div>)}
        {isNewest && <span class="newPost">最新</span>}
        <a class="unvisited-post" href={url} title={post.data.title}>未读</a>
      </div>
      <a class="article-title" href={url} title={post.data.title}>
        {post.data.title}
      </a>
    </div>

    <div class="article-meta-wrap">
      {
        dateStr && (
          <span class="post-meta-date">
            <i class="anzhiyufont anzhiyu-icon-calendar-alt" style="display:none" />
            <span class="article-meta-label">发表于</span>
            <time datetime={dateIso} title={`发表于 ${dateStr}`}>
              {dateStr}
            </time>
          </span>
        )
      }

      {
        tags.length > 0 && (
          <span class="article-meta tags">
            {tags.map((tag) => (
              <a class="article-meta__tags" href={`/tags/${encodeURIComponent(tag)}/`}>
                <span>
                  <i class="anzhiyufont anzhiyu-icon-hashtag" />
                  {tag}
                </span>
              </a>
            ))}
          </span>
        )
      }
    </div>

    {post.data.description && <div class="content">{post.data.description}</div>}
  </div>
</div>
