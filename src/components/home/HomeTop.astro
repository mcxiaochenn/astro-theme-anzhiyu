---
import { Icon } from "astro-icon/components";
import { themeConfig } from "@/config";
import { getPostUrl, type PostEntry } from "@/utils/posts";

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;

const featuredPosts = posts
  .filter((p) => p.data.top_group_index !== undefined || p.data.swiper_index !== undefined)
  .slice(0, 6);
const topPosts = featuredPosts.length > 0 ? featuredPosts : posts.slice(0, 6);
---

{
  themeConfig.home.homeTopEnable && (
    <section id="home_top" class="home-top-section">
      <div class="home-top-grid">
        <!-- 左侧：Banner 创意区 + 分类磁贴 -->
        <div class="top-left-col">
          <div class="banners-box anzhiyu-card">
            <div class="banners-title">
              <div class="banners-title-big">{themeConfig.home.homeTopTitle}</div>
              <div class="banners-title-small">{themeConfig.home.homeTopSubtitle}</div>
            </div>
            <div class="banner-actions">
              <a href="/archives/" class="banner-cta">
                <Icon name="fa6-solid:rocket" class="w-3.5 h-3.5" />
                <span>探索文章</span>
              </a>
              <a href="/about/" class="banner-cta secondary">
                <Icon name="fa6-solid:user" class="w-3.5 h-3.5" />
                <span>关于我</span>
              </a>
            </div>
          </div>

          <div class="category-group">
            {themeConfig.home.categories.map((cat) => (
              <a href={cat.link} class="category-tile" style={`background: ${cat.gradient};`}>
                <span class="tile-name">{cat.name}</span>
                <Icon name={cat.icon} class="tile-icon" />
              </a>
            ))}
          </div>
        </div>

        <!-- 右侧：今日推荐 / 热门文章组 -->
        <div class="top-right-col">
          <div class="top-group-grid">
            {topPosts.map((post) => {
              const cover = typeof post.data.cover === "string" ? post.data.cover : "/img/default_cover.jpg";
              return (
                <a href={getPostUrl(post)} class="top-group-item anzhiyu-card anzhiyu-card-hover">
                  <img src={cover} alt={post.data.title} class="top-group-img" loading="eager" />
                  <div class="top-group-mask">
                    <span class="top-group-title">{post.data.title}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .home-top-section {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 1.5rem 0;
  }

  .home-top-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .top-left-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .banners-box {
    flex: 1;
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 220px;
    background: linear-gradient(135deg, var(--anzhiyu-card-bg) 0%, var(--anzhiyu-secondbg) 100%);
  }

  .banners-title-big {
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--anzhiyu-fontcolor);
  }

  .banners-title-small {
    margin-top: 0.45rem;
    font-size: 0.88rem;
    letter-spacing: 0.04em;
    color: var(--anzhiyu-secondtext);
  }

  .banner-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .banner-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.48rem 1rem;
    border-radius: var(--anzhiyu-radius-full);
    background: var(--anzhiyu-main);
    color: var(--anzhiyu-white);
    font-size: 0.86rem;
    font-weight: 600;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .banner-cta.secondary {
    background: var(--anzhiyu-card-btn-bg);
    color: var(--anzhiyu-fontcolor);
  }

  .banner-cta:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }

  .category-group {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
  }

  .category-tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1rem;
    border-radius: var(--anzhiyu-radius-lg);
    color: var(--anzhiyu-white);
    font-weight: 700;
    font-size: 0.95rem;
    overflow: hidden;
    transition: transform 0.25s ease;
  }

  .category-tile:hover {
    transform: translateY(-3px);
  }

  .tile-icon {
    width: 1.5rem;
    height: 1.5rem;
    opacity: 0.85;
  }

  .top-group-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 0.65rem;
    height: 100%;
    min-height: 300px;
  }

  .top-group-item {
    position: relative;
    overflow: hidden;
    display: block;
    min-height: 140px;
  }

  .top-group-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--animation-in);
  }

  .top-group-item:hover .top-group-img {
    transform: scale(1.08);
  }

  .top-group-mask {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.72) 100%);
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
  }

  .top-group-title {
    color: #fff;
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .home-top-section {
      padding: 0.75rem 1rem 0;
    }

    .home-top-grid {
      grid-template-columns: 1fr;
    }

    .top-group-grid {
      grid-template-columns: repeat(2, 1fr);
      min-height: 220px;
    }
  }
</style>
