---
import AnIcon from "@/components/common/AnIcon.astro";
import TagsGroupAll from "./TagsGroupAll.astro";
import SwiperGroup from "./SwiperGroup.astro";
import { themeConfig } from "@/config";
import { getPostUrl, type PostEntry } from "@/utils/posts";

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
const featured = posts.filter((p) => p.data.top_group_index !== undefined);
const topGroupPosts = (featured.length > 0 ? featured : posts).slice(0, 6);
const swiperCandidates = posts.filter((p) => p.data.swiper_index !== undefined);
const swiperPosts = (swiperCandidates.length > 0 ? swiperCandidates : posts).slice(0, 4);
const banner = themeConfig.home.todayBanner;
const isExternal = banner.link.startsWith("http");
---

{
  themeConfig.home.homeTopEnable && (
    <div id="home_top" class:list={[{ "has-swiper": themeConfig.home.swiperEnable }]}>
      <div class="swiper_container_card" style="height: auto; width: 100%;">
        <div id="bannerGroup">
          <div id="random-banner">
            <div class="banners-title">
              <div class="banners-title-big">{themeConfig.home.homeTopTitle}</div>
              <div class="banners-title-big">{themeConfig.home.homeTopSubtitle}</div>
              <div class="banners-title-small">{themeConfig.home.siteText}</div>
            </div>
            <TagsGroupAll />
            <a id="random-hover" href="javascript:void(0);" data-random-post="true">
              <i class="anzhiyufont anzhiyu-icon-paper-plane" />
              <div class="bannerText">
                随便逛逛<i class="anzhiyufont anzhiyu-icon-arrow-right" />
              </div>
            </a>
          </div>

          <div class="categoryGroup">
            {themeConfig.home.categories.map((cat) => (
              <div class="categoryItem" style={cat.shadow ? `box-shadow: ${cat.shadow};` : undefined}>
                <a class:list={["categoryButton", cat.colorClass]} href={encodeURI(cat.link)}>
                  <span class="categoryButtonText">{cat.name}</span>
                  <AnIcon name={cat.icon} />
                </a>
              </div>
            ))}
          </div>
        </div>

        {themeConfig.home.swiperEnable ? (
          <SwiperGroup swiperPosts={swiperPosts} topPosts={topGroupPosts} />
        ) : (
          <div class="topGroup">
            {topGroupPosts.map((post) => {
              const url = getPostUrl(post);
              const cover = typeof post.data.cover === "string" ? post.data.cover : "/img/default_cover.jpg";
              return (
                <div class="recent-post-item">
                  <div class="post_cover left_radius">
                    <a href={url} title={post.data.title}>
                      <span class="recent-post-top-text">荐</span>
                      <img class="post_bg" src={cover} alt={post.data.title} loading="eager" />
                    </a>
                  </div>
                  <div class="recent-post-info">
                    <a class="article-title" href={url} title={post.data.title}>
                      {post.data.title}
                    </a>
                  </div>
                </div>
              );
            })}

            <a
              id="todayCard"
              class="todayCard"
              href={banner.link}
              style="z-index: 1;"
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
            >
              <div class="todayCard-info">
                <div class="todayCard-tips">{banner.tips}</div>
                <div class="todayCard-title">{banner.title}</div>
              </div>
              <img class="todayCard-cover" src={banner.image} alt={banner.title} loading="eager" />
              <div class="banner-button-group">
                <div class="banner-button" id="todayCard-more-btn">
                  <i class="anzhiyufont anzhiyu-icon-arrow-circle-right" />
                  <span class="banner-button-text">更多推荐</span>
                </div>
              </div>
            </a>
          </div>
        )}
      </div>
    </div>
  )
}
