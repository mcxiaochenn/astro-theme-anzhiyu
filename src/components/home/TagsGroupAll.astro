---
import { getSiteData } from "@/data/site-data";

interface CreativityItem {
  name: string;
  color: string;
  icon: string;
}

interface CreativityGroup {
  creativity_list?: CreativityItem[];
}

const data = getSiteData<CreativityGroup[]>("creativity") ?? [];
const rawList = data[0]?.creativity_list ?? [];
// 结对排布，原版双排斜向无限滚动（#skills-tags-group-all）
const pairs: [CreativityItem, CreativityItem][] = [];
for (let i = 0; i + 1 < rawList.length; i += 2) {
  pairs.push([rawList[i], rawList[i + 1]]);
}
const doubledPairs = [...pairs, ...pairs];
---

{
  doubledPairs.length > 0 && (
    <div id="skills-tags-group-all">
      <div class="tags-group-wrapper">
        {doubledPairs.map(([topItem, bottomItem]) => (
          <div class="tags-group-icon-pair">
            <div class="tags-group-icon" style={`background: ${topItem.color}`}>
              <img class="no-lightbox" title={topItem.name} src={topItem.icon} alt={topItem.name} loading="lazy" />
            </div>
            <div class="tags-group-icon" style={`background: ${bottomItem.color}`}>
              <img class="no-lightbox" title={bottomItem.name} src={bottomItem.icon} alt={bottomItem.name} loading="lazy" />
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}
