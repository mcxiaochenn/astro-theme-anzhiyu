---
/**
 * BbTimeList.astro — 上游 `layout/includes/bbTimeList.pug` 的逐节点移植（Batch A · A6）。
 *
 * 挂载点：BaseLayout 的 `main#blog-container` 里 HomeTop 之前（上游 layout.pug:21-22：
 * `if (is_home())` → include bbTimeList.pug，位于 top/top.pug（:23-24）之前）。
 * `is_home()` 门控由 BaseLayout 挂载点负责；本组件负责数据门控与逐组渲染。
 *
 * 门控语义（上游 bbTimeList.pug:1-3）：`site.data.essay` 存在、且其中有 **`home_essay`
 * 真值组** 才输出——FIXPLAN A6 验收「站点有 essay 数据时输出」是措辞简化，以代码为准。
 * 每个 home_essay 组各输出一份 `#bbTimeList` + 一份 swiper 脚本（:6-17，每组一份）。
 * src/data/essay.yml 无 `home_essay` 键 → 零输出（基线 diff 不变）。
 *
 * DOM 逐节点复刻（单组内）：
 *   #bbTimeList.bbTimeList.container
 *     i.anzhiyufont.anzhiyu-icon-jike.bber-logo.fontbold      ← onclick/href 双形态，
 *       title="即刻短文"，aria-hidden="true"（上游在 <i> 上挂 href，原样保留）
 *     #bbtalk.swiper-container.swiper-no-swiping.essay_bar_swiper_container[tabindex="-1"]
 *       #bber-talk.swiper-wrapper                             ← onclick 同上
 *         × 内层 each 遍历**全部组**（上游 bbTimeList.pug:10 内层 `each i in site.data.essay`
 *           遮蔽外层 i，不是只遍历当前组）：每组 essay_list 前 10 条（index<10）各一个
 *           a.li-style.swiper-slide(href=同上) = contentText
 *     a.bber-gotobb.anzhiyufont.anzhiyu-icon-circle-arrow-right ← onclick/href 同上，
 *       title="查看全文"
 *   script(src=url_for(theme.home_top.swiper.swiper_js))       ← :17，每个 home_essay 组一份
 *
 * contentText（:13）：`item.image ? content+' [图片]' : (item.video ? content+' [视频]' : content)`。
 * pjax 双形态（:4-5）：`pjax.enable` → `onclick="pjax.loadUrl(\"/essay/\");"` +
 * `href="javascript:void(0);"`；否则 → 无 onclick + `href="/essay/"`（上游 pug 空串 onclick
 * 会渲染 `onclick=""`，此处按 Batch A 任务卡约定省略属性，行为等价）。
 *
 * 数据 prop：`essay` = `site.data.essay` 等价物（examples 侧 `getSiteData('essay')`，
 * 见 src/pages/[...path].astro:166）。多组同出时 `#bbTimeList`/`#bbtalk`/
 * `#bber-talk` 会重复 id——上游 bbTimeList.pug 同样如此，原样保留。
 *
 * 消费链：utils.js:459/472（`initIndexEssay`，Swiper 竖向轮播，脚本由 :17 提供）、
 * main.js:215-217（scroll-down 箭头优先滚到 #bbTimeList）。
 */
import { getThemeConfig, readFlag } from '../../config/theme-context.ts'
import { createUrlFor, type SiteConfig } from '../../utils/url-utils.ts'

interface Props {
  /** 站点元数据（`url_for` 需要 root）。 */
  site: SiteConfig
  /** `site.data.essay` 等价物（宽松结构，见 components/page/types.ts 的 EssayGroup）。 */
  essay?: unknown
}

const { site, essay } = Astro.props

const theme = getThemeConfig()
const urlFor = createUrlFor(site.root ?? '/')

/** 上游 :4-5 的两种 onclick/href 形态。本地 pjax 由 ClientRouter + head/runtime.ts shim
 *  取代，`pjax.loadUrl` 契约保留（runtime.ts:166-173）。 */
const pjaxEnabled = readFlag(theme.pjax, 'enable')
// 子路径部署：/essay/ 前缀跟随 site.root（onclick 里的 JS 字符串同源）
const essayUrl = urlFor('/essay/')
const onclickValue = pjaxEnabled ? `pjax.loadUrl("${essayUrl}");` : undefined
const hrefValue = pjaxEnabled ? 'javascript:void(0);' : essayUrl

/** 上游 :17：`url_for(theme.home_top.swiper.swiper_js)`。 */
const swiperJsUrl = urlFor(theme.home_top.swiper.swiper_js)

/** 宽松读取 site.data.essay（YAML 顶层是组数组；非数组按上游 `each` 的假值分支处理）。 */
const groups: Record<string, unknown>[] = Array.isArray(essay)
  ? (essay as unknown[]).filter((g): g is Record<string, unknown> => !!g && typeof g === 'object')
  : []

/** 外层门控（:2-3）：每个 `home_essay` 真值组输出一份块。 */
const homeEssayGroups = groups.filter((g) => Boolean(g.home_essay))

/**
 * contentText（:13）的三种分支。后缀分支用 JS `+` 语义（undefined 拼出 "undefined [图片]"，
 * 与上游逐字一致）；无后缀分支按 pug `=` 的 null/undefined 输出空串。
 */
function contentTextOf(item: Record<string, unknown>): string {
  const raw = item.content
  if (item.image) return String(raw) + ' [图片]'
  if (item.video) return String(raw) + ' [视频]'
  return raw === null || raw === undefined ? '' : String(raw)
}

/** 内层（:10-14）：**全部组**的 essay_list 各取前 10 条（index<10）。 */
const slides = groups.flatMap((g) => {
  const list = Array.isArray(g.essay_list) ? (g.essay_list as unknown[]) : []
  return list
    .slice(0, 10)
    .filter((item): item is Record<string, unknown> => !!item && typeof item === 'object')
    .map((item) => contentTextOf(item))
})
---

{
  homeEssayGroups.map(() => (
    <>
      <div id="bbTimeList" class="bbTimeList container">
        <i
          class="anzhiyufont anzhiyu-icon-jike bber-logo fontbold"
          onclick={onclickValue}
          title="即刻短文"
          href={hrefValue}
          aria-hidden="true"
        ></i>
        <div id="bbtalk" class="swiper-container swiper-no-swiping essay_bar_swiper_container" tabindex="-1">
          <div id="bber-talk" class="swiper-wrapper" onclick={onclickValue}>
            {slides.map((text) => (
              <a class="li-style swiper-slide" href={hrefValue}>
                {text}
              </a>
            ))}
          </div>
        </div>
        <a
          class="bber-gotobb anzhiyufont anzhiyu-icon-circle-arrow-right"
          onclick={onclickValue}
          href={hrefValue}
          title="查看全文"
        ></a>
      </div>
      <script is:inline src={swiperJsUrl}></script>
    </>
  ))
}
