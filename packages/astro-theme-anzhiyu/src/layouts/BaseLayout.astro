---
/**
 * BaseLayout.astro — 上游 `layout/includes/layout.pug` 的 DOM 骨架（P2-2）。
 *
 * 复刻的是 layout.pug 的**挂载顺序与容器**，不是每个 include 的内容：
 *
 *   body[data-type=anzhiyu]
 *     #web_bg                         layout.pug:11   全局背景层（persist 对象，Phase 4 挂 transition:persist）
 *     #an_music_bg                    layout.pug:12
 *     #loading-box                    layout.pug:13-14（preloader，theme.preloader.enable）
 *     #body-wrap.page|.post           layout.pug:18（pageType = is_post() ? 'post' : 'page'）
 *       <Header />                    layout.pug:19   header/index.pug（P2-4：header#page-header + nav）
 *       main#blog-container           layout.pug:20
 *         #home_top                   layout.pug:23-24（is_current("/")，占位：P2-7）
 *         #content-inner.layout       layout.pug:43   页面内容 slot + widget 侧栏
 *           <slot />                  layout.pug:44-47（block content）
 *           #aside-content            layout.pug:48-49 占位：P3-1 填 widget 卡片
 *       <Footer />                    layout.pug:60   footer.pug（P2-4：footer#footer + footer-wrap + footer-bar）
 *     <Sidebar />                     layout.pug:78   sidebar.pug（P2-5）
 *     <Rightside />                   layout.pug:82   rightside.pug（P2-5）
 *     #nav-music                      layout.pug:84-85（music.pug 静态结构）
 *     #rightMenu / #rightmenu-mask    layout.pug:87（rightmenu 静态结构）
 *     div                             layout.pug:88（additional-js 的挂载点，脚本 P4-2 填）
 *     #popup-window                   layout.pug:91（popup 静态结构）
 *
 * 明确不做（留给后续阶段）：
 *   - 404 分支（`page.type === '404'` → 404.pug）→ P2-10
 *   - shortcutKey（默认关闭）→ P4-5
 *   - search（三套搜索默认关闭，include 本身输出为空）→ P4-8
 *   - ClientRouter / `transition:persist` / pjax shim → P4-3
 *   - pace 进度条（theme.preloader.source === 3 的第二段）→ P4-1（asset URL）
 *   - `#console` 中控台面板（nav.pug 的 include）→ P4-6
 *
 * 站点数据（P2-5 新增）：`sidebar` 的文章数 / 标签数 / 分类数 / 标签云，在上游来自
 * Hexo 的站点全局 `site.posts` / `site.tags` / `site.categories`。这里从内容集合
 * `posts` 现场算出来传给 Sidebar（唯一的数据源等价物）。
 *
 * 样式入口不在这里引入：上游 302KB Stylus 当前还在 `examples/blog/src/styles/upstream/`，
 * 由站点（`examples/blog/src/pages/index.astro`）统一 import 一次，主题包不复制样式。
 */
import { getCollection } from 'astro:content'
import Head from '../components/Head.astro'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import Sidebar from '../components/layout/Sidebar.astro'
import Rightside from '../components/layout/Rightside.astro'
import { getThemeConfig, readFlag, readNumber, readString } from './theme-context.ts'
import { resolveSite, type SiteConfig } from './site.ts'

interface Props {
  /** 站点级元数据；缺省用主题包的中性默认值。 */
  site?: Partial<SiteConfig>
  /** 页面标题（`page.title`）。 */
  title?: string
  /** 页面描述（`page.description`）。 */
  description?: string
  /** 页面正文（`page.content`）。 */
  content?: string
  /** 页面关键词覆盖（`page.keywords`）。 */
  keywords?: string | string[]
  /** 页面标签名（`page.tags[].name`）。 */
  tagNames?: string[]
  /** OG 图片覆盖（`page.cover`）。 */
  ogImage?: string
  /** OG 类型；缺省按 `isHome` 推导。 */
  ogType?: 'website' | 'article'
  /** 是否首页（对应上游 `is_home()`）。 */
  isHome?: boolean
  /** 当前 URL 是否根路径 `'/'`（对应上游 `is_current("/")`）。 */
  isCurrentRoot?: boolean
  /** `page.type` 是否 404；404 分支留给 P2-10。 */
  is404?: boolean
  /** `page.aside === false` 时隐藏侧栏（上游 layout.pug:3）。 */
  aside?: boolean
  /** 页面绝对 URL，透传给 Head。 */
  pageUrl?: string
  /** `#body-wrap` 的 pageType（上游 `is_post() ? 'post' : 'page'`）。 */
  pageType?: 'post' | 'page'
  /**
   * 页面顶部图（上游 `page.top_img` 链）：
   * string = 有图 / false = 显式关闭 / 缺省 = 按主题配置（`index_img`、`default_top_img`）回退。
   * 文章页应传 `page.top_img || page.cover || page.randomcover`（P2-8）。
   */
  topImg?: string | false
  /** 文章页 TOC 是否可用（上游 `showToc`，P2-8 按 `toc(page.content)` 算好后传入）。 */
  showToc?: boolean
  /** 评论系统是否加载（上游 `commentsJsLoad`，评论阶段传入）。 */
  commentsLoaded?: boolean
}

const {
  site: siteInput,
  title,
  description,
  content,
  keywords,
  tagNames,
  ogImage,
  ogType,
  isHome = false,
  isCurrentRoot = Astro.url.pathname === '/',
  is404 = false,
  aside,
  pageUrl,
  pageType: pageTypeProp,
  topImg,
  showToc = false,
  commentsLoaded = false,
} = Astro.props

const site = resolveSite(siteInput)
const theme = getThemeConfig()

/* ------------------------------------------------------------------ */
/* 1. html / body 级 class 与 data-*                                   */
/* ------------------------------------------------------------------ */

/** 上游 layout.pug:4：`pageType = is_post() ? 'post' : 'page'`（首页是 page）。 */
const pageType: 'post' | 'page' = pageTypeProp ?? 'page'

/** 上游 layout.pug:1：`theme.aside.enable && theme.aside.hide`。 */
const htmlClass = theme.aside.enable && theme.aside.hide ? 'hide-aside' : ''

/** 上游 layout.pug:3：`!theme.aside.enable || page.aside === false`。 */
const contentInnerClass = !theme.aside.enable || aside === false ? 'layout hide-aside' : 'layout'

/* ------------------------------------------------------------------ */
/* 2. 站点数据：sidebar 的 site.posts / site.tags / site.categories       */
/* ------------------------------------------------------------------ */

/**
 * 上游这三个是 Hexo 的站点全局变量（`site.posts.length` 等），不是主题配置。
 * Astro 侧唯一的等价数据源是内容集合：基准站与本站的集合名都是 `posts`
 * （见 `examples/blog/src/content.config.ts`），这里直接读它。
 *
 * 取舍：这是 P2-5 引入的一次「主题布局 → 站点内容集合」耦合。Phase 7 站点配置层
 * 落地后，应该改成由站点向布局注入 site 数据（或主题导出一个 data adapter），
 * 届时 Sidebar 的 props 不变、只换数据来源。详见
 * docs/notes/P2-4-5-header-footer-sidebar.md。
 *
 * 计数口径与 Hexo 对齐：
 *   - posts：`site.posts` = 所有文章，**不含** `layout: page` 的独立页面；
 *   - tags：`site.tags` = 去重后的标签种类数；
 *   - categories：`site.categories` = 分类节点数。Hexo 的嵌套分类（fixtures 里的
 *     `categories: [[前端, Astro], 工程实践]`）会给每一级都建节点，所以这里递归摊平后去重。
 */
const collectionEntries = await getCollection('posts')
const posts = collectionEntries.filter((entry) => entry.data.layout !== 'page')

const tagCounts = new Map<string, number>()
const categoryNames = new Set<string>()

/** 递归摊平 `categories: string | string[] | (string | string[])[]`。 */
function collectCategoryNames(value: unknown, out: Set<string>): void {
  if (typeof value === 'string') {
    if (value) out.add(value)
    return
  }
  if (Array.isArray(value)) {
    for (const item of value) collectCategoryNames(item, out)
  }
}

for (const post of posts) {
  const postTags = post.data.tags
  if (Array.isArray(postTags)) {
    for (const tag of postTags) {
      if (typeof tag !== 'string' || !tag) continue
      tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)
    }
  }
  collectCategoryNames(post.data.categories, categoryNames)
}

/** 上游 `site.tags` 的等价投影：cloudTags 需要的 `{ name, path, length }`。 */
const sidebarTags = [...tagCounts.entries()].map(([name, length]) => ({
  name,
  path: `tags/${encodeURIComponent(name)}/`,
  length,
}))

/* ------------------------------------------------------------------ */
/* 3. preloader（layout.pug:13-14 → loading/index.pug）                 */
/* ------------------------------------------------------------------ */

const preloaderEnabled = readFlag(theme.preloader, 'enable')
const loadingAvatar = readString(
  theme.preloader,
  'avatar',
  (theme.avatar as { img?: string } | undefined)?.img ?? '',
)
/** 上游 loading/fullpage-loading.pug:6-21 的脚本，逐 token 对齐（Phase 4 会换成 pjax 版）。 */
const preloaderScript = `const preloader = {
    endLoading: () => {
      document.getElementById('loading-box').classList.add("loaded");
    },
    initLoading: () => {
      document.getElementById('loading-box').classList.remove("loaded")
    }
  }
  window.addEventListener('load',()=> { preloader.endLoading() })
  setTimeout(function(){preloader.endLoading();},10000)

  if (${theme.pjax.enable}) {
    document.addEventListener('pjax:send', () => { preloader.initLoading() })
    document.addEventListener('pjax:complete', () => { preloader.endLoading() })
  }`

/* ------------------------------------------------------------------ */
/* 4. 首屏 theme bootstrap（html[data-theme] 的运行时契约）              */
/* ------------------------------------------------------------------ */

/**
 * 上游把 `--anzhiyu-*` 变量只定义在 `[data-theme="light"|"dark"]` 下，
 * 属性缺失时 `background: var(--anzhiyu-background)` 整条声明失效 → 首屏透明
 * （P1.5 实测，见 docs/notes/P1.5-vertical-slice.md §4.1）。
 *
 * 分两层保证：
 *   1. `<html data-theme={display_mode}>` 静态兜底（= 上游 pug 的行为，无 JS 也有值）；
 *   2. 本段同步脚本在首屏 paint 前按「用户上次选择 → 系统偏好 → 静态默认」修正。
 *
 * localStorage 的格式对齐上游 `saveToLocal`：`{"value":"dark","expiry":<ms>}`，
 * key = `theme`、TTL 2 天（source/js/main.js:856 `saveToLocal.set("theme", mode, 2)`）。
 * autoChangeMode：1 = 跟随系统（不支持 dark 时回退 18:00–06:00），2 = 只看时段。
 */
const displayMode = theme.display_mode === 'dark' ? 'dark' : 'light'
const darkmodeConfig = theme.darkmode
const autoChangeMode =
  darkmodeConfig.enable && (darkmodeConfig.autoChangeMode === 1 || darkmodeConfig.autoChangeMode === 2)
    ? darkmodeConfig.autoChangeMode
    : 0

const themeBootstrap = `(function () {
    var root = document.documentElement
    var fallback = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'
    var AUTO = ${autoChangeMode}
    var mode = fallback
    try {
      var raw = localStorage.getItem('theme')
      var saved = raw ? JSON.parse(raw) : null
      var alive = saved && (!saved.expiry || saved.expiry > Date.now())
      if (alive && (saved.value === 'dark' || saved.value === 'light')) {
        mode = saved.value
      } else if (AUTO) {
        var prefers = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)')
        var supportsPrefers = !!(prefers && typeof prefers.matches === 'boolean')
        if (AUTO === 1 && supportsPrefers) {
          mode = prefers.matches ? 'dark' : 'light'
        } else {
          var hour = new Date().getHours()
          mode = hour >= 18 || hour < 6 ? 'dark' : 'light'
        }
      }
    } catch (error) {
      mode = fallback
    }
    root.setAttribute('data-theme', mode)
  })()`

/* ------------------------------------------------------------------ */
/* 5. 其它 layout.pug 挂载点的开关                                      */
/* ------------------------------------------------------------------ */

const navMusicEnabled =
  readFlag(theme.nav_music, 'enable') || readFlag(theme.nav_music, 'console_widescreen_music')
const navMusicId = readNumber(theme.nav_music, 'id')
const navMusicServer = readString(theme.nav_music, 'server', 'netease')
const navMusicVolume = readNumber(theme.nav_music, 'volume', 0.7)
const navMusicPlaylistLink = readString(theme.nav_music, 'all_playlist')
const translateConfig = theme.translate
const rightMenuTranslateText = translateConfig.rightMenuMsgDefault
---

<!doctype html>
<html lang={site.language} data-theme={displayMode} class={htmlClass || undefined}>
  <head>
    <Head
      site={site}
      title={title}
      description={description}
      content={content}
      keywords={keywords}
      tagNames={tagNames}
      ogImage={ogImage}
      ogType={ogType}
      isHome={isHome}
      pageUrl={pageUrl}
    >
      {/* 首屏 theme bootstrap：必须在 paint 前执行；位置对应上游 GLOBAL_CONFIG（noscript 之前） */}
      <script slot="head-script" is:inline set:html={themeBootstrap}></script>
    </Head>
    <slot name="head-extra" />
  </head>

  <body data-type="anzhiyu">
    {/* layout.pug:11 — 全局背景层。Phase 4 改成 transition:persist="web_bg" */}
    <div id="web_bg"></div>
    {/* layout.pug:12 — 音乐播放器背景层 */}
    <div id="an_music_bg"></div>

    {
      preloaderEnabled && (
        <div
          id="loading-box"
          onclick='document.getElementById("loading-box").classList.add("loaded")'
        >
          <div class="loading-bg">
            <img class="loading-img nolazyload" alt="加载头像" src={loadingAvatar} />
            <div class="loading-image-dot"></div>
          </div>
        </div>
      )
    }
    {preloaderEnabled && <script is:inline set:html={preloaderScript}></script>}

    {
      is404 ? (
        <slot name="404" />
      ) : (
        <div id="body-wrap" class={pageType}>
          {/* layout.pug:19 — header/index.pug（P2-4）。文章页的 #post-info 由 P2-8 通过插槽注入 */}
          <Header site={site} isHome={isHome} pageType={pageType} topImg={topImg} siteTitle={title}>
            <slot name="post-info" slot="post-info" />
          </Header>

          {/* layout.pug:20 — 主内容区 */}
          <main id="blog-container">
            {/* layout.pug:23-24 — top/top.pug，仅首页根路径；内容 P2-7 */}
            {isHome && isCurrentRoot && (
              <div id="home_top">
                <div class="swiper_container_card" style="height:auto;width:100%"></div>
              </div>
            )}

            {/* layout.pug:43 — 双栏容器：#content-inner.layout */}
            <div id="content-inner" class={contentInnerClass}>
              <slot />

              {/* layout.pug:48-49 — widget/index.pug。P3-1 填充 aside 卡片。 */}
              {theme.aside.enable && aside !== false && (
                <div id="aside-content" class="aside-content"></div>
              )}
            </div>
          </main>

          {/* layout.pug:60 — footer.pug（P2-4） */}
          <Footer site={site} topImg={topImg} />
        </div>
      )
    }

    {/* layout.pug:78 — sidebar.pug（P2-5） */}
    <Sidebar
      site={site}
      postCount={posts.length}
      tagCount={tagCounts.size}
      categoryCount={categoryNames.size}
      tags={sidebarTags}
    />

    {/* layout.pug:82 — rightside.pug（P2-5） */}
    <Rightside
      site={site}
      pageType={pageType}
      aside={aside}
      showToc={showToc}
      commentsLoaded={commentsLoaded}
    />

    {/* layout.pug:84-85 — music.pug（静态结构，交互由 P4-7 接管） */}
    {
      navMusicEnabled && (
        <div id="nav-music">
          <a id="nav-music-hoverTips" onclick="anzhiyu.musicToggle()" accesskey="m">
            播放音乐
          </a>
          <div id="console-music-bg"></div>
          <meting-js
            id={String(navMusicId)}
            server={navMusicServer}
            type="playlist"
            mutex="true"
            preload="none"
            theme="var(--anzhiyu-main)"
            data-lrctype="0"
            order="random"
            volume={String(navMusicVolume)}
          ></meting-js>
        </div>
      )
    }

    {/* layout.pug:87 — anzhiyu/rightmenu.pug（静态结构，交互由 P4-5 接管） */}
    <div id="rightMenu">
      <div class="rightMenu-group rightMenu-small">
        <div class="rightMenu-item" id="menu-backward">
          <i class="anzhiyufont anzhiyu-icon-arrow-left"></i>
        </div>
        <div class="rightMenu-item" id="menu-forward">
          <i class="anzhiyufont anzhiyu-icon-arrow-right"></i>
        </div>
        <div class="rightMenu-item" id="menu-refresh">
          <i class="anzhiyufont anzhiyu-icon-arrow-rotate-right" style="font-size: 1rem;"></i>
        </div>
        <div class="rightMenu-item" id="menu-top">
          <i class="anzhiyufont anzhiyu-icon-arrow-up"></i>
        </div>
      </div>
      <div class="rightMenu-group rightMenu-line rightMenuPlugin">
        <div class="rightMenu-item" id="menu-copytext">
          <i class="anzhiyufont anzhiyu-icon-copy"></i>
          <span>复制选中文本</span>
        </div>
        <div class="rightMenu-item" id="menu-pastetext">
          <i class="anzhiyufont anzhiyu-icon-paste"></i>
          <span>粘贴文本</span>
        </div>
        <a class="rightMenu-item" id="menu-commenttext">
          <i class="anzhiyufont anzhiyu-icon-comment-medical"></i>
          <span>引用到评论</span>
        </a>
        <div class="rightMenu-item" id="menu-newwindow">
          <i class="anzhiyufont anzhiyu-icon-window-restore"></i>
          <span>新窗口打开</span>
        </div>
        <div class="rightMenu-item" id="menu-copylink">
          <i class="anzhiyufont anzhiyu-icon-link"></i>
          <span>复制链接地址</span>
        </div>
        <div class="rightMenu-item" id="menu-copyimg">
          <i class="anzhiyufont anzhiyu-icon-images"></i>
          <span>复制此图片</span>
        </div>
        <div class="rightMenu-item" id="menu-downloadimg">
          <i class="anzhiyufont anzhiyu-icon-download"></i>
          <span>下载此图片</span>
        </div>
        <div class="rightMenu-item" id="menu-newwindowimg">
          <i class="anzhiyufont anzhiyu-icon-window-restore"></i>
          <span>新窗口打开图片</span>
        </div>
        <div class="rightMenu-item" id="menu-search">
          <i class="anzhiyufont anzhiyu-icon-magnifying-glass"></i>
          <span>站内搜索</span>
        </div>
        <div class="rightMenu-item" id="menu-searchBaidu">
          <i class="anzhiyufont anzhiyu-icon-magnifying-glass"></i>
          <span>百度搜索</span>
        </div>
        <div class="rightMenu-item" id="menu-music-toggle">
          <i class="anzhiyufont anzhiyu-icon-play"></i>
          <span>播放音乐</span>
        </div>
        <div class="rightMenu-item" id="menu-music-back">
          <i class="anzhiyufont anzhiyu-icon-backward"></i>
          <span>切换到上一首</span>
        </div>
        <div class="rightMenu-item" id="menu-music-forward">
          <i class="anzhiyufont anzhiyu-icon-forward"></i>
          <span>切换到下一首</span>
        </div>
        <div
          class="rightMenu-item"
          id="menu-music-playlist"
          onclick={`window.open("${navMusicPlaylistLink}", "_blank");`}
          style="display: none;"
        >
          <i class="anzhiyufont anzhiyu-icon-radio"></i>
          <span>查看所有歌曲</span>
        </div>
        <div class="rightMenu-item" id="menu-music-copyMusicName">
          <i class="anzhiyufont anzhiyu-icon-copy"></i>
          <span>复制歌名</span>
        </div>
      </div>
      <div class="rightMenu-group rightMenu-line rightMenuOther">
        <a class="rightMenu-item menu-link" id="menu-randomPost">
          <i class="anzhiyufont anzhiyu-icon-shuffle"></i>
          <span>随便逛逛</span>
        </a>
        <a class="rightMenu-item menu-link" href="/categories/">
          <i class="anzhiyufont anzhiyu-icon-cube"></i>
          <span>博客分类</span>
        </a>
        <a class="rightMenu-item menu-link" href="/tags/">
          <i class="anzhiyufont anzhiyu-icon-tags"></i>
          <span>文章标签</span>
        </a>
      </div>
      <div class="rightMenu-group rightMenu-line rightMenuOther">
        <a class="rightMenu-item" href="javascript:void(0);" id="menu-copy">
          <i class="anzhiyufont anzhiyu-icon-copy"></i>
          <span>复制地址</span>
        </a>
        <a class="rightMenu-item" href="javascript:void(0);" id="menu-commentBarrage">
          <i class="anzhiyufont anzhiyu-icon-message"></i>
          <span class="menu-commentBarrage-text">关闭热评</span>
        </a>
        <a class="rightMenu-item" href="javascript:void(0);" id="menu-darkmode">
          <i class="anzhiyufont anzhiyu-icon-circle-half-stroke"></i>
          <span class="menu-darkmode-text">深色模式</span>
        </a>
        <a class="rightMenu-item" href="javascript:void(0);" id="menu-translate">
          <i class="anzhiyufont anzhiyu-icon-language"></i>
          <span>{rightMenuTranslateText}</span>
        </a>
      </div>
    </div>
    <div id="rightmenu-mask"></div>

    {/* layout.pug:88 — additional-js.pug 的挂载点；脚本本体 P4-2/P4-3 填 */}
    <div></div>

    {/* layout.pug:91 — popup/index.pug（静态结构） */}
    <div id="popup-window">
      <div class="popup-window-title">通知</div>
      <div class="popup-window-divider"></div>
      <div class="popup-window-content">
        <div class="popup-tip">你好呀</div>
        <div class="popup-link">
          <i class="anzhiyufont anzhiyu-icon-arrow-circle-right"></i>
        </div>
      </div>
    </div>
  </body>
</html>
