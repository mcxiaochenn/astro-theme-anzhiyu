---
/**
 * CardCategories.astro — 上游 `layout/includes/widget/card_categories.pug`（P3-1）。
 *
 * ```pug
 * if theme.aside.card_categories.enable
 *   if site.categories.length
 *     .card-widget.card-categories
 *       != aside_categories({ limit: limit === 0 ? 0 : limit || 8, expand })
 * ```
 *
 * 与 tags/archives 不同，这张卡自带 `.card-widget` 外壳（它不在页分支的
 * `.card-widget` 包装里，而是和作者卡同级的独立卡片）。
 */
import { getThemeConfig } from '../../layouts/theme-context.ts'
import { createUrlFor } from '../../layouts/site.ts'
import { asideCategories } from '../../utils/helpers.ts'
import { tp } from '../../i18n/index.ts'
import type { SiteCategoryItem } from '../../data/site-stats.ts'

interface Props {
  categories: SiteCategoryItem[]
  /** 站点语言（`config.language`），透传给 `t()` 文案；缺省走 i18n 的 default 字典。 */
  lang?: string
}

const { categories, lang } = Astro.props
const theme = getThemeConfig()
const urlFor = createUrlFor('/')

const config = theme.aside.card_categories
const limit = config.limit === 0 ? 0 : config.limit || 8

const html = asideCategories(
  { limit, expand: config.expand },
  {
    categories,
    categoryDir: 'categories',
    urlFor,
    t: (key: string) => tp(key, lang),
  },
)
---

{
  config.enable && categories.length > 0 && (
    <div class="card-widget card-categories" set:html={html} />
  )
}
