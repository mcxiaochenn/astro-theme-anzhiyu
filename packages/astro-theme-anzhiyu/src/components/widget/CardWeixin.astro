---
/**
 * CardWeixin.astro — 上游 `layout/includes/widget/card_weixin.pug`（P3-1）。
 *
 * ```pug
 * if theme.aside.card_weixin.enable
 *   .card-widget.anzhiyu-right-widget#card-wechat(onclick="window.open("/")")
 *     #flip-wrapper > #flip-content
 *       .face(style=`background: url(${faceImg}) center center / 100% no-repeat`)
 *       .back.face(style=`background: url(${backFaceImg}) center center / 100% no-repeat`)
 * ```
 *
 * `onclick`：上游 pug 里是 `window.open("/")`，嵌套双引号会让 pug 解析成 `null`
 * （baseline 产物即 `onclick="null"`）。这里按产物对齐，不修上游的笔误。
 */
import { getThemeConfig } from '../../config/theme-context.ts'

const theme = getThemeConfig()
const enabled = theme.aside.card_weixin.enable
const face = theme.aside.card_weixin.face ?? ''
const backFace = theme.aside.card_weixin.backFace ?? ''
---

{
  enabled && (
    <div class="card-widget anzhiyu-right-widget" id="card-wechat" onclick="null">
      <div id="flip-wrapper">
        <div id="flip-content">
          <div class="face" style={`background: url(${face}) center center / 100% no-repeat`} />
          <div
            class="back face"
            style={`background: url(${backFace}) center center / 100% no-repeat`}
          />
        </div>
      </div>
    </div>
  )
}
