---
/**
 * CardTags.astro — 上游 `layout/includes/widget/card_tags.pug`（P3-1）。
 *
 * ```pug
 * if theme.aside.card_tags.enable
 *   if site.tags.length
 *     .card-tags
 *       .item-headline
 *       if theme.aside.card_tags.color
 *         .card-tag-cloud!= cloudTags({ minfontsize: 1.05, maxfontsize: 1.05, unit: 'rem', color: true, … })
 *       else
 *         .card-tag-cloud!= cloudTags({ … color: false … })
 *     hr
 * ```
 *
 * 注意 `.item-headline` 是空节点（上游在这张卡里没有标题文字），
 * 「卡片外壳 `.card-widget`」由 `widget/index.pug` 的页分支统一提供。
 */
import { getThemeConfig, readFlag } from '../../config/theme-context.ts'
import { createUrlFor } from '../../utils/url-utils.ts'
import { cloudTags } from '../../utils/helpers.ts'
import type { SiteTagItem } from '../../data/site-stats.ts'

interface Props {
  tags: SiteTagItem[]
}

const { tags } = Astro.props
const theme = getThemeConfig()
const urlFor = createUrlFor('/')

const enabled = theme.aside.card_tags.enable
const tagLimit =
  theme.aside.card_tags.limit === 0 ? 0 : theme.aside.card_tags.limit || 40
const useColor = readFlag(theme.aside.card_tags, 'color')
const highlightTags = (theme.aside.card_tags.highlightTags ?? []) as string[]

const cloud = cloudTags(
  {
    // 上游 `source: site.tags`；`cloudTags` 内部再按名字排序。
    tags: tags.map((tag) => ({ name: tag.name, path: tag.path, length: tag.length })),
    minfontsize: 1.05,
    maxfontsize: 1.05,
    limit: tagLimit,
    unit: 'rem',
    color: useColor,
    highlightTags,
  },
  { urlFor },
)

// 上游 `if site.tags.length`：没有标签时整张卡（含 hr）都不输出。
const shouldRender = enabled && tags.length > 0
---

{
  shouldRender && (
    <>
      <div class="card-tags">
        <div class="item-headline" />
        <div class="card-tag-cloud" set:html={cloud} />
      </div>
      <hr />
    </>
  )
}
