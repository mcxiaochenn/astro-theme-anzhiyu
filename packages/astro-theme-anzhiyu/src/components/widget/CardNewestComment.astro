---
/**
 * CardNewestComment.astro — 上游 `layout/includes/widget/card_newest_comment.pug`（P3-1）。
 *
 * ```pug
 * if theme.newest_comments.enable
 *   .console-card#card-newest-comments
 *     .card-content
 *       .author-content-item-tips= _p('console.interaction')
 *       span.author-content-item-title != _p('aside.card_newest_comments.headline')
 *     .aside-list
 *       span= _p('aside.card_newest_comments.loading_text')
 * ```
 *
 * 这张卡属于「中控台」页面（console），不在 `widget/index.pug` 的 aside 里；
 * 结构先落地，评论数据由后续评论阶段填充。示例站 `newest_comments.enable: true`
 * 但目前没有 console 挂载点，因此不会进入任何页面产物。
 */
import { getThemeConfig } from '../../layouts/theme-context.ts'
import { tp } from '../../i18n/index.ts'

const theme = getThemeConfig()
const enabled = readEnabled(theme.newest_comments)

function readEnabled(section: unknown): boolean {
  if (!section || typeof section !== 'object') return false
  return (section as Record<string, unknown>).enable === true
}
---

{
  enabled && (
    <div class="console-card" id="card-newest-comments">
      <div class="card-content">
        <div class="author-content-item-tips">{tp('console.interaction')}</div>
        <span class="author-content-item-title">{tp('aside.card_newest_comments.headline')}</span>
      </div>
      <div class="aside-list">
        <span>{tp('aside.card_newest_comments.loading_text')}</span>
      </div>
    </div>
  )
}
