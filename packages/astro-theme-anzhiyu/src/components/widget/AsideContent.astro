---
/**
 * AsideContent.astro — 上游 `layout/includes/widget/index.pug`（P3-1）。
 *
 * 挂载点由 BaseLayout 提供：`theme.aside.enable && page.aside !== false` 时渲染
 * `#aside-content.aside-content`。本文件是该子树的唯一所有者。
 *
 * 上游三分支（`widget/index.pug:1-34`）：
 *  1. `is_post()` 且 `showToc && toc_style_simple`：只有 `.sticky_layout > #card-toc`；
 *  2. `is_post()` 常规：作者卡 / 公告 / 微信 / top_self + `.sticky_layout`
 *     （TOC? + 最近文章 + 广告）；
 *  3. 其它页面：作者卡 / 公告 / 微信 / top_self / 分类 + `.sticky_layout`
 *     （TOC? + `.card-widget`(广告 + 标签 + 归档 + 站点信息) + bottom_self）。
 *
 * 第 3 个分支里的 `.card-widget` 是**外层包装**，即使 4 张子卡全关也会输出；
 * 标签/归档的 `<hr>` 在包装内部，与 baseline 的 DOM 层级一致。
 *
 * 数据只算一次：`getSiteStats()` 内部用模块级 Promise 缓存。
 */
import { getThemeConfig } from '../../config/theme-context.ts'
import { postHrefOf, resolveSite, type SiteConfig } from '../../utils/url-utils.ts'
import { getSiteStats } from '../../data/site-stats.ts'
import type { TocHeading } from './toc.ts'
import type { WidgetDataItem } from '../../data/widget-data.ts'

import CardAuthor from './CardAuthor.astro'
import CardAnnouncement from './CardAnnouncement.astro'
import CardWeixin from './CardWeixin.astro'
import CardTopSelf from './CardTopSelf.astro'
import CardCategories from './CardCategories.astro'
import CardPostToc from './CardPostToc.astro'
import CardRecentPost from './CardRecentPost.astro'
import CardAd from './CardAd.astro'
import CardTags from './CardTags.astro'
import CardArchives from './CardArchives.astro'
import CardWebinfo from './CardWebinfo.astro'
import CardBottomSelf from './CardBottomSelf.astro'

interface Props {
  pageType: 'post' | 'page'
  showToc?: boolean
  /** 文章页抽出的标题列表（P2-8 通过 BaseLayout 传入）；非文章页为空。 */
  headings?: TocHeading[]
  /**
   * 站点级元数据（`config.description` / `config.author` …）。
   * 由 BaseLayout 透传；作者卡的描述回退链需要它：
   * `theme.aside.card_author.description || config.description`。
   */
  site?: Partial<SiteConfig>
}

const { pageType, showToc = false, headings = [], site: siteInput } = Astro.props
const theme = getThemeConfig()
const site = resolveSite(siteInput)
/** 站点语言（`config.language`）：tp() 文案按站点语言取字典，缺省走 default。 */
const lang = site.language
const stats = await getSiteStats({ resolvePostHref: postHrefOf(site) })

/** 上游 `showToc` 本身已经保证 `toc(page.content) !== ''`；这里再兜一层空数组。 */
const tocVisible = showToc && headings.length > 0
/** `page.toc_style_simple ?? theme.toc.style_simple`（页面级覆盖当前未接入）。 */
const tocStyleSimple = theme.toc.style_simple

/** `site.data.widget` 暂无 Astro 等价数据源，Phase 7 由站点注入。 */
const topWidgets: WidgetDataItem[] = []
const bottomWidgets: WidgetDataItem[] = []
---

<div id="aside-content" class="aside-content">
  {
    pageType === 'post' ? (
      tocVisible && tocStyleSimple ? (
        <div class="sticky_layout">
          <CardPostToc headings={headings} lang={lang} />
        </div>
      ) : (
        <>
          <CardAuthor site={site} />
          <CardAnnouncement lang={lang} />
          <CardWeixin />
          <CardTopSelf items={topWidgets} />
          <div class="sticky_layout">
            {tocVisible && <CardPostToc headings={headings} lang={lang} />}
            <CardRecentPost items={stats.recentPosts} lang={lang} />
            <CardAd />
          </div>
        </>
      )
    ) : (
      <>
        <CardAuthor site={site} />
        <CardAnnouncement lang={lang} />
        <CardWeixin />
        <CardTopSelf items={topWidgets} />
        <CardCategories categories={stats.categories} lang={lang} />
        <div class="sticky_layout">
          {tocVisible && <CardPostToc headings={headings} lang={lang} />}
          <div class="card-widget">
            <CardAd />
            <CardTags tags={stats.tags} />
            <CardArchives posts={stats.archivePosts} lang={lang} />
            <CardWebinfo
              postCount={stats.postCount}
              totalWordCount={stats.totalWordCount}
              lang={lang}
            />
          </div>
          <CardBottomSelf items={bottomWidgets} />
        </div>
      </>
    )
  }
</div>
