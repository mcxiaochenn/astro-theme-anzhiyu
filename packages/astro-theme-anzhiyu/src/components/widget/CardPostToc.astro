---
/**
 * CardPostToc.astro — 上游 `layout/includes/widget/card_post_toc.pug`（P3-1）。
 *
 * ```pug
 * - let tocNumber = page.toc_number ?? theme.toc.number
 * - let tocExpand = page.toc_expand ?? theme.toc.expand
 * #card-toc.card-widget
 *   .item-headline > i.anzhiyufont.anzhiyu-icon-bars + span + span.toc-percentage
 *   .toc-content(class=tocExpand ? 'is-expand' : '')!= toc(page.content, { list_number: tocNumber })
 * ```
 *
 * Astro 侧不重新解析正文：标题列表由 P2-8 抽好后经 BaseLayout 传入
 * （`TocHeading[]`，见 `./toc.ts`）。没有标题时整卡隐藏——上游此时
 * `showToc` 为 false，卡片同样不会进入 DOM。
 *
 * 加密文章分支（`page.encrypt`）当前站点没有对应数据，不移植。
 */
import { getThemeConfig } from '../../layouts/theme-context.ts'
import { tp } from '../../i18n/index.ts'
import { renderToc, type TocHeading } from './toc.ts'

interface Props {
  headings: TocHeading[]
}

const { headings } = Astro.props
const theme = getThemeConfig()

const tocNumber = theme.toc.number
const tocExpand = theme.toc.expand
const tocHtml = renderToc(headings, { listNumber: tocNumber })
---

{
  tocHtml && (
    <div id="card-toc" class="card-widget">
      <div class="item-headline">
        <i class="anzhiyufont anzhiyu-icon-bars" />
        <span>{tp('aside.card_toc')}</span>
        <span class="toc-percentage" />
      </div>
      <div class:list={['toc-content', tocExpand && 'is-expand']} set:html={tocHtml} />
    </div>
  )
}
