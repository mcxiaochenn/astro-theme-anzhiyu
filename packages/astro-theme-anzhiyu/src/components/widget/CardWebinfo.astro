---
/**
 * CardWebinfo.astro — 上游 `layout/includes/widget/card_webinfo.pug`（P3-1）。
 *
 * ```pug
 * if theme.aside.card_webinfo.enable
 *   .card-webinfo
 *     .item-headline > i.anzhiyufont.anzhiyu-icon-chart-line + span
 *     .webinfo
 *       if post_count          → .webinfo-item（文章总数）
 *       if runtimeshow.enable  → #runtimeshow[data-publishDate]（建站天数，JS 填充）
 *       if wordcount…           → 全站字数
 *       if busuanzi.site_uv/pv  → #busuanzi_value_site_uv / _pv（JS 填充）
 *       if last_push_date       → #last-push-date[data-lastPushDate]
 * ```
 *
 * 4 个计数类节点都由前端 JS 回填，服务端只输出 `<i ...spinner>` 占位，
 * 与 baseline 一致。
 */
import { getThemeConfig, readFlag, readString } from '../../layouts/theme-context.ts'
import { tp } from '../../i18n/index.ts'

interface Props {
  /** `site.posts.length`。 */
  postCount: number
  /** `totalcount(site)`。 */
  totalWordCount: number
}

const { postCount, totalWordCount } = Astro.props
const theme = getThemeConfig()
const config = theme.aside.card_webinfo
const showRuntime = readFlag(theme.runtimeshow, 'enable')

const publishDateText = readString(theme.runtimeshow, 'publish_date')
const publishDate = parsePublishDate(publishDateText)
const lastPushDate = new Date().toISOString()

const busuanzi = theme.busuanzi
const siteUv = readFlag(busuanzi, 'site_uv')
const sitePv = readFlag(busuanzi, 'site_pv')
const totalWordEnabled = theme.wordcount.enable && theme.wordcount.total_wordcount

/**
 * `date_xml(theme.runtimeshow.publish_date)`。
 *
 * 上游 pug 把配置里的 `4/1/2021 00:00:00` 直接交给 `date_xml`，最终是
 * `new Date(str).toISOString()`（宿主时区解释非 ISO 字面量）。这里保持一致，
 * 并给无效值兜底成当前时刻，避免 `toISOString()` 抛 RangeError。
 */
function parsePublishDate(value: string): string {
  if (!value) return new Date().toISOString()
  const parsed = new Date(value)
  return Number.isNaN(parsed.getTime()) ? new Date().toISOString() : parsed.toISOString()
}
---

{
  config.enable && (
    <div class="card-webinfo">
      <div class="item-headline">
        <i class="anzhiyufont anzhiyu-icon-chart-line" />
        <span>{tp('aside.card_webinfo.headline')}</span>
      </div>
      <div class="webinfo">
        {config.post_count && (
          <div class="webinfo-item">
            <div class="webinfo-item-title">
              <i class="anzhiyufont anzhiyu-icon-file-lines" />
              <div class="item-name">{tp('aside.card_webinfo.article_name')} :</div>
            </div>
            <div class="item-count">{postCount}</div>
          </div>
        )}
        {showRuntime && (
          <div class="webinfo-item">
            <div class="webinfo-item-title">
              <i class="anzhiyufont anzhiyu-icon-stopwatch" />
              <div class="item-name">{tp('aside.card_webinfo.runtime.name')} :</div>
            </div>
            <div class="item-count" id="runtimeshow" data-publishDate={publishDate}>
              <i class="anzhiyufont anzhiyu-icon-spinner anzhiyu-spin" />
            </div>
          </div>
        )}
        {totalWordEnabled && (
          <div class="webinfo-item">
            <div class="webinfo-item-title">
              <i class="anzhiyufont anzhiyu-icon-font" />
              <div class="item-name">{tp('aside.card_webinfo.site_wordcount')} :</div>
            </div>
            <div class="item-count">{totalWordCount}</div>
          </div>
        )}
        {siteUv && (
          <div class="webinfo-item">
            <div class="webinfo-item-title">
              <i class="anzhiyufont anzhiyu-icon-universal-access" />
              <div class="item-name">{tp('aside.card_webinfo.site_uv_name')} :</div>
            </div>
            <div class="item-count" id="busuanzi_value_site_uv">
              <i class="anzhiyufont anzhiyu-icon-spinner anzhiyu-spin" />
            </div>
          </div>
        )}
        {sitePv && (
          <div class="webinfo-item">
            <div class="webinfo-item-title">
              <i class="anzhiyufont anzhiyu-icon-square-poll-vertical" />
              <div class="item-name">{tp('aside.card_webinfo.site_pv_name')} :</div>
            </div>
            <div class="item-count" id="busuanzi_value_site_pv">
              <i class="anzhiyufont anzhiyu-icon-spinner anzhiyu-spin" />
            </div>
          </div>
        )}
        {config.last_push_date && (
          <div class="webinfo-item">
            <div class="webinfo-item-title">
              <i class="anzhiyufont anzhiyu-icon-hourglass-start" />
              <div class="item-name">{tp('aside.card_webinfo.last_push_date.name')} :</div>
            </div>
            <div class="item-count" id="last-push-date" data-lastPushDate={lastPushDate}>
              <i class="anzhiyufont anzhiyu-icon-spinner anzhiyu-spin" />
            </div>
          </div>
        )}
      </div>
    </div>
  )
}
