---
/**
 * CardAnnouncement.astro — 上游 `layout/includes/widget/card_announcement.pug`（P3-1）。
 *
 * ```pug
 * if theme.aside.card_announcement.enable
 *   .card-widget.card-announcement
 *     .item-headline
 *       i.anzhiyufont.anzhiyu-icon-bullhorn.anzhiyu-shake
 *       span= _p('aside.card_announcement')
 *     .announcement_content!= theme.aside.card_announcement.content
 * ```
 */
import { getThemeConfig } from '../../layouts/theme-context.ts'
import { tp } from '../../i18n/index.ts'

interface Props {
  /** 站点语言（`config.language`），用于 `_p()` 文案；缺省走 i18n 的 default 字典。 */
  lang?: string
}

const { lang } = Astro.props
const _p = (key: string) => tp(key, lang)

const theme = getThemeConfig()
const enabled = theme.aside.card_announcement.enable
const content = theme.aside.card_announcement.content ?? ''
---

{
  enabled && (
    <div class="card-widget card-announcement">
      <div class="item-headline">
        <i class="anzhiyufont anzhiyu-icon-bullhorn anzhiyu-shake" />
        <span>{_p('aside.card_announcement')}</span>
      </div>
      <div class="announcement_content" set:html={content} />
    </div>
  )
}
