---
/**
 * MusicPage.astro — 音乐页（`page.type === 'music'`，P3-2）。
 *
 * 上游 `layout/includes/page/music.pug:1-8`（整页只有静态骨架，歌单由
 * `#anMusic-page-meting` 在运行时拉取）：
 *
 *   #anMusic-page
 *     #anMusicBtnGetSong     i.anzhiyufont.anzhiyu-icon-shuffle          title="随机周董单曲，打开异世界的大梦"
 *     #anMusicRefreshBtn     i.anzhiyufont.anzhiyu-icon-arrows-rotate    title="立即刷新最新歌单"
 *     #anMusicSwitching      i.anzhiyufont.anzhiyu-icon-repeat           title="切换歌单"
 *     #anMusic-page-meting
 *
 * 交互由 Phase 4/5 的 main.js / meting 接管，这里只保证 DOM 一致。
 */
---

<div id="anMusic-page">
  <div id="anMusicBtnGetSong" title="随机周董单曲，打开异世界的大梦">
    <i class="anzhiyufont anzhiyu-icon-shuffle" />
  </div>
  <div id="anMusicRefreshBtn" title="立即刷新最新歌单">
    <i class="anzhiyufont anzhiyu-icon-arrows-rotate" />
  </div>
  <div id="anMusicSwitching" title="切换歌单">
    <i class="anzhiyufont anzhiyu-icon-repeat" />
  </div>
  <div id="anMusic-page-meting" />
</div>
