---
/**
 * AboutMaximBuff — 上游 `layout/includes/page/about.pug:157-174`。
 *
 * 注意 `.buff` 的内部**不是**常规的 `.card-content > …`：上游把
 * `- let {buff_tips…}` 写在 `.card-content` 之后，pug 让后面的 elements 变成
 * `.buff` 的直接子节点，于是基线里出现「空的 card-content + 同级 tips/title」。
 * 这里按基线 DOM 复刻，不「修正」上游的缩进。
 */
import type { AboutBuff, AboutMaxim } from './types.ts'

interface Props {
  maxim?: AboutMaxim
  buff?: AboutBuff
}

const { maxim, buff } = Astro.props
const smallStyle = 'opacity:.6;margin-bottom:8px'
---

<div class="author-content-item maxim">
  <div class="author-content-item-tips">{maxim?.maxim_tips}</div>
  <span class="maxim-title">
    <span style={smallStyle}>{maxim?.maxim_top}</span> <span>{maxim?.maxim_bottom}</span>
  </span>
</div>
<div class="author-content-item buff">
  <div class="card-content" />
  <div class="author-content-item-tips">{buff?.buff_tips}</div>
  <span class="buff-title">
    <span style={smallStyle}>{buff?.buff_top}</span> <span>{buff?.buff_bottom}</span>
  </span>
  <div class="card-background-icon">
    <i class="anzhiyufont anzhiyu-icon-dice-d20" />
  </div>
</div>
