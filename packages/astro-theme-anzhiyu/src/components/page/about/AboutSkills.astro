---
/**
 * AboutSkills — 上游 `layout/includes/page/about.pug:61-76`。
 *
 * `skills-style-group` 里先 include `anzhiyu/tags-group-all.pug`（复用
 * `components/home/TagsGroupAll.astro`），再在 `site.data.creativity` 存在时
 * 追加 `.skills-list`（`:67-76`）。基线站没有 `data/creativity.yml`，
 * 所以该卡片在验收里只剩 tips/title 与一个空的 `skills-style-group`。
 */
import TagsGroupAll from '../../home/TagsGroupAll.astro'
import type { AboutTextTips, CreativityGroup } from './types.ts'

interface Props {
  skillsTips?: AboutTextTips
  /** 上游 `site.data.creativity`；由 AboutPage 透传，缺省即无数据。 */
  creativity?: unknown
}

const { skillsTips, creativity } = Astro.props

/** 只保留 `creativity_list` 非空的分组（与 TagsGroupAll 的过滤一致）。 */
const groups: CreativityGroup[] = Array.isArray(creativity)
  ? (creativity as CreativityGroup[]).filter(
      (group) => group && Array.isArray(group.creativity_list) && group.creativity_list.length > 0,
    )
  : []
---

<div class="author-content-item skills">
  <div class="card-content">
    <div class="author-content-item-tips">{skillsTips?.tips}</div>
    <span class="author-content-item-title">{skillsTips?.title}</span>
    <div class="skills-style-group">
      <TagsGroupAll creativity={creativity} />
      {Boolean(creativity) && (
        <div class="skills-list">
          {groups.map((group) =>
            (group.creativity_list ?? []).map((item) => (
              <div class="skill-info">
                <div class="skill-icon" style={`background: ${item.color}`}>
                  <img class="no-lightbox" title={item.name} src={item.icon} alt={item.name} />
                </div>
                <div class="skill-name">
                  <span>{item.name}</span>
                </div>
              </div>
            )),
          )}
          <div class="etc">...</div>
        </div>
      )}
    </div>
  </div>
</div>
