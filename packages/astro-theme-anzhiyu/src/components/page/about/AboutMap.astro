---
/**
 * AboutMap — 上游 `layout/includes/page/about.pug:114-127`。
 *
 * 地图卡片的背景不写在 class 里，而是由模板内联一段 `<style>`（`:116-122`），
 * 用 `item.map.background` / `backgroundDark` 拼出亮/暗两套 `background-image`。
 * 这段样式在基线里位于 `.mapAndInfo` 分组内部、地图 div 之前，这里保持同样位置
 * （`is:inline` 阻止 Astro 把它抽到 <head>）。
 */
import type { AboutMap } from './types.ts'

interface Props {
  map?: AboutMap
}

const { map } = Astro.props
const background = map?.background ?? ''
const backgroundDark = map?.backgroundDark ?? ''

const mapCss = `.author-content-item.map {
  background-image: url(${background});
}
[data-theme='dark'] .author-content-item.map {
  background-image: url(${backgroundDark});
}`
---

<style is:inline set:html={mapCss}></style>
<div class="author-content-item map single">
  <span class="map-title">
    {map?.title}
    <b>{map?.StrengthenTitle}</b>
  </span>
</div>
