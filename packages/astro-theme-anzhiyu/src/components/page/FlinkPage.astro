---
/**
 * FlinkPage.astro — 友链页（`page.type === 'link'`，P3-2）。
 *
 * 上游 `layout/includes/page/flink.pug:1-133`。三层结构，全部在 `#article-container` 内：
 *
 *   1. `if theme.linkPageTop.enable`（:2-38）`#flink-banners`
 *      - `.banner-top-box` 标题 + 两个按钮（随机访问 / 申请友链，二者各自有配置门控）
 *      - `#skills-tags-group-all > .tags-group-wrapper`：头像两两成对，整段重复 2 遍做滚动
 *        （上游 `each y in [1,2]`，本身就是两份一样的 DOM）
 *   2. `if theme.friends_vue.enable`（:39-48）`.title-h2-a` + `#random-post` + 脚本
 *   3. `.flink`（:50-131）：`site.data.link` 的每个分组按 `flink_style` 三选一
 *      - `anzhiyu`   → `.anzhiyu-flink-list`（含 `lost_contact` 变体）
 *      - `telescopic`→ `.telescopic-site-card-group`
 *      - `flexcard`  → `.flexcard-flink-card`…（`.flexcard-flink-list`）
 *   末尾 `!= page.content`（:132）追加页面正文。
 *
 * 文案走上游 `_p('flink.*')`（languages/zh-CN.yml），这里固定 zh-CN。
 * 外链跳转 / fancybox / 脚本由 Phase 4/5 接管；本组件只输出静态 DOM 与配置门控。
 */
import { getThemeConfig, readFlag, readString } from '../../config/theme-context.ts'
import type { FlinkGroup, FlinkItem, PageContentSlot } from './types.ts'

interface Props extends PageContentSlot {
  /** 上游 `site.data.link`。 */
  data?: FlinkGroup[]
}

const { data = [], html, Content } = Astro.props
const theme = getThemeConfig()

/* -------------------------- 配置门控 -------------------------- */
const linkPageTop = theme.linkPageTop
const linkBannerEnabled = readFlag(linkPageTop, 'enable')
const linkBannerTitle = readString(linkPageTop, 'title')
const addFriendPlaceholder = readString(linkPageTop, 'addFriendPlaceholder')

const friendsVue = theme.friends_vue
const friendsVueEnabled = readFlag(friendsVue, 'enable')
const randomFriendsPostJs = readString(theme.asset, 'random_friends_post_js')

const commentsUse = readString(theme.comments, 'use')
const twikooEnvId = readString(theme.twikoo, 'envId')
const showAddFriend = Boolean(addFriendPlaceholder) && commentsUse === 'Twikoo' && Boolean(twikooEnvId)

const lazyloadEnabled = readFlag(theme.lazyload, 'enable')
const flinkErrorImg = readString(theme.error_img, 'flink')
const postPageErrorImg = readString(theme.error_img, 'post_page')
const defaultImg = readString(theme, 'default_img')

/** 上游 `_p('flink.*')`（zh-CN）。 */
const t = {
  title: '友情链接',
  friendLinks: '友链',
  latestArticles: '最新文章订阅',
  aboutMe: '关于本人',
  fishing: '🎣 钓鱼',
  allLinks: '全部友链',
  randomVisit: '随机访问',
  applyLink: '申请友链',
  recommend: '荐',
}

/** 上游 `url_for()`：站根为 `/` 时原样返回。 */
const urlFor = (value: string): string => value

/** 上游 `getAvatarWithoutExclamationMark()`：截断第一个 `!` 之后的部分。 */
const avatarWithoutExclamation = (url: string): string => {
  const index = url.indexOf('!')
  return index !== -1 ? url.substring(0, index) : url
}

/* --------------------- 头像墙（两两成对） --------------------- */

interface AvatarPair {
  even: FlinkItem
  odd: FlinkItem
  hundredSuffix: string
}

/**
 * 上游 `each y in [1,2]` → 每组重复两遍；`evenNum` / `oddNum` 是偶数位/奇数位，
 * 再按 `index2 * 2 <= 15` 截断。这里把结果展平成一个数组，渲染时两份都一样。
 */
const avatarPairRows: AvatarPair[][] = [1, 2].map(() =>
  data.slice(0, 15).flatMap((group) => {
    const linkList = (group.link_list ?? []).slice()
    const hundredSuffix = group.hundredSuffix ? group.hundredSuffix : ''
    const evenNum = linkList.filter((_, index) => index % 2 === 0)
    const oddNum = linkList.filter((_, index) => index % 2 === 1)
    const pairs: AvatarPair[] = []
    linkList.slice(0, Math.min(evenNum.length, oddNum.length)).forEach((_, index2) => {
      const index = index2 * 2
      if (index <= 15 && evenNum[index] && oddNum[index]) {
        pairs.push({ even: evenNum[index], odd: oddNum[index], hundredSuffix })
      }
    })
    return pairs
  }),
)

/** 上游 `item.link` / `item.name` 的图片兜底 src。 */
const pairSrc = (item: FlinkItem, hundredSuffix: string): string =>
  urlFor(avatarWithoutExclamation(item.avatar ?? '') + hundredSuffix)

/* ---------------------------- 友链分组 ---------------------------- */

/** anzhiyu / telescopic 共用的标签徽章。 */
type TagBadge =
  | { kind: 'vip' | 'speed'; text: string }
  | { kind: 'color'; text: string; style: string }
  | { kind: 'recommend'; text: string }

const tagBadge = (item: FlinkItem): TagBadge | null => {
  const color = item.color || ''
  const tag = item.tag || ''
  if (color === 'vip' && tag) {
    return { kind: 'vip', text: tag }
  }
  if (color === 'speed' && tag) {
    return { kind: 'speed', text: tag }
  }
  if (tag) {
    return { kind: 'color', text: tag, style: `background-color: ${color}` }
  }
  if (item.recommend) {
    return { kind: 'recommend', text: t.recommend }
  }
  return null
}

/** telescopic 的站点截图地址。 */
const siteshotOf = (item: FlinkItem): string =>
  item.siteshot
    ? urlFor(item.siteshot)
    : `https://image.thum.io/get/width/400/crop/800/allowJPG/wait/20/noanimate/${item.link}` || defaultImg
---

<div id="article-container">
  {
    linkBannerEnabled && (
      <div id="flink-banners">
        <div class="banner-top-box">
          <div class="flink-banners-title">
            <div class="banners-title-small">{t.title}</div>
            <div class="banners-title-big">{linkBannerTitle || t.title}</div>
          </div>
          <div class="banner-button-group">
            {readString(friendsVue, 'apiurl') && (
              <a
                class="banner-button secondary no-text-decoration"
                onclick="friendChainRandomTransmission()"
              >
                <i class="anzhiyufont anzhiyu-icon-paper-plane1" />
                <span class="banner-button-text">{t.randomVisit}</span>
              </a>
            )}
            {showAddFriend && (
              <a class="banner-button no-text-decoration" onclick="anzhiyu.addFriendLink()">
                <i class="anzhiyufont anzhiyu-icon-arrow-circle-right" />
                <span class="banner-button-text">{t.applyLink}</span>
              </a>
            )}
          </div>
        </div>
        <div id="skills-tags-group-all">
          <div class="tags-group-wrapper">
            {avatarPairRows.map((row) =>
              row.map((pair) => (
                <div class="tags-group-icon-pair">
                  <a
                    class="tags-group-icon no-text-decoration"
                    href={urlFor(pair.even.link ?? '')}
                    title={pair.even.name}
                  >
                    <img
                      class="no-lightbox"
                      title={pair.even.name}
                      src={pairSrc(pair.even, pair.hundredSuffix)}
                      onerror={`this.onerror=null;this.src='${urlFor(flinkErrorImg)}'`}
                      alt={pair.even.name}
                    />
                  </a>
                  <a
                    class="tags-group-icon no-text-decoration"
                    href={urlFor(pair.odd.link ?? '')}
                    title={pair.odd.name}
                  >
                    <img
                      class="no-lightbox"
                      title={pair.odd.name}
                      src={pairSrc(pair.odd, pair.hundredSuffix)}
                      onerror={`this.onerror=null;this.src='${urlFor(flinkErrorImg)}'`}
                      alt={pair.odd.name}
                    />
                  </a>
                </div>
              )),
            )}
          </div>
        </div>
      </div>
    )
  }

  {
    friendsVueEnabled && (
      <>
        <div class="title-h2-a">
          <div class="title-h2-a-left">
            <h2 style="padding-top:0;margin:.6rem 0 .6rem">{t.fishing}</h2>
            <a class="random-post-start no-text-decoration" href="javascript:fetchRandomPost();">
              <i class="anzhiyufont anzhiyu-icon-arrow-rotate-right" />
            </a>
          </div>
          <div class="title-h2-a-right">
            <a class="random-post-all no-text-decoration" href="/link/">
              {t.allLinks}
            </a>
          </div>
        </div>
        <div id="random-post" />
        <script is:inline defer data-pjax src={randomFriendsPostJs} />
      </>
    )
  }

  <div class="flink">
    {data.map((group) => {
      const tagList = group.link_list ?? []
      const groupClass = group.lost_contact
        ? 'anzhiyu-flink-list cf-friends-lost-contact'
        : 'anzhiyu-flink-list'
      return (
        <>
          {group.class_name && <h2>{`${group.class_name}(${tagList.length})`}</h2>}
          {group.class_desc && <div class="flink-desc" set:html={group.class_desc} />}
          {group.flink_style === 'anzhiyu' ? (
            <div class={groupClass}>
              {tagList.map((item) => {
                const badge = tagBadge(item)
                return (
                  <div class="flink-list-item">
                    {badge?.kind === 'vip' ? (
                      <span class="site-card-tag vip">
                        {badge.text}
                        <i class="light" />
                      </span>
                    ) : badge?.kind === 'speed' ? (
                      <span class="site-card-tag speed">{badge.text}</span>
                    ) : badge?.kind === 'color' ? (
                      <span class="site-card-tag" style={badge.style}>
                        {badge.text}
                      </span>
                    ) : badge?.kind === 'recommend' ? (
                      <span class="site-card-tag">{badge.text}</span>
                    ) : null}
                    {group.lost_contact ? (
                      <a
                        class="cf-friends-link"
                        href={urlFor(item.link ?? '')}
                        title={item.name}
                        target="_blank"
                      >
                        {lazyloadEnabled ? (
                          <img
                            class="no-lightbox"
                            data-lazy-src={urlFor(item.avatar ?? '')}
                            onerror={`this.onerror=null;this.src='${urlFor(flinkErrorImg)}'`}
                            alt={item.name}
                          />
                        ) : (
                          <img
                            class="cf-friends-avatar no-lightbox"
                            src={urlFor(item.avatar ?? '')}
                            onerror={`this.onerror=null;this.src='${urlFor(flinkErrorImg)}'`}
                            alt={item.name}
                          />
                        )}
                        <div class="flink-item-info">
                          <div class="flink-item-name cf-friends-name-lost-contact">{item.name}</div>
                        </div>
                      </a>
                    ) : (
                      <a
                        class="cf-friends-link"
                        href={urlFor(item.link ?? '')}
                        cf-href={urlFor(item.link ?? '')}
                        title={item.name}
                        target="_blank"
                      >
                        {lazyloadEnabled ? (
                          <img
                            class="cf-friends-avatar no-lightbox"
                            data-lazy-src={urlFor(item.avatar ?? '')}
                            cf-src={urlFor(item.avatar ?? '')}
                            onerror={`this.onerror=null;this.src='${urlFor(flinkErrorImg)}'`}
                            alt={item.name}
                          />
                        ) : (
                          <img
                            class="cf-friends-avatar no-lightbox"
                            src={urlFor(item.avatar ?? '')}
                            cf-src={urlFor(item.avatar ?? '')}
                            onerror={`this.onerror=null;this.src='${urlFor(flinkErrorImg)}'`}
                            alt={item.name}
                          />
                        )}
                        <div class="flink-item-info">
                          <div class="flink-item-name cf-friends-name">{item.name}</div>
                          <div class="flink-item-desc" title={item.descr}>
                            {item.descr}
                          </div>
                        </div>
                      </a>
                    )}
                  </div>
                )
              })}
            </div>
          ) : group.flink_style === 'telescopic' ? (
            <div class="telescopic-site-card-group">
              {tagList.map((item) => {
                const badge = tagBadge(item)
                const siteshot = siteshotOf(item)
                return (
                  <div class="site-card">
                    {badge?.kind === 'vip' ? (
                      <span class="site-card-tag vip">
                        {badge.text}
                        <i class="light" />
                      </span>
                    ) : badge?.kind === 'speed' ? (
                      <span class="site-card-tag speed">{badge.text}</span>
                    ) : badge?.kind === 'color' ? (
                      <span class="site-card-tag" style={badge.style}>
                        {badge.text}
                      </span>
                    ) : badge?.kind === 'recommend' ? (
                      <span class="site-card-tag">{badge.text}</span>
                    ) : null}
                    <a
                      class="img no-text-decoration"
                      target="_blank"
                      title={`${item.name}`}
                      href={`${item.link}`}
                      rel="external nofollow"
                    >
                      <img
                        class="flink-avatar"
                        data-lazy-src={siteshot}
                        onerror={`this.onerror=null;this.src='${defaultImg}'`}
                        alt={item.name}
                        style="pointer-events: none;"
                        src={`${siteshot}`}
                      />
                    </a>
                    <a
                      class="info cf-friends-link no-text-decoration"
                      target="_blank"
                      title={`${item.name}`}
                      href={`${item.link}`}
                      cf-href={urlFor(item.link ?? '')}
                      rel="external nofollow"
                    >
                      <div class="site-card-avatar">
                        <img
                          class="flink-avatar cf-friends-avatar no-fancybox"
                          data-lazy-src={item.avatar}
                          cf-src={urlFor(item.avatar ?? '')}
                          onerror={`this.onerror=null;this.src='${defaultImg}'`}
                          alt={item.name}
                          src={item.avatar}
                        />
                      </div>
                      <div class="site-card-text">
                        <span class="title cf-friends-name">{item.name}</span>
                        <span class="desc" title={`${item.descr}`}>
                          {item.descr}
                        </span>
                      </div>
                    </a>
                  </div>
                )
              })}
            </div>
          ) : group.flink_style === 'flexcard' ? (
            <div class="flexcard-flink-list">
              {tagList.map((item) => {
                const siteshot = group.link_list
                  ? item.siteshot
                    ? urlFor(item.siteshot)
                    : `https://image.thum.io/get/width/400/crop/800/allowJPG/wait/20/noanimate/${item.link}`
                  : ''
                return (
                  <a
                    class="flink-list-card cf-friends-link"
                    href={urlFor(item.link ?? '')}
                    cf-href={urlFor(item.link ?? '')}
                    target="_blank"
                    data-title={item.descr}
                  >
                    <div class="wrapper cover">
                      {lazyloadEnabled ? (
                        <img
                          class="cover fadeIn"
                          data-lazy-src={siteshot}
                          onerror={`this.onerror=null;this.src='${urlFor(postPageErrorImg)}'`}
                          alt="cover"
                        />
                      ) : (
                        <img
                          class="cover fadeIn"
                          src={siteshot}
                          onerror={`this.onerror=null;this.src='${urlFor(postPageErrorImg)}'`}
                          alt="cover"
                        />
                      )}
                    </div>
                    <div class="info">
                      {lazyloadEnabled ? (
                        <img
                          class="cf-friends-avatar no-lightbox flink-avatar"
                          data-lazy-src={urlFor(item.avatar ?? '')}
                          cf-src={urlFor(item.avatar ?? '')}
                          onerror={`this.onerror=null;this.src='${urlFor(flinkErrorImg)}'`}
                          alt="cover"
                        />
                      ) : (
                        <img
                          class="cf-friends-avatar no-lightbox"
                          src={urlFor(item.avatar ?? '')}
                          cf-src={urlFor(item.avatar ?? '')}
                          onerror={`this.onerror=null;this.src='${urlFor(flinkErrorImg)}'`}
                          alt="cover"
                        />
                      )}
                      <span class="flink-sitename cf-friends-name">{item.name}</span>
                    </div>
                  </a>
                )
              })}
            </div>
          ) : null}
        </>
      )
    })}
  </div>

  {html ? <Fragment set:html={html} /> : Content ? <Content /> : null}
</div>
