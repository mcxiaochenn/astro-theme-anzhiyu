---
/**
 * LazyImage.astro — 上游 lazyload 插件产物的静态形态（P2-9 / P2-10）。
 *
 * 上游模板里写的是普通 `<img src=cover>`，但 `hexo-lazyload` 会在渲染后把图片改写成
 * 「占位 src + data-lazy-src + onerror 兜底」三段式（`.baseline-html` 里的最终形态）：
 *
 *   <img src="data:image/gif;base64,R0lGOD…" onerror="this.onerror=null,this.src=&quot;/img/404.jpg&quot;"
 *        data-lazy-src="/img/cover.jpg" alt="…">
 *
 * Phase 2 的验收对象是**上游最终 HTML**，所以这里直接产出该形态；占位图/兜底图的取值
 * 来自主题配置（`theme.error_img.post_page`）。真正的懒加载行为是 P4 交互层的事，
 * 那一步只需要接管 `data-lazy-src`，不必再改这段静态结构。
 *
 * 注意属性值里的双引号：上游 `onerror` 的值是 `this.onerror=null,this.src="/img/404.jpg"`
 * （lazyload 注入的第一份），Astro 会转义成 `&quot;`，与上游字节级一致。
 */
import { getThemeConfig, readString } from '../../layouts/theme-context.ts'

interface Props {
  /** `data-lazy-src`，即真实图片地址（上游 `url_for(cover)`）。 */
  src: string
  /** `alt`（上游一律用文章标题）。 */
  alt: string
}

const { src, alt } = Astro.props
const theme = getThemeConfig()
const placeholder =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
const errorImage = readString(theme.error_img, 'post_page', '/img/404.jpg')
---

<img
  src={placeholder}
  onerror={`this.onerror=null,this.src="${errorImage}"`}
  data-lazy-src={src}
  alt={alt}
/>
