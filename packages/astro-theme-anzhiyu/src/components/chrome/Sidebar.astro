---
/**
 * Sidebar.astro — 上游 `layout/includes/sidebar.pug`（P2-5）。
 *
 * 复刻结构（`#sidebar > #menu-mask + #sidebar-menus`，移动端抽屉）：
 *   .sidebar-site-data.site-data.is-center（sidebar.site_data：文章/标签/分类三个计数入口）
 *   span.sidebar-menu-item-title「功能」+ .sidebar-menu-item（sidebar.display_mode）
 *     └ a.darkmode_switchbutton.menu-child
 *   .back-menu-list-groups（sidebar.nav_menu_project：分组来自 theme.nav.menu）
 *   .menus_items（sidebar.menus_items：即 MenuItems.astro，数据源 theme.menu）
 *   span.sidebar-menu-item-title「标签」+ .card-tags > .item-headline + .card-tag-cloud
 *     + hr（sidebar.tags_cloud：cloudTags helper，配置读 aside.card_tags）
 *
 * 数据来源（都是 Hexo 的站点全局变量，不是主题配置）：
 *   site.posts.length / site.tags.length / site.categories.length  ← BaseLayout 从
 *   `posts` 内容集合算好后以 props 传入（见 BaseLayout.astro 的「站点数据」段）。
 *   `site.tags` 的每一项 `{ name, path, length }` 由 cloudTags 渲染成标签云 HTML。
 *
 * 目录名（config.archive_dir / tag_dir / category_dir）在 Hexo 里是**站点配置**，
 * 当前仓库还没有站点配置层（Phase 7 才有），基准站是默认值，先按常量落在这里。
 * Phase 7 接站点配置后改成 props 即可，DOM 不变。
 *
 * `nav.menu` 里的外站链接（`https://…`）按 Hexo 站点级 `external_link` 补
 * `target="_blank" rel="noopener"`，见 `utils/external-link.ts`。
 */
import { getThemeConfig, readFlag } from '../../config/theme-context.ts'
import { createUrlFor, type SiteConfig } from '../../utils/url-utils.ts'
import { tp } from '../../i18n/index.ts'
import { externalLinkAttrs } from '../../utils/external-link.ts'
import { cloudTags, type CloudTagLike } from '../../utils/helpers.ts'
import MenuItems from './MenuItems.astro'
import { lazyImageAttrs } from './lazyload.ts'

interface Props {
  site: SiteConfig
  /** `site.posts.length`：文章数（不含 `layout: page` 的独立页面）。 */
  postCount?: number
  /** `site.tags.length`：标签种类数。 */
  tagCount?: number
  /** `site.categories.length`：分类节点数（嵌套分类的每一级各算一个）。 */
  categoryCount?: number
  /** `site.tags` 投影：cloudTags 的输入。 */
  tags?: ReadonlyArray<CloudTagLike>
}

const { site, postCount = 0, tagCount = 0, categoryCount = 0, tags = [] } = Astro.props

const theme = getThemeConfig()
const urlFor = createUrlFor(site.root ?? '/')
const lang = site.language
const _p = (key: string) => tp(key, lang)

/** `url_for()` 得到最终 href；外链按站点级 external_link 补 target/rel，一并返回展开。 */
const linkAttrs = (path: string) => {
  const href = urlFor(path)
  return { href, ...externalLinkAttrs(href, site.url) }
}

const sidebar = theme.sidebar
const nav = theme.nav

/** Hexo 站点配置的目录名（Phase 7 站点配置层的等价物，当前取基准站默认值）。 */
const archiveDir = 'archives'
const tagDir = 'tags'
const categoryDir = 'categories'

/* 标签云：上游 sidebar.pug:44-48 的 cloudTags 调用 */
const cardTags = theme.aside.card_tags
const tagLimit = cardTags.limit === 0 ? 0 : cardTags.limit || 40
const tagCloudHtml = cloudTags(
  {
    tags,
    minfontsize: 0.875,
    maxfontsize: 0.875,
    limit: tagLimit,
    unit: 'rem',
    color: cardTags.color,
    highlightTags: cardTags.highlightTags ?? [],
  },
  { urlFor },
)
---

<div id="sidebar">
  <div id="menu-mask"></div>
  <div id="sidebar-menus">
    {
      sidebar.site_data && (
        <div class="sidebar-site-data site-data is-center">
          {readFlag(sidebar.site_data, 'archive') && (
            <a href={urlFor(`${archiveDir}/`)} title="archive">
              <div class="headline">{_p('aside.articles')}</div>
              <div class="length-num">{postCount}</div>
            </a>
          )}
          {readFlag(sidebar.site_data, 'tag') && (
            <a href={urlFor(`${tagDir}/`)} title="tag">
              <div class="headline">{_p('aside.tags')}</div>
              <div class="length-num">{tagCount}</div>
            </a>
          )}
          {readFlag(sidebar.site_data, 'category') && (
            <a href={urlFor(`${categoryDir}/`)} title="category">
              <div class="headline">{_p('aside.categories')}</div>
              <div class="length-num">{categoryCount}</div>
            </a>
          )}
        </div>
      )
    }

    {
      sidebar.display_mode && (
        <>
          <span class="sidebar-menu-item-title">{_p('aside.function')}</span>
          <div class="sidebar-menu-item">
            <a
              class="darkmode_switchbutton menu-child"
              href="javascript:void(0);"
              title={_p('aside.display_mode')}
            >
              <i class="anzhiyufont anzhiyu-icon-circle-half-stroke" />
              <span>{_p('aside.display_mode')}</span>
            </a>
          </div>
        </>
      )
    }

    {
      sidebar.nav_menu_project && (
        <div class="back-menu-list-groups">
          {nav.menu.map((group) => (
            <div class="back-menu-list-group">
              <div class="back-menu-list-title">{group.title}</div>
              <div class="back-menu-list">
                {group.item.map((item) => (
                  <a class="back-menu-item" {...linkAttrs(item.link)} title={item.name}>
                    <img
                      class="back-menu-item-icon"
                      alt={item.name}
                      {...lazyImageAttrs(item.icon, { theme, urlFor })}
                    />
                    <span class="back-menu-item-text">{item.name}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      )
    }

    {sidebar.menus_items && <MenuItems site={site} />}

    {
      sidebar.tags_cloud && (
        <>
          <span class="sidebar-menu-item-title">标签</span>
          {cardTags.enable && tags.length > 0 && (
            <>
              <div class="card-tags">
                <div class="item-headline"></div>
                <div class="card-tag-cloud" set:html={tagCloudHtml}></div>
              </div>
              <hr />
            </>
          )}
        </>
      )
    }
  </div>
</div>
