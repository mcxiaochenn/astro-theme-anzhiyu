---
/**
 * valine.astro — 上游 `layout/includes/third-party/newest-comments/valine.pug:1-99`（P5-1）。
 *
 * 门控：newest_comments.enable + aside.enable + use 含 Valine；
 * 输出 blueimp-md5 外链脚本 + 初始化脚本，读 `theme.valine.appId/appKey/serverURLs/avatar`。
 */
import { getThemeConfig } from '../../../layouts/theme-context.ts'
import { renderNewestCommentsValine } from './render.mjs'

interface Props {
  page?: Record<string, unknown>
  [key: string]: unknown
}

const theme = getThemeConfig()
const html = renderNewestCommentsValine(theme, Astro.props)
---

<Fragment set:html={html} />
