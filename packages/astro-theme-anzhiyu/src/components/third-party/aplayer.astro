---
/**
 * aplayer.astro — 上游 `layout/includes/third-party/aplayer.pug:1-3`（P5-1）。
 *
 * 门控：`theme.aplayerInject.enable` 且 (`theme.pjax.enable` || `per_page` || `page.aplayer`)，
 * 与 additional-js.pug:117-121 一致。输出 aplayer CSS / aplayer_js / meting_js。
 * 注意：AdditionalJs.astro:155-161 已有等价实现，接线时二选一。
 */
import { getThemeConfig } from '../../layouts/theme-context.ts'
import { renderAplayer } from './render.mjs'

interface Props {
  page?: Record<string, unknown>
  /** 上游 page.aplayer */
  aplayer?: boolean
  [key: string]: unknown
}

const theme = getThemeConfig()
const html = renderAplayer(theme, Astro.props)
---

<Fragment set:html={html} />
