---
/**
 * index.astro — 上游 `layout/includes/third-party/comments/index.pug:1-37`（P5-1）。
 *
 * 门控：`theme.comments.use`（null/字符串/数组 → 归一化见 _kit.commentSystems）。
 * 上游挂载点：post.pug:44 与 page.pug:35（`#post-comment` 整块）。
 * use 为空时输出 0 节点；use 为数组（双系统）时额外产出 .comment-switch。
 */
import { getThemeConfig } from '../../../layouts/theme-context.ts'
import { renderCommentsIndex } from './render.mjs'

interface Props {
  /** 页面级变量（上游 page.*），如 root / comments。 */
  page?: Record<string, unknown>
  [key: string]: unknown
}

const theme = getThemeConfig()
const html = renderCommentsIndex(theme, Astro.props)
---

<Fragment set:html={html} />
