---
/**
 * Twikoo.astro — 上游 `layout/includes/third-party/comments/twikoo.pug:1-50`（P5-1）。
 *
 * 门控：`theme.comments.use` 含 `Twikoo`；连接参数 `theme.twikoo.envId/region`，
 * 另读 `theme.comments.lazyload/count`（#twikoo-count）。
 * 上游由 comments/js.pug:5-6 分发。
 */
import { getThemeConfig } from '../../../layouts/theme-context.ts'
import { renderTwikoo } from './render.mjs'

interface Props {
  page?: Record<string, unknown>
  [key: string]: unknown
}

const theme = getThemeConfig()
const html = renderTwikoo(theme, Astro.props)
---

<Fragment set:html={html} />
