---
/**
 * prismjs.astro — 上游 `layout/includes/third-party/prismjs.pug:1-6`（P5-1）。
 *
 * 门控**来自站点 config 而非 theme**：上游 `config.prismjs.enable && !config.prismjs.preprocess`，
 * 主题 schema 的 133 个顶层键里没有 prismjs（顶层 strict 不接受新键），
 * 因此由 page props 注入 `page.siteConfig.prismjs = { enable, preprocess, line_number }`。
 * 输出 prismjs_js / prismjs_autoloader（line_number 时再加 prism-line-numbers）。
 * 接线建议：BaseLayout.astro:500 `<AdditionalJs>` 之后（上游 additional-js.pug:83）。
 */
import { getThemeConfig } from '../../layouts/theme-context.ts'
import { renderPrismjs } from './render.mjs'

interface Props {
  /** 站点级 config（上游 config.prismjs）。 */
  siteConfig?: Record<string, unknown>
  page?: Record<string, unknown>
  [key: string]: unknown
}

const theme = getThemeConfig()
const html = renderPrismjs(theme, Astro.props)
---

<Fragment set:html={html} />
