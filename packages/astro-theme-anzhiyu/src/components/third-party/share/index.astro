---
/**
 * index.astro — 上游 `layout/includes/third-party/share/index.pug:1-7`（P5-1）。
 *
 * 门控：`theme.sharejs.enable || theme.addtoany.enable`，外层 `.post_share`；
 * 两者都开时按上游 if/else 只走 sharejs。
 * 挂载建议：文章页 post-copyright 区（上游 post-copyright.pug:42 / :63）。
 */
import { getThemeConfig } from '../../../layouts/theme-context.ts'
import { renderShareIndex } from './render.mjs'

interface Props {
  page?: Record<string, unknown>
  /** 上游 page.cover */
  cover?: string
  [key: string]: unknown
}

const theme = getThemeConfig()
const html = renderShareIndex(theme, Astro.props)
---

<Fragment set:html={html} />
