---
/**
 * subtitle.astro — 上游 `layout/includes/third-party/subtitle.pug:1-129`（P5-1）。
 *
 * 门控：`theme.subtitle.enable`（上游 header/index.pug:48-51 的 loadSubJs，仅首页）。
 * 按 `source` 分支（1 一言 / 2 一句 / 3 今日诗词 / 其它用 sub），读
 * effect/loop/startDelay/typeSpeed/backSpeed/sub；typed.js 走 asset('typed')。
 * 站点副标题由 page.siteSubtitle 注入（上游 config.subtitle）。
 * 接线建议：BaseLayout.astro:500 `<AdditionalJs>` 的 .js-pjax（上游 additional-js.pug:69-70）。
 */
import { getThemeConfig } from '../../config/theme-context.ts'
import { renderSubtitle } from './render.mjs'

interface Props {
  page?: Record<string, unknown>
  /** 上游 config.subtitle */
  siteSubtitle?: string
  [key: string]: unknown
}

const theme = getThemeConfig()
const html = renderSubtitle(theme, Astro.props)
---

<Fragment set:html={html} />
