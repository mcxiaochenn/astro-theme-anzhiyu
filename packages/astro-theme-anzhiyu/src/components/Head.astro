---
/**
 * Head.astro — 上游 `layout/includes/head.pug` 的基础部分（P2-3）。
 *
 * 覆盖范围（head.pug 第 21–49 行 + Open_Graph + preconnect + site_verification + noscript）：
 *   charset / X-UA-Compatible / viewport / title / keywords / author / copyright /
 *   format-detection / theme-color / 移动端 meta / OG / description / favicon /
 *   canonical / preconnect / 站长验证 / noscript
 *
 * 明确不在本组件里做（留给后续阶段，理由见 docs/notes/P2-2-3-layout-head.md）：
 *   - `GLOBAL_CONFIG` / `config-diff` / `inject_head_js` 三段内联脚本 → P4-1（资源解析层）
 *   - `main_css` / fontawesome / snackbar / fancybox / PWA / icons 的 `<link>` → P4-1（asset 层）
 *   - pwa.pug（默认关闭）、analytics / google_adsense（P5-3）
 *   - inject.head（配置注入）
 *
 * `<html lang>` 不在本组件里：Astro 的 `<html>` 只能由布局组件声明，
 * 所以 lang 由 BaseLayout 从同一份 site 数据写出（见 BaseLayout.astro）。
 */
import { getThemeConfig } from '../layouts/theme-context.ts'
import { createUrlFor, fullUrlFor, type SiteConfig } from '../layouts/site.ts'
import { pageDescription, urlNoIndex } from '../utils/helpers.ts'
import { resolveAssets } from '../config/assets.ts'
import { buildGlobalConfigScript, buildGlobalConfigSiteScript } from './head/global-config.ts'
import { buildInjectHeadJs } from './head/inject-head-js.ts'

interface Props {
  /** 站点级元数据（title/description/author/url/language…）。 */
  site: SiteConfig
  /** 页面标题（上游 `page.title`）；首页留空。 */
  title?: string
  /** 页面描述（上游 `page.description`）。 */
  description?: string
  /** 页面正文（上游 `page.content`，`page_description()` 的回退链会用到）。 */
  content?: string
  /** 页面关键词覆盖（上游 `page.keywords`）。 */
  keywords?: string | string[]
  /** 页面标签名（上游 `page.tags[].name`，keywords 的第二级回退）。 */
  tagNames?: string[]
  /** OG 图片覆盖（上游 `page.cover`）。 */
  ogImage?: string
  /** OG 类型；缺省按 `isHome` 推导（上游 `is_post() ? 'article' : 'website'`）。 */
  ogType?: 'website' | 'article'
  /** 是否首页（决定 `<title>` 的拼接方式）。 */
  isHome?: boolean
  /** 页面绝对 URL；缺省用 `site.url` + `Astro.url.pathname` 推导。 */
  pageUrl?: string
  /** 页面类型（`GLOBAL_CONFIG_SITE.isPost`）。 */
  pageType?: 'post' | 'page'
  /** 文章页 TOC 是否可用（`GLOBAL_CONFIG_SITE.isToc`）。 */
  showToc?: boolean
  /** `page.updated` 的格式化结果（`GLOBAL_CONFIG_SITE.postUpdate`）。 */
  postUpdate?: string
  /** `page.ai`（`GLOBAL_CONFIG_SITE.postAI`）。 */
  postAI?: string
  /** `page.main_color`（`GLOBAL_CONFIG_SITE.postMainColor`）。 */
  postMainColor?: string
}

const {
  site,
  title,
  description,
  content,
  keywords,
  tagNames,
  ogImage,
  ogType,
  isHome = false,
  pageUrl,
  pageType = 'page',
  showToc = false,
  postUpdate,
  postAI,
  postMainColor,
} = Astro.props

const theme = getThemeConfig()
const urlFor = createUrlFor(site.root ?? '/')

/* ------------------------------------------------------------------ */
/* 1. title / keywords / author / copyright / theme-color              */
/* ------------------------------------------------------------------ */

/**
 * 上游 head.pug 第 6–9 行：
 *   首页或没有 pageTitle → `config.title + ' - ' + config.subtitle`
 *   其它页面 → `pageTitle + ' | ' + config.title`
 * `pageTitle` 的回退是 `page.title || config.title`。
 */
const pageTitle = title || site.title || ''
const subtitleSuffix = site.subtitle ? ` - ${site.subtitle}` : ''
const tabTitle = isHome || !pageTitle ? `${site.title}${subtitleSuffix}` : `${pageTitle} | ${site.title}`

/** 上游 head.pug 第 11–14 行：page.keywords > page.tags > config.keywords。 */
function normalizeKeywordList(value: string | string[] | undefined): string | undefined {
  if (value === undefined || value === null) return undefined
  const list = Array.isArray(value) ? value : [value]
  const joined = list.filter((item) => item !== '').join(',')
  return joined || undefined
}
const pageKeywords =
  normalizeKeywordList(keywords) ??
  (tagNames && tagNames.length ? tagNames.join(',') : undefined) ??
  normalizeKeywordList(site.keywords)

/** 上游 head.pug 第 15–16 行。 */
const pageAuthor = site.email ? `${site.author},${site.email}` : site.author
const pageCopyright = site.copyright || site.author

/**
 * 上游 head.pug 第 17–19 行：theme_color 关闭时回退 `#ffffff` / `#0d0d0d`，
 * 分支依据是**配置**的 display_mode（不是运行时 data-theme）。
 */
const themeColorLight = (theme.theme_color?.enable && theme.theme_color.meta_theme_color_light) || '#ffffff'
const themeColorDark = (theme.theme_color?.enable && theme.theme_color.meta_theme_color_dark) || '#0d0d0d'
const themeColor = theme.display_mode === 'dark' ? themeColorDark : themeColorLight

/* ------------------------------------------------------------------ */
/* 2. URL / description / OG                                           */
/* ------------------------------------------------------------------ */

const origin = Astro.url.origin
const siteOrigin = (site.url ? site.url.replace(/\/+$/, '') : origin.replace(/\/+$/, '')) || ''

/**
 * Astro `base`（demo 部署构建设置，如 /blog）会让 `Astro.url.pathname`
 * 自带前缀；站内前缀由 site.root（urlFor）负责，这里先剥掉 base 前缀，
 * 避免双重拼接。验收构建无 base（BASE_URL === '/'），行为不变。
 * 注意 BASE_URL 不带尾斜杠（/blog），剥完要补回前导 /。
 */
const astroBasePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL
const routePath = (pathname: string): string => {
  if (!astroBasePath || !pathname.startsWith(astroBasePath)) return pathname
  const rest = pathname.slice(astroBasePath.length)
  return rest.startsWith('/') ? rest : `/${rest}`
}

const resolvedPageUrl =
  pageUrl ?? `${siteOrigin}${urlFor(routePath(Astro.url.pathname))}`

/** 上游 `urlNoIndex()`：canonical 去掉结尾 `index.html`。 */
const canonical = urlNoIndex(resolvedPageUrl)

/** 上游 `page_description()`：page.description > page.content > page.title > config.description。 */
const metaDescription = pageDescription({
  page: { title, description, content },
  config: { description: site.description },
})

/** 上游 Open_Graph.pug 第 3 行：`page.cover || theme.avatar.img`，一律转绝对 URL。 */
const avatarImage = (theme.avatar as { img?: string } | undefined)?.img
const metaImage = fullUrlFor(ogImage || avatarImage, site, origin)

const resolvedOgType = ogType ?? (isHome ? 'website' : 'article')
const ogTitle = pageTitle
const ogSiteName = site.title
const ogLocale = site.language
const articleAuthor = site.author
const articleTag = normalizeKeywordList(site.keywords)
const openGraphEnabled = theme.Open_Graph_meta === true

/* ------------------------------------------------------------------ */
/* 3. favicon                                                          */
/* ------------------------------------------------------------------ */

/** 上游 `favicon_tag(theme.favicon || config.favicon)`。 */
const faviconPath =
  (theme.favicon as string | undefined) || site.favicon || '/favicon.ico'
const faviconHref = urlFor(faviconPath)
/** 上游 hexo-util 的 favicon_tag：`.ico` 用 `shortcut icon`，否则 `icon`。 */
const faviconRel = /\.ico$/i.test(faviconHref) ? 'shortcut icon' : 'icon'

/* ------------------------------------------------------------------ */
/* 4. preconnect（上游 head/preconnect.pug）                            */
/* ------------------------------------------------------------------ */

const providers: Record<string, string | undefined> = {
  jsdelivr: '//cdn.jsdelivr.net',
  cdnjs: '//cdnjs.cloudflare.com',
  unpkg: '//unpkg.com',
  elemecdn: '//npm.elemecdn.com',
  onmicrosoft: '//npm.onmicrosoft.cn',
  cbd: '//cdn.cbd.int',
  anheyu: '//cdn.anheyu.com',
  custom: undefined,
}
const cdn = theme.CDN
if (cdn.internal_provider === 'custom' || cdn.third_party_provider === 'custom') {
  const customFormat = typeof cdn.custom_format === 'string' ? cdn.custom_format : ''
  const matched = /^((https?:)?(\/\/[^/]+)|([^/]+))(\/|$)/.exec(customFormat)
  providers.custom = matched?.[1]
}

const preconnectHrefs: string[] = []
const addPreconnect = (provider: string) => {
  const href = providers[provider]
  if (href && !preconnectHrefs.includes(href)) preconnectHrefs.push(href)
}
// 上游 preconnect.pug 15–21 行的分支（含 pug 里第三分支挂错缩进的原始行为）
if (cdn.internal_provider === cdn.third_party_provider && cdn.internal_provider !== 'local') {
  addPreconnect(cdn.internal_provider)
} else {
  if (cdn.internal_provider !== 'local') addPreconnect(cdn.internal_provider)
  if (cdn.third_party_provider !== 'local') addPreconnect(cdn.third_party_provider)
}
if (theme.google_analytics) preconnectHrefs.push('//www.google-analytics.com')
if (theme.baidu_analytics) preconnectHrefs.push('//hm.baidu.com')
if (theme.cloudflare_analytics) preconnectHrefs.push('//static.cloudflareinsights.com')
if (theme.microsoft_clarity) preconnectHrefs.push('//www.clarity.ms')
if (
  theme.blog_title_font &&
  theme.blog_title_font.font_link &&
  theme.blog_title_font.font_link.includes('//fonts.googleapis.com')
) {
  preconnectHrefs.push('//fonts.googleapis.com')
}

/* ------------------------------------------------------------------ */
/* 5. site_verification（上游 head/site_verification.pug）              */
/* ------------------------------------------------------------------ */

const verificationMetas = Array.isArray(theme.site_verification)
  ? (theme.site_verification as Array<{ name?: unknown; content?: unknown }>).filter(
      (item) => typeof item?.name === 'string' && typeof item?.content === 'string',
    )
  : []

/* ------------------------------------------------------------------ */
/* 6. 资源层（上游 head.pug:53-90 的 link 序列）                        */
/* ------------------------------------------------------------------ */

/** 任何 looseObject 区块的安全读取。 */
function sectionObject(section: unknown): Record<string, unknown> {
  return section && typeof section === 'object' ? (section as Record<string, unknown>) : {}
}
function sectionFlag(section: unknown, key: string, fallback = false): boolean {
  const value = sectionObject(section)[key]
  return typeof value === 'boolean' ? value : fallback
}
function sectionString(section: unknown, key: string, fallback = ''): string {
  const value = sectionObject(section)[key]
  return typeof value === 'string' ? value : fallback
}

/** `theme.asset`（等价物）：internal=local、third_party=cbd，见 config/assets.ts。 */
const assets = resolveAssets(theme)
/** 资源表里的值可能是相对路径，统一过一遍 `url_for()`。 */
const assetUrl = (key: string): string => urlFor(assets[key] ?? '')

const icons = sectionObject(theme.icons)
const fontawesomeAnimationCss = sectionString(icons, 'fontawesome_animation_css')
const fontawesomeEnabled = sectionFlag(icons, 'fontawesome')
const snackbarCssEnabled = sectionFlag(theme.snackbar, 'enable')
const fancyboxCssEnabled = theme.fancybox === true
const homeTopSwiper = sectionObject(sectionObject(theme.home_top).swiper)
const swiperCssEnabled = sectionFlag(homeTopSwiper, 'enable')
const blogTitleFont = sectionObject(theme.blog_title_font)
const blogTitleFontLink = sectionString(blogTitleFont, 'font_link')

/* ------------------------------------------------------------------ */
/* 7. 三段内联脚本（GLOBAL_CONFIG / config-diff / inject_head_js）      */
/* ------------------------------------------------------------------ */

const globalConfigScript = buildGlobalConfigScript(theme, site, assets)

const highlightShrink: boolean | string = theme.highlight_shrink
const isHighlightShrink = highlightShrink === 'none' ? undefined : (highlightShrink as boolean)

const pageFillDescription = content || description || title || site.description || ''

const globalConfigSiteScript = buildGlobalConfigSiteScript({
  configTitle: site.title,
  title: pageTitle,
  postAI,
  pageFillDescription,
  isPost: pageType === 'post',
  isHome,
  isHighlightShrink,
  isToc: showToc,
  postUpdate,
  postMainColor,
})

const injectHeadJs = buildInjectHeadJs(theme, site)
---

<meta charset="UTF-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
<title>{tabTitle}</title>
{pageKeywords && <meta name="keywords" content={pageKeywords} />}
{pageAuthor && <meta name="author" content={pageAuthor} />}
{pageCopyright && <meta name="copyright" content={pageCopyright} />}
<meta name="format-detection" content="telephone=no" />
<meta name="theme-color" content={themeColor} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-touch-fullscreen" content="yes" />
<meta name="apple-mobile-web-app-title" content={pageTitle} />
<meta name="application-name" content={pageTitle} />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content={themeColor} />

{openGraphEnabled && (
  <>
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:url" content={resolvedPageUrl} />
    <meta property="og:site_name" content={ogSiteName} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    {ogLocale && <meta property="og:locale" content={ogLocale} />}
    {metaImage && <meta property="og:image" content={metaImage} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articleTag && <meta property="article:tag" content={articleTag} />}
    <meta name="twitter:card" content="summary" />
    {metaImage && <meta name="twitter:image" content={metaImage} />}
  </>
)}
{metaDescription && <meta name="description" content={metaDescription} />}

<link rel={faviconRel} href={faviconHref} />
<link rel="canonical" href={canonical} />

{preconnectHrefs.map((href) => (
  <link rel="preconnect" href={href} />
))}

{verificationMetas.map((item) => (
  <meta name={item.name as string} content={item.content as string} />
))}

{/*
  上游 head.pug:53-90 的顺序：
    fontawesome_animation_css → main_css → fontawesome → snackbar_css →
    fancybox_css → swiper_css → (analytics/font) → config.pug → config_site.pug →
    noscript.pug → injectHeadJs
  基准站只命中 main_css / snackbar / fancybox 三条，其余分支保持同序占位。
*/}
{fontawesomeAnimationCss && (
  <link rel="stylesheet" href={urlFor(fontawesomeAnimationCss)} />
)}
<link rel="stylesheet" href={assetUrl('main_css')} />
{fontawesomeEnabled && (
  <link rel="stylesheet" href={assetUrl('fontawesome')} media="print" onload="this.media='all'" />
)}
{snackbarCssEnabled && (
  <link rel="stylesheet" href={assetUrl('snackbar_css')} media="print" onload="this.media='all'" />
)}
{fancyboxCssEnabled && (
  <link rel="stylesheet" href={assetUrl('fancybox_css')} media="print" onload="this.media='all'" />
)}
{swiperCssEnabled && (
  <link
    rel="stylesheet"
    href={urlFor(sectionString(homeTopSwiper, 'swiper_css'))}
    media="print"
    onload="this.media='all'"
  />
)}
{blogTitleFontLink && (
  <link rel="stylesheet" href={urlFor(blogTitleFontLink)} media="print" onload="this.media='all'" />
)}

{/* 上游 `partial('includes/head/config')` —— GLOBAL_CONFIG 内联脚本 */}
<script is:inline set:html={globalConfigScript}></script>

{/* 上游 `head/config_site.pug` —— id="config-diff" 的 GLOBAL_CONFIG_SITE */}
<script is:inline id="config-diff" set:html={globalConfigSiteScript}></script>

<noscript>
  <style type="text/css">
    #nav {
      opacity: 1
    }
    .justified-gallery img {
      opacity: 1
    }

    #recent-posts time,
    #post-meta time {
      display: inline !important
    }
  </style>
</noscript>

{/* 上游 `inject_head_js()`：saveToLocal / getScript / getCSS / 暗色 / aside / apple */}
<script is:inline set:html={injectHeadJs}></script>
