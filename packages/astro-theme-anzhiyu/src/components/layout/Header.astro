---
/**
 * Header.astro — 上游 `layout/includes/header/index.pug` + `header/nav.pug`（P2-4）。
 *
 * 复刻内容（按上游文件逐块对照）：
 *   header/index.pug:24  header#page-header（class 由 top_img 分支算出：not-top-img /
 *                        full_page / not-home-page / post-bg；style 只在首页有 top_img 时非空）
 *   nav.pug:2-59         nav#nav > #nav-group
 *                          span#blog_name（nav.enable 时插 .back-home-button 下拉）
 *                          a#site-name（.title + 房子图标，accesskey="h"）
 *                          .mask-name-container > #name-container > a#page-name
 *                          #menus（= MenuItems.astro，数据源顶层 theme.menu）
 *                          #nav-right（travelling / randomPost / search / 中控台开关 /
 *                                      nav-totop 百分比 / #toggle-menu）
 *
 * 分支插槽：
 *   - 文章页有 top_img 时的 `#post-info` + 波浪 + `#post-top-cover` 整块属于 P2-8，
 *     通过默认插槽 `post-info` 由 BaseLayout 转发（`<slot name="post-info" slot="post-info" />`）。
 *   - 首页有 top_img 时的 `#site-info`（标题/副标题/社交图标/滚动箭头）与其它页面的
 *     `#page-site-info` 在这里实做；基准站 `index_img/default_top_img` 都是 false，
 *     所以这两块在当前配置下不渲染（与 baseline 一致）。
 *
 * 明确不做（都有归属，不是遗漏）：
 *   - `#console`（中控台面板，nav.pug:50）→ P4-6。`input#center-console` + `label.widget`
 *     是它的开关，在 nav.pug 里是独立节点，本组件保留；`#console` 由 P4-6 追加在
 *     `#nav-right` 内（CSS 依赖 `#center-console:checked ~ #console` 的兄弟关系）。
 *   - `theme.nav.clock`（和风天气 widget，clock.pug）→ P4-1 资源层（外部 css/js）。
 *   - 搜索框本体（三套搜索的弹层）→ P4-8；本组件只出 `#search-button` 入口。
 */
import { getThemeConfig, readFlag } from '../../layouts/theme-context.ts'
import { createUrlFor, type SiteConfig } from '../../layouts/site.ts'
import { tp } from '../../i18n/index.ts'
import MenuItems from './MenuItems.astro'
import { lazyImageAttrs } from './lazyload.ts'

interface Props {
  /** 站点级元数据（`config.title` / `config.language` / `root`）。 */
  site: SiteConfig
  /** 是否首页（`is_home()`）。 */
  isHome?: boolean
  /** `#body-wrap` 的 pageType（上游 `is_post() ? 'post' : 'page'`）。 */
  pageType?: 'post' | 'page'
  /** 页面 top_img：string=有图；false=显式禁用；缺省=按主题配置回退。 */
  topImg?: string | false
  /** `page.title || page.tag || page.category`，回退 `config.title`。 */
  siteTitle?: string
}

const { site, isHome = false, pageType = 'page', topImg, siteTitle } = Astro.props

const theme = getThemeConfig()
const urlFor = createUrlFor(site.root ?? '/')
const lang = site.language
/** 上游 `_p()`（复数 helper，实际全部用于普通键）。 */
const _p = (key: string) => tp(key, lang)

/* ------------------------------------------------------------------ */
/* 1. top_img 与 #page-header 的 class / style                          */
/* ------------------------------------------------------------------ */

/** 配置里的 top_img 可能是布尔（默认 false）或字符串（CSS 背景串），按上游语义收窄。 */
function asTopImg(value: unknown): string | false {
  return typeof value === 'string' && value !== '' ? value : false
}

/**
 * 上游 header/index.pug:1-23：
 *   首页 top_img = `index_img !== false ? index_img || default_top_img : false`
 *   其它页 top_img = `page.top_img || default_top_img`
 *   `disable_top_img` 或 `page.top_img === false` 时一律 false。
 */
const homeTopImg =
  !theme.disable_top_img && theme.index_img !== false
    ? asTopImg(theme.index_img) || asTopImg(theme.default_top_img)
    : false
const resolvedTopImg: string | false =
  topImg === false || theme.disable_top_img
    ? false
    : topImg || (isHome ? homeTopImg : asTopImg(theme.default_top_img))

/** 上游 header/index.pug:17-23。 */
const pageHeaderClass =
  resolvedTopImg === false
    ? 'not-top-img'
    : pageType === 'post'
      ? 'post-bg'
      : isHome
        ? 'full_page'
        : 'not-home-page'

/** 上游 `style=home_index_img_bg`：首页的 index_img 本身就是一段 CSS 声明串。 */
const headerStyle = isHome && homeTopImg ? homeTopImg : undefined

/* ------------------------------------------------------------------ */
/* 2. nav-right 的开关                                                  */
/* ------------------------------------------------------------------ */

const nav = theme.nav
const searchEnabled =
  theme.algolia_search.enable || theme.local_search.enable || theme.docsearch.enable
const centerConsoleEnabled = readFlag(theme.centerConsole, 'enable')

/* ------------------------------------------------------------------ */
/* 3. 首页 #site-info 的社交图标（`header/social.pug`）                  */
/* ------------------------------------------------------------------ */

interface SocialEntry {
  title: string
  href: string
  icon: string
  animation: string
}
const rawSocial = theme.social
const socialEntries: SocialEntry[] =
  rawSocial && typeof rawSocial === 'object' && !Array.isArray(rawSocial)
    ? Object.entries(rawSocial as Record<string, unknown>).map(([title, value]) => {
        const parts = String(value ?? '').split('||')
        return {
          title: title.trim(),
          href: parts[0].trim(),
          icon: parts[1] ? parts[1].trim() : '',
          animation: parts[2] ? parts[2].trim() : 'faa-tada',
        }
      })
    : []
---

<header id="page-header" class={pageHeaderClass} style={headerStyle}>
  <nav id="nav">
    <div id="nav-group">
      <span id="blog_name">
        {
          nav.enable && (
            <div class="back-home-button">
              <i class="anzhiyufont anzhiyu-icon-grip-vertical" />
              <div class="back-menu-list-groups">
                {nav.menu.map((group) => (
                  <div class="back-menu-list-group">
                    <div class="back-menu-list-title">{group.title}</div>
                    <div class="back-menu-list">
                      {group.item.map((item) => (
                        <a class="back-menu-item" href={urlFor(item.link)} title={item.name}>
                          <img
                            class="back-menu-item-icon"
                            alt={item.name}
                            {...lazyImageAttrs(item.icon, { theme, urlFor })}
                          />
                          <span class="back-menu-item-text">{item.name}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )
        }
        {
          /* nav.clock → 和风天气 widget（clock.pug），外部 CSS/JS 属 P4-1 资源层 */
        }
        <a id="site-name" href={urlFor('/')} accesskey="h">
          <div class="title">{site.title}</div>
          <i class="anzhiyufont anzhiyu-icon-house-chimney" />
        </a>
      </span>

      <div class="mask-name-container">
        <div id="name-container">
          <a id="page-name" href="javascript:anzhiyu.scrollToDest(0, 500)">PAGE_NAME</a>
        </div>
      </div>

      <div id="menus">
        <MenuItems site={site} />
      </div>

      <div id="nav-right">
        {
          nav.travelling && (
            <div class="nav-button only-home" id="travellings_button" title={_p('nav.travelling')}>
              <a
                class="site-page"
                onclick="anzhiyu.totraveling()"
                title={_p('nav.travelling')}
                href="javascript:void(0);"
                rel="external nofollow"
                data-pjax-state="external"
              >
                <i class="anzhiyufont anzhiyu-icon-train" />
              </a>
            </div>
          )
        }
        <div class="nav-button" id="randomPost_button">
          <a
            class="site-page"
            onclick="toRandomPost()"
            title={_p('nav.random_post')}
            href="javascript:void(0);"
          >
            <i class="anzhiyufont anzhiyu-icon-dice" />
          </a>
        </div>
        {
          searchEnabled && (
            <div class="nav-button" id="search-button">
              <a
                class="site-page social-icon search"
                href="javascript:void(0);"
                title={_p('nav.search')}
                accesskey="s"
              >
                <i class="anzhiyufont anzhiyu-icon-magnifying-glass" />
                <span>{' ' + _p('search.title')}</span>
              </a>
            </div>
          )
        }
        {
          centerConsoleEnabled && (
            <>
              <input id="center-console" type="checkbox" />
              <label
                class="widget"
                for="center-console"
                title={_p('console.title')}
                onclick="anzhiyu.switchConsole();"
              >
                <i class="left" />
                <i class="widget center" />
                <i class="widget right" />
              </label>
            </>
          )
        }
        {
          /* #console（中控台面板）→ P4-6，必须作为 #nav-right 的直接子元素追加在这里 */
        }
        <div class="nav-button" id="nav-totop">
          <a class="totopbtn" href="javascript:void(0);">
            <i class="anzhiyufont anzhiyu-icon-arrow-up" />
            <span id="percent" onclick="anzhiyu.scrollToDest(0,500)">0</span>
          </a>
        </div>
        <div id="toggle-menu">
          <a class="site-page" href="javascript:void(0);" title={_p('nav.toggle_menu')}>
            <i class="anzhiyufont anzhiyu-icon-bars" />
          </a>
        </div>
      </div>
    </div>
  </nav>

  {
    resolvedTopImg !== false && (
      pageType === 'post' ? (
        /* post-info.pug + waves + #post-top-cover → P2-8 从 BaseLayout 转发进来 */
        <slot name="post-info" />
      ) : isHome ? (
        <>
          <div id="site-info">
            <h1 id="site-title">{siteTitle ?? site.title}</h1>
            {theme.subtitle.enable && (
              <div id="site-subtitle">
                <span id="subtitle" />
              </div>
            )}
            {socialEntries.length > 0 && (
              <div id="site_social_icons">
                {socialEntries.map((entry) => (
                  <a
                    class="social-icon faa-parent animated-hover"
                    href={urlFor(entry.href)}
                    target="_blank"
                    title={entry.title}
                  >
                    {entry.icon.startsWith('fa') ? (
                      <i class={`${entry.icon} ${entry.animation}`} />
                    ) : entry.icon.startsWith('icon') ? (
                      <svg class={`icon ${entry.animation}`} aria-hidden="true">
                        <use xlink:href={`#${entry.icon}`} />
                      </svg>
                    ) : entry.icon.startsWith('anzhiyu') ? (
                      <i class={`anzhiyufont ${entry.icon}`} />
                    ) : null}
                  </a>
                ))}
              </div>
            )}
          </div>
          <div id="scroll-down">
            <i class="anzhiyufont anzhiyu-icon-angle-down scroll-down-effects" />
          </div>
        </>
      ) : (
        <div id="page-site-info">
          <h1 id="site-title">{siteTitle ?? site.title}</h1>
        </div>
      )
    )
  }
</header>
