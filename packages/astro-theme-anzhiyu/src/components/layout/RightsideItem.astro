---
/**
 * RightsideItem.astro — 上游 `rightside.pug:2-34` 的 `mixin rightsideItem(array)` 的单元素版本。
 *
 * 上游把 `rightside_item_order.hide / show`（逗号分隔的字符串）拆成数组后逐项调用
 * 同一个 mixin，`case item` 决定渲染哪个按钮。这里把一个 `case` 分支做成一个组件，
 * 这样 Rightside.astro 只要按数组顺序 `.map()` 就能保持配置里的自定义顺序。
 *
 * 每个分支的显示条件（与 pug 逐条对应）：
 *   readmode  → `is_post() && theme.readmode`
 *   translate → `theme.translate.enable`
 *   darkmode  → `theme.darkmode.enable && theme.darkmode.button`
 *   hideAside → `theme.aside.enable && theme.aside.button && page.aside !== false`
 *   toc       → `showToc`（由 P2-8 的文章页传入）
 *   chat      → `theme.chat_btn && (chatra|tidio|daovoice|crisp).enable`
 *   comment   → `commentsJsLoad` 出 #to_comment；`comment_barrage_config.enable` 另出 #switch-commentBarrage
 */
import { getThemeConfig, readFlag, readString } from '../../layouts/theme-context.ts'
import { tp } from '../../i18n/index.ts'
import type { SiteConfig } from '../../layouts/site.ts'

interface Props {
  /** `rightside_item_order` 里的一个值：readmode/translate/darkmode/hideAside/toc/chat/comment */
  item: string
  site: SiteConfig
  /** `is_post()` */
  pageType?: 'post' | 'page'
  /** `page.aside !== false`（hideAside 按钮的显示条件之一） */
  aside?: boolean
  /** `showToc`（文章页 TOC 是否可用） */
  showToc?: boolean
  /** `commentsJsLoad`（评论系统是否启用） */
  commentsLoaded?: boolean
}

const { item, site, pageType = 'page', aside, showToc = false, commentsLoaded = false } = Astro.props

const theme = getThemeConfig()
const lang = site.language
const _p = (key: string) => tp(key, lang)

const readmodeEnabled = pageType === 'post' && theme.readmode
const translateEnabled = readFlag(theme.translate, 'enable')
const translateText = readString(theme.translate, 'default', '')
const darkmodeEnabled = theme.darkmode.enable && theme.darkmode.button
const hideAsideEnabled = theme.aside.enable && theme.aside.button && aside !== false
const chatEnabled =
  theme.chat_btn &&
  (theme.chatra.enable || theme.tidio.enable || theme.daovoice.enable || theme.crisp.enable)
const barrageEnabled = readFlag(theme.comment_barrage_config, 'enable')
---

{
  item === 'readmode' ? (
    readmodeEnabled && (
      <button id="readmode" type="button" title={_p('rightside.readmode_title')}>
        <i class="anzhiyufont anzhiyu-icon-book-open" />
      </button>
    )
  ) : item === 'translate' ? (
    translateEnabled && (
      <button id="translateLink" type="button" title={_p('rightside.translate_title')}>
        {translateText}
      </button>
    )
  ) : item === 'darkmode' ? (
    darkmodeEnabled && (
      <button id="darkmode" type="button" title={_p('rightside.night_mode_title')}>
        <i class="anzhiyufont anzhiyu-icon-circle-half-stroke" />
      </button>
    )
  ) : item === 'hideAside' ? (
    hideAsideEnabled && (
      <button id="hide-aside-btn" type="button" title={_p('rightside.aside')}>
        <i class="anzhiyufont anzhiyu-icon-arrows-left-right" />
      </button>
    )
  ) : item === 'toc' ? (
    showToc && (
      <button class="close" id="mobile-toc-button" type="button" title={_p('rightside.toc')}>
        <i class="anzhiyufont anzhiyu-icon-list-ul" />
      </button>
    )
  ) : item === 'chat' ? (
    chatEnabled && (
      <button id="chat-btn" type="button" title={_p('rightside.chat')}>
        <i class="anzhiyufont anzhiyu-icon-comment-sms" />
      </button>
    )
  ) : item === 'comment' ? (
    <>
      {commentsLoaded && (
        <a id="to_comment" href="#post-comment" title={_p('rightside.scroll_to_comment')}>
          <i class="anzhiyufont anzhiyu-icon-comments" />
        </a>
      )}
      {barrageEnabled && (
        <a
          id="switch-commentBarrage"
          href="javascript:anzhiyu.switchCommentBarrage();"
          title="开关弹幕"
        >
          <i class="anzhiyufont anzhiyu-icon-danmu" />
        </a>
      )}
    </>
  ) : null
}
