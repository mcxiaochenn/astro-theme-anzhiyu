---
/**
 * TopGroup.astro — 上游 `layout/includes/top/top.pug:70-96` 的「swiper 关闭」分支。
 *
 *   .topGroup
 *     .recent-post-item[onclick="pjax.loadUrl('...')"]     × 6（sort_attr_post("top_group_list")）
 *       .post_cover.left_radius > a > span.recent-post-top-text 荐 + img.post_bg
 *       .recent-post-info > a.article-title
 *   a#todayCard.todayCard                                   → banner.tips / title / image / link
 *
 * `link[rel=stylesheet][href=top_group_banner_css]` 是 `.topGroup` 的**兄弟节点**
 * （top.pug:96 与 `.topGroup` 同级），由 HomeTop 负责输出。
 *
 * 两处与「模板字面量」不同的上游机制，这里直接输出最终形态：
 *   1. `scripts/filters/post_lazyload.js` 的 img 改写（src → placeholder + data-lazy-src）；
 *   2. Hexo `external_link`（_config.yml `enable: true`）给外链 `<a>` 追加
 *      `target="_blank" rel="noopener"`，基线里的 `#todayCard` 命中了这条。
 *
 * 注意 `.post_bg` 的 `onerror`：top.pug 把 `onerror` 写在 `src` **前面**，lazyload 过滤器
 * 是在 `src=` 之后插入自己那份 `onerror`，所以产物里先出现、被浏览器/diff 采用的那份
 * 是模板的 `this.onerror=null;this.src='...'`（逗号版本被当成重复属性丢弃）。
 * `.todayCard-cover` 则相反（`src` 在前），保留过滤器插入的逗号版本。
 */
import { resolveImageLazyload, type PreparedPost } from '../post/post-list.ts'
import { createUrlFor } from '../../layouts/site.ts'

interface BannerConfig {
  tips: string
  title: string
  image: string
  link: string
}

interface Props {
  /** `sort_attr_post("top_group_list").splice(0, 6)` 的结果。 */
  posts: PreparedPost[]
  banner: BannerConfig
  /** 站点 url（`config.url`），用于判断 banner 外链。 */
  siteUrl?: string
}

const { posts, banner, siteUrl } = Astro.props
const urlFor = createUrlFor('/')
const lazyload = resolveImageLazyload()

/** Hexo `external_link`：绝对外链且 host 与站点不同才追加 target/rel。 */
function isExternalLink(href: string): boolean {
  if (!/^(?:[a-z][a-z0-9+.-]*:)?\/\//i.test(href)) return false
  try {
    const host = new URL(href).hostname
    if (!siteUrl) return Boolean(host)
    return Boolean(host) && host !== new URL(siteUrl).hostname
  } catch {
    return false
  }
}

const bannerLink = urlFor(banner.link)
const bannerExternal = isExternalLink(bannerLink)
const coverImage = urlFor(banner.image)
---

<div class="topGroup">
  {
    posts.map((post) => (
      <div class="recent-post-item" onclick={`pjax.loadUrl("${post.href}")`}>
        <div class="post_cover left_radius">
          <a href={post.path} title={post.title}>
            <span class="recent-post-top-text">荐</span>
            {post.cover ? (
              <img
                class="post_bg"
                src={lazyload.enabled ? lazyload.placeholder : urlFor(post.cover)}
                onerror={`this.onerror=null;this.src='${lazyload.errorPostPage}'`}
                data-lazy-src={lazyload.enabled ? urlFor(post.cover) : undefined}
                alt="cover"
              />
            ) : (
              <img
                class="post_bg"
                onerror={`this.onerror=null;this.src='${lazyload.errorPostPage}'`}
                alt="cover"
              />
            )}
          </a>
        </div>
        <div class="recent-post-info">
          <a class="article-title" href={post.path} title={post.title}>
            {post.title}
          </a>
        </div>
      </div>
    ))
  }

  <a
    id="todayCard"
    class="todayCard"
    href={bannerLink}
    style="z-index: 1;"
    target={bannerExternal ? '_blank' : undefined}
    rel={bannerExternal ? 'noopener' : undefined}
  >
    <div class="todayCard-info">
      <div class="todayCard-tips">{banner.tips}</div>
      <div class="todayCard-title">{banner.title}</div>
    </div>
    <img
      class="todayCard-cover"
      src={lazyload.enabled ? lazyload.placeholder : coverImage}
      onerror={
        lazyload.enabled
          ? `this.onerror=null,this.src="${lazyload.errorPostPage}"`
          : `this.onerror=null;this.src='${lazyload.errorPostPage}'`
      }
      data-lazy-src={lazyload.enabled ? coverImage : undefined}
      alt="封面"
    />
    <div class="banner-button-group">
      <div
        class="banner-button"
        onclick="event.stopPropagation();event.preventDefault();anzhiyu.hideTodayCard();"
      >
        <i class="anzhiyufont anzhiyu-icon-arrow-circle-right" />
        <span class="banner-button-text">更多推荐</span>
      </div>
    </div>
  </a>
</div>
