---
/**
 * Console.astro — 上游 `layout/includes/anzhiyu/console.pug` 的整棵子树（P4-6）。
 *
 * 挂载位置：`Header.astro` 的 `#nav-right` 内，紧跟在 `input#center-console` +
 * `label.widget` 之后。顺序是 **CSS 契约**：
 *
 *   #center-console:checked ~ #console { ... }   /* 中控台展开依赖兄弟关系 *\/
 *
 * 上游 nav.pug:50 无条件 include 这棵子树（即使 `centerConsole.enable` 为 false），
 * 这里保持同样的行为：是否可用由开关按钮 + CSS 决定，不由渲染条件决定。
 *
 * 数据来源：
 *   - 打赏二维码：`theme.reward.QR_code`；
 *   - 最新评论卡：`card_newest_comment.pug` 结构内联在本组件（`#card-newest-comments`，
 *     G3 已删除无人引用的死卡 `widget/CardNewestComment.astro`）；
 *   - 标签云 / 归档：`CardConsoleTags` / `CardConsoleArchives`（P3-1 已实现，
 *     与 aside 同名卡片共用 `getSiteStats()` 缓存）。
 */
import { getThemeConfig } from '../../layouts/theme-context.ts'
import { createUrlFor, type PostHrefResolver } from '../../layouts/site.ts'
import { tp } from '../../i18n/index.ts'
import { getSiteStats } from '../../data/site-stats.ts'
import { lazyImageAttrs } from '../layout/lazyload.ts'
import CardConsoleTags from '../widget/CardConsoleTags.astro'
import CardConsoleArchives from '../widget/CardConsoleArchives.astro'

interface Props {
  /** 站点语言（`config.language`），用于 `_p()` 文案；缺省走 i18n 的 default 字典。 */
  lang?: string
  /** 页面类型；文章页的 reward 图在基线里**不**走 lazyload（`src` 直出）。 */
  pageType?: 'post' | 'page'
  /** 文章 permalink 解析器（来自站点配置；CardConsoleArchives/Tags 不需要，但共用同一份统计缓存）。 */
  resolvePostHref?: PostHrefResolver
}

const { lang, pageType = 'page', resolvePostHref } = Astro.props
const theme = getThemeConfig()
const urlFor = createUrlFor('/')
const _p = (key: string) => tp(key, lang)

function obj(section: unknown): Record<string, unknown> {
  return section && typeof section === 'object' ? (section as Record<string, unknown>) : {}
}
function flag(section: unknown, key: string, fallback = false): boolean {
  const value = obj(section)[key]
  return typeof value === 'boolean' ? value : fallback
}

const stats = await getSiteStats({ resolvePostHref })

interface RewardItem {
  img: string
  link?: string
  text: string
}

const rewardItems: RewardItem[] = Array.isArray(obj(theme.reward).QR_code)
  ? (obj(theme.reward).QR_code as Array<Record<string, unknown>>)
      .filter((item) => typeof item?.img === 'string')
      .map((item) => ({
        img: String(item.img),
        link: typeof item.link === 'string' ? item.link : undefined,
        text: typeof item.text === 'string' ? item.text : '',
      }))
  : []

/**
 * 基线实测：主页/归档/标签/关于页的 reward 图带 `data-lazy-src`，
 * 文章页则是直接 `src`（上游 `after_render:html` 的 site 级 lazyload 在文章
 * 渲染路径上没有命中这块 fragment）。这里按 pageType 复刻该差异。
 */
const rewardImageAttrs = (src: string): Record<string, string> =>
  pageType === 'post' ? { src: urlFor(src) } : lazyImageAttrs(urlFor(src), { theme, urlFor })

const navMusic = obj(theme.nav_music)
const wideConsoleMusic = flag(navMusic, 'console_widescreen_music')
const darkmodeEnabled = flag(theme.darkmode, 'enable')
const barrageEnabled = flag(theme.comment_barrage_config, 'enable')
const navMusicEnabled = flag(navMusic, 'enable')
const shortcutEnabled = flag(theme.shortcutKey, 'enable')
/** 上游 `card_newest_comment.pug`：`theme.newest_comments.enable`。 */
const newestCommentsEnabled = flag(theme.newest_comments, 'enable')
---

<div id="console">
  <div class="console-card-group-reward">
    <ul class="reward-all console-card">
      {rewardItems.map((item) => (
        <li class="reward-item">
          <a href={urlFor(item.link || item.img)} target="_blank">
            <img class="post-qr-code-img" alt={item.text} {...rewardImageAttrs(item.img)} />
          </a>
          <div class="post-qr-code-desc">{item.text}</div>
        </li>
      ))}
    </ul>
  </div>

  <div class="console-card-group">
    <div class="console-card-group-left">
      {/*
        上游 `card_newest_comment.pug` 的结构在这里内联（G3：原
        `widget/CardNewestComment.astro` 从未被任何组件 import，是死卡，已删除）。
        文案走 `_p`（带 lang 的 tp 包装），中控台文案按当前站点语言输出。
      */}
      {newestCommentsEnabled && (
        <div class="console-card" id="card-newest-comments">
          <div class="card-content">
            <div class="author-content-item-tips">{_p('console.interaction')}</div>
            <span class="author-content-item-title">{' ' + _p('aside.card_newest_comments.headline')}</span>
          </div>
          <div class="aside-list">
            <span>{_p('aside.card_newest_comments.loading_text')}</span>
          </div>
        </div>
      )}
    </div>
    <div class="console-card-group-right">
      <div class="console-card tags">
        <div class="card-content">
          {navMusicEnabled && wideConsoleMusic ? (
            <>
              <div class="author-content-item-tips">{_p('console.music')}</div>
              <span class="author-content-item-title">{_p('console.music_desc')}</span>
            </>
          ) : (
            <>
              <div class="author-content-item-tips">{_p('console.interests')}</div>
              <span class="author-content-item-title">{_p('console.interests_desc')}</span>
              <CardConsoleTags tags={stats.tags} />
            </>
          )}
        </div>
      </div>
      <div class="console-card history">
        <div class="item-headline">
          <i class="anzhiyufont anzhiyu-icon-box-archiv" />
          <span>{_p('console.articles')}</span>
        </div>
        <CardConsoleArchives posts={stats.archivePosts} lang={lang} />
      </div>
    </div>
  </div>

  <div class="button-group">
    {darkmodeEnabled && (
      <div class="console-btn-item">
        <a class="darkmode_switchbutton" title={_p('console.toggle_mode')} href="javascript:void(0);">
          <i class="anzhiyufont anzhiyu-icon-moon" />
        </a>
      </div>
    )}
    <div
      class="console-btn-item"
      id="consoleHideAside"
      onclick="anzhiyu.hideAsideBtn()"
      title={_p('console.toggle_aside')}
    >
      <a class="asideSwitch">
        <i class="anzhiyufont anzhiyu-icon-arrows-left-right" />
      </a>
    </div>
    {barrageEnabled && (
      <div
        class="console-btn-item on"
        id="consoleCommentBarrage"
        onclick="anzhiyu.switchCommentBarrage()"
        title={_p('console.toggle_barrage')}
      >
        <a class="commentBarrage">
          <i class="anzhiyufont anzhiyu-icon-message" />
        </a>
      </div>
    )}
    {navMusicEnabled && (
      <div
        class="console-btn-item"
        id="consoleMusic"
        onclick="anzhiyu.musicToggle()"
        title={_p('console.toggle_music')}
      >
        <a class="music-switch">
          <i class="anzhiyufont anzhiyu-icon-music" />
        </a>
      </div>
    )}
    {shortcutEnabled && (
      <div
        class="console-btn-item"
        id="consoleKeyboard"
        onclick="anzhiyu.keyboardToggle()"
        title={_p('console.toggle_keyboard')}
      >
        <a class="keyboard-switch">
          <i class="anzhiyufont anzhiyu-icon-keyboard" />
        </a>
      </div>
    )}
  </div>
  <div class="console-mask" onclick="anzhiyu.hideConsole()" href="javascript:void(0);" />
</div>
