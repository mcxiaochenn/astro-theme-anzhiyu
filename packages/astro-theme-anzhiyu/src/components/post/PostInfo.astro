---
/**
 * PostInfo.astro — 上游 `layout/includes/header/post-info.pug`（P2-8）。
 *
 * 这是 Header.astro 通过 `slot="post-info"` 转发的整块内容，包含三个上游片段：
 *
 *   post-info.pug:2-114          #post-info（原创/分类/标签 + 标题 + 元信息）
 *   header/index.pug:31-42       波浪 `section.main-hero-waves-area`
 *   header/index.pug:42-43       #post-top-cover > img#post-top-bg
 *
 * 只在 `#page-header` 有 top_img 时被 Header 渲染（header/index.pug:29-42），
 * 页面侧无需再判断。
 *
 * 未实现的上游分支（基准配置不可达）：
 *   - `post_edit`（config `enable: false`）→ 标题后的编辑链接；
 *   - `wordcount`（config `enable: false`）→ 字数 / 阅读时长；
 *   - PV / 评论数（`comments.use` 为空、`busuanzi.page_pv: false`）→ 计数块。
 */
import { getThemeConfig } from '../../layouts/theme-context.ts'
import type { SiteConfig } from '../../layouts/site.ts'
import { tp } from '../../i18n/index.ts'
import { categoryHref } from './post-page.ts'
import type { PreparedPost } from './post-list.ts'

interface Props {
  post: PreparedPost
  data: Record<string, unknown>
  site: SiteConfig
  /** `page.top_img || page.cover || page.randomcover` 的收窄结果。 */
  topImg?: string | false
  /** `#post-top-bg` 的 src（`bg_img`）。 */
  bgImg: string
  language?: string | null
}

const { post, data, site, bgImg, language = null } = Astro.props
const theme = getThemeConfig()
const _p = (key: string) => tp(key, language)

const postMeta = theme.post_meta.post
const dateType = postMeta.date_type
const isBoth = dateType === 'both'
const updatedMode = dateType === 'updated'
const mainDate = updatedMode ? post.updated : post.date
const mainLabel = _p(updatedMode ? 'post.updated' : 'post.created')
const mainIcon = updatedMode ? 'anzhiyu-icon-history' : 'anzhiyu-icon-calendar-days'

const isReprint = Boolean(data.copyright_author) && data.copyright_author !== site.author
const categories = post.categories
const tags = post.tags
/** `page.location || theme.post_copyright.location`。 */
const location =
  typeof data.location === 'string' && data.location
    ? data.location
    : (theme.post_copyright.location as string)

/** `theme.dynamicEffect.postTopWave`。 */
const wavesEnabled = (theme.dynamicEffect as { postTopWave?: boolean }).postTopWave === true
---

<div id="post-info">
  <div id="post-firstinfo">
    <div class="meta-firstline">
      {isReprint ? (
        <a class="post-meta-original">转载</a>
      ) : (
        <a class="post-meta-original">原创</a>
      )}
      {
        postMeta.categories && categories.length > 0 && (
          <span class="post-meta-categories">
            {dateType && <span class="post-meta-separator" />}
            {categories.map((category, index) => (
              <>
                <i class="anzhiyufont anzhiyu-icon-inbox post-meta-icon" />
                <a class="post-meta-categories" href={categoryHref(category.path)} itemprop="url">
                  {category.name}
                </a>
                {index < categories.length - 1 && (
                  <i class="anzhiyufont anzhiyu-icon-angle-right post-meta-separator" />
                )}
              </>
            ))}
          </span>
        )
      }
      {
        theme.post_meta.page.tags && tags.length > 0 && (
          <span class="article-meta tags">
            {tags.map((tag) => (
              <a class="article-meta__tags" href={tag.href} tabindex="-1" itemprop="url">
                <span><i class="anzhiyufont anzhiyu-icon-hashtag" />{tag.name}</span>
              </a>
            ))}
          </span>
        )
      }
    </div>
  </div>

  <h1 class="post-title" itemprop="name headline">{post.title}</h1>

  <div id="post-meta">
    <div class="meta-firstline">
      {
        dateType && (
          <span class="post-meta-date">
            {isBoth ? (
              <>
                <i class="anzhiyufont anzhiyu-icon-calendar-days post-meta-icon" />
                <span class="post-meta-label">{_p('post.created')}</span>
                <time
                  class="post-meta-date-created"
                  itemprop="dateCreated datePublished"
                  datetime={post.date.xml}
                  title={`${_p('post.created')} ${post.date.full}`}
                >
                  {post.date.display}
                </time>
                <span class="post-meta-separator" />
                <i class="anzhiyufont anzhiyu-icon-history post-meta-icon" />
                <span class="post-meta-label">{_p('post.updated')}</span>
                <time
                  class="post-meta-date-updated"
                  itemprop="dateCreated datePublished"
                  datetime={post.updated.xml}
                  title={`${_p('post.updated')} ${post.updated.full}`}
                >
                  {post.updated.display}
                </time>
              </>
            ) : (
              <>
                <i class:list={['post-meta-icon', 'anzhiyufont', mainIcon]} />
                <span class="post-meta-label">{mainLabel}</span>
                <time
                  itemprop="dateCreated datePublished"
                  datetime={mainDate.xml}
                  title={`${mainLabel} ${mainDate.full}`}
                >
                  {mainDate.display}
                </time>
              </>
            )}
          </span>
        )
      }
    </div>

    <div class="meta-secondline">
      {
        theme.post_copyright.enable && location && (
          <>
            <span class="post-meta-separator" />
            <span class="post-meta-position" title={`作者IP属地为${location}`}>
              <i class="anzhiyufont anzhiyu-icon-location-dot" />
              {location}
            </span>
          </>
        )
      }
    </div>
  </div>
</div>

{
  wavesEnabled && (
    <section class="main-hero-waves-area waves-area">
      <svg
        class="waves-svg"
        xmlns="http://www.w3.org/2000/svg"
        xlink="http://www.w3.org/1999/xlink"
        viewBox="0 24 150 28"
        preserveAspectRatio="none"
        shape-rendering="auto"
      >
        <defs>
          <path
            id="gentle-wave"
            d="M -160 44 c 30 0 58 -18 88 -18 s 58 18 88 18 s 58 -18 88 -18 s 58 18 88 18 v 44 h -352 Z"
          />
        </defs>
        <g class="parallax">
          <use href="#gentle-wave" x="48" y="0" />
          <use href="#gentle-wave" x="48" y="3" />
          <use href="#gentle-wave" x="48" y="5" />
          <use href="#gentle-wave" x="48" y="7" />
        </g>
      </svg>
    </section>
  )
}

<div id="post-top-cover">
  <img class="nolazyload" id="post-top-bg" src={bgImg} />
</div>
