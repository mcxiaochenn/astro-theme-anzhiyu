---
/**
 * PostCard.astro — 首页/分类/标签列表里的一张文章卡片（P2-7）。
 *
 * 上游模板：`layout/includes/mixins/post-ui.pug` 的 `+postUI` 循环体。
 * 对应关系（左上方 pug → 右下方本组件）：
 *
 *   div.recent-post-item[.lastestpost-item]          → 同
 *   .post_cover.left|right > a[style] > img.post_bg   → 同（cover 为字符串且 index_enable）
 *   .recent-post-info[.no-cover]                     → 同（cover 为 false 或 index_enable 关闭）
 *   .recent-post-info-top
 *     .recent-post-info-top-tips
 *       span.article-meta.sticky-warp                  → is_home() && (top || sticky>0)
 *       .article-categories-original × N               → post_meta.page.categories
 *       span.newPost                                   → is_current('/') && maxDate === article.date
 *       a.unvisited-post                               → 恒输出
 *     a.article-title
 *   .article-meta-wrap
 *     span.post-meta-date                              → post_meta.page.date_type 三态
 *     span.article-meta.tags > a.article-meta__tags    → post_meta.page.tags
 *   .content                                           → index_post_content 四态
 *
 * 不渲染的上游分支（本基准站配置下不可达，留给对应阶段）：
 *   - 评论数块（`theme.comments.card_post_count`，默认 false + 评论系统未接）→ P4/P5 接评论时加；
 *   - 广告位 `.recent-post-item.ads-wrap`（`theme.ad.index`，基准配置没有 ad 段）。
 */
import { getThemeConfig } from '../../layouts/theme-context.ts'
import { createUrlFor } from '../../layouts/site.ts'
import { t } from '../../i18n/index.ts'
import { LAZYLOAD_PLACEHOLDER, type PreparedPost } from './post-list.ts'

interface Props {
  post: PreparedPost
  /** 卡片在列表里的下标（`class=lastestpost-item`、`cover.position: both` 的左右交替）。 */
  index: number
  /** 站点语言（`_p()` 的 page.lang → config.language 回退链）。 */
  language?: string | null
  /** 是否首页（上游 `is_home()`）：首页才输出置顶角标。 */
  isHome?: boolean
  /** 是否根路径第 1 页（上游 `is_current("/")`）：只有它才输出「最新」角标。 */
  showNew?: boolean
}

const { post, index, language = null, isHome = false, showNew = false } = Astro.props
const theme = getThemeConfig()
const pageMeta = theme.post_meta.page
const urlFor = createUrlFor('/')

/** `_p()`：缺键回退 default 语言再回退键名（见 i18n/index.ts）。 */
const _p = (key: string): string => t(key, language)

/* ------------------------------------------------------------------ */
/* 1. 封面分支（post-ui.pug:20-24）                                     */
/* ------------------------------------------------------------------ */

/** `theme.cover.index_enable`。 */
const coverIndexEnabled = theme.cover.index_enable !== false

/** `leftOrRight`：`position: both` 时按列表下标左右交替，否则只看配置。 */
const coverPosition = theme.cover.position ?? 'left'
const coverSide =
  coverPosition === 'both'
    ? index % 2 === 0
      ? 'left'
      : 'right'
    : coverPosition === 'left'
      ? 'left'
      : 'right'

/** 是否输出 `.post_cover` 整块（pug: `if post_cover && theme.cover.index_enable`）。 */
const hasCoverBlock = typeof post.cover === 'string' && post.cover !== '' && coverIndexEnabled

/** `no_cover`：`article.cover === false || !theme.cover.index_enable`。 */
const noCoverClass = post.cover === false || !coverIndexEnabled ? 'no-cover' : ''

/* ------------------------------------------------------------------ */
/* 2. 封面图的 lazyload 改写（scripts/filters/post_lazyload.js）         */
/* ------------------------------------------------------------------ */

/**
 * 上游是 `after_render:html` 全站过滤器：把 `<img … src="x">` 改写成
 * `src=<placeholder> onerror=… data-lazy-src="x"`。Astro 没有这个钩子，
 * 所以这里在组件里直接输出改写后的最终形态（属性值与 baseline 对齐，见 §5 证据）。
 */
const lazyload = theme.lazyload as { enable?: boolean; field?: string; placeholder?: string | null }
const lazyloadEnabled = lazyload?.enable === true && lazyload?.field === 'site'
const lazyloadPlaceholder = lazyload?.placeholder
  ? urlFor(lazyload.placeholder)
  : LAZYLOAD_PLACEHOLDER
const coverSrc = typeof post.cover === 'string' ? urlFor(post.cover) : ''
const errorImages = theme.error_img as { post_page?: string }
const errorPostPage = urlFor(errorImages.post_page ?? '/img/404.jpg')

/* ------------------------------------------------------------------ */
/* 3. 日期分支（post-ui.pug:54-80）                                     */
/* ------------------------------------------------------------------ */

const dateType = pageMeta.date_type
const dateFormat = pageMeta.date_format
const iconStyle = dateFormat === 'simple' ? 'font-size: 15px; display:none' : 'font-size: 15px'
/** date_type 单值分支：`created` / `updated`，决定主时间取哪个字段。 */
const dateTypeUpdated = dateType === 'updated'
const mainDate = dateTypeUpdated ? post.updated : post.date
const otherDate = dateTypeUpdated ? post.date : post.updated
const mainIcon = dateTypeUpdated ? 'anzhiyu-icon-history' : 'anzhiyu-icon-calendar-days'
const mainLabel = _p(dateTypeUpdated ? 'post.updated' : 'post.created')
const otherLabel = _p(dateTypeUpdated ? 'post.created' : 'post.updated')
---

<div
  class:list={['recent-post-item', index === 0 && 'lastestpost-item']}
  onclick={`pjax.loadUrl('${post.href}')`}
>
  {
    hasCoverBlock && (
      <div class:list={['post_cover', coverSide]}>
        <a href={post.href} title={post.title} style="display: flex;height: 100%;">
          {lazyloadEnabled ? (
            <img
              class="post_bg"
              src={lazyloadPlaceholder}
              onerror={`this.onerror=null,this.src="${errorPostPage}"`}
              data-lazy-src={coverSrc}
              alt={post.title}
              style="pointer-events: none"
            />
          ) : (
            <img
              class="post_bg"
              src={coverSrc}
              onerror={`this.onerror=null;this.src='${errorPostPage}'`}
              alt={post.title}
              style="pointer-events: none"
            />
          )}
        </a>
      </div>
    )
  }

  <div class:list={['recent-post-info', noCoverClass]}>
    <div class="recent-post-info-top">
      <div class="recent-post-info-top-tips">
        {
          isHome && (post.top || post.sticky > 0) && (
            <span class="article-meta sticky-warp">
              <i class="anzhiyufont anzhiyu-icon-thumbtack sticky" />
              <span class="sticky">{_p('sticky')}</span>
            </span>
          )
        }
        {
          pageMeta.categories &&
            post.categories.map((category) => (
              <div class="article-categories-original">{category.name}</div>
            ))
        }
        {showNew && post.isNewest && <span class="newPost">{_p('post.new')}</span>}
        <a class="unvisited-post" href={post.href} title={post.title}>
          {_p('post.unread')}
        </a>
      </div>
      <a class="article-title" href={post.href} title={post.title}>
        {post.title}
      </a>
    </div>

    <div class="article-meta-wrap">
      {
        dateType && (
          <span class="post-meta-date">
            {dateType === 'both' ? (
              <>
                <i
                  class="anzhiyufont anzhiyu-icon-calendar-alt"
                  style={dateFormat === 'simple' ? 'display:none' : undefined}
                />
                <span class="article-meta-label">{_p('post.created')}</span>
                <time
                  class="post-meta-date-created"
                  datetime={post.date.xml}
                  title={`${_p('post.created')} ${post.date.full}`}
                  time={post.date.full}
                >
                  {post.date.display}
                </time>
                <span class="article-meta-separator" />
                <i
                  class="anzhiyufont anzhiyu-icon-history"
                  style={iconStyle}
                />
                <span class="article-meta-label">{_p('post.updated')}</span>
                <time
                  class="post-meta-date-updated"
                  datetime={post.updated.xml}
                  title={`${_p('post.updated')} ${post.updated.full}`}
                  time={post.updated.full}
                >
                  {post.updated.display}
                </time>
              </>
            ) : (
              <>
                <i class:list={['anzhiyufont', mainIcon]} style={iconStyle} />
                <span class="article-meta-label">{mainLabel}</span>
                <time
                  datetime={mainDate.xml}
                  title={`${mainLabel} ${mainDate.full}`}
                  time={mainDate.full}
                >
                  {mainDate.display}
                </time>
                <time
                  class="time_hidden"
                  datetime={otherDate.xml}
                  title={`${otherLabel} ${otherDate.full}`}
                  time={otherDate.full}
                >
                  {otherDate.display}
                </time>
              </>
            )}
          </span>
        )
      }

      {
        pageMeta.tags && post.tags.length > 0 && (
          <span class="article-meta tags">
            {post.tags.map((tag) => (
              <a
                class="article-meta__tags"
                event.cancelbubble
                href={tag.href}
                onclick="window.event.cancelBubble=true;"
              >
                <span>
                  <i class="anzhiyufont anzhiyu-icon-hashtag" />
                  {tag.name}
                </span>
              </a>
            ))}
          </span>
        )
      }
    </div>

    {post.excerpt !== null && <div class="content" set:html={post.excerpt} />}
  </div>
</div>
