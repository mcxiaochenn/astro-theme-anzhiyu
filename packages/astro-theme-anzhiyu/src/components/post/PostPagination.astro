---
/**
 * PostPagination.astro — 上游 `layout/includes/pagination.pug:9-31` 的文章页分支（P2-8）。
 *
 *   nav#pagination.pagination-post
 *     .prev-post.pull-left|pull-full       page.prev（更旧的一篇）
 *       a[href] > img.prev-cover + .pagination-info(.label + .prev_info)
 *     .next-post.pull-right|pull-full      page.next（更新的一篇）
 *       a[href] > img.next-cover + .pagination-info(.label + .next_info)
 *
 * `theme.post_pagination` 为 1/3/4 时上游交换 prev/next；解析发生在页面层
 * （`preparePostPage` 给出的 prev/next 已按配置对齐），这里只负责渲染。
 */
import { getThemeConfig } from '../../layouts/theme-context.ts'
import { createUrlFor } from '../../layouts/site.ts'
import { tp } from '../../i18n/index.ts'
import { lazyImageAttrs } from '../layout/lazyload.ts'
import type { PreparedPost } from './post-list.ts'

interface Props {
  prev: PreparedPost | null
  next: PreparedPost | null
  language?: string | null
}

const { prev, next, language = null } = Astro.props
const theme = getThemeConfig()
const urlFor = createUrlFor('/')
const _p = (key: string) => tp(key, language)

const lazyload = theme.lazyload as { enable?: boolean; field?: string }
const lazyloadEnabled = lazyload?.enable === true && lazyload?.field === 'site'
const errorImage = (theme.error_img as { post_page?: string }).post_page ?? '/img/404.jpg'

/** `pagination_cover = post.cover === false ? post.randomcover : post.cover`。 */
function coverOf(post: PreparedPost): string {
  const cover = post.cover === false ? undefined : post.cover
  return urlFor(cover)
}

function coverAttrs(post: PreparedPost, className: string, alt: string): Record<string, string> {
  const src = coverOf(post)
  if (lazyloadEnabled) return { class: className, alt, ...lazyImageAttrs(src, { theme, urlFor }) }
  return {
    class: className,
    src,
    onerror: `onerror=null;src='${urlFor(errorImage)}'`,
    alt,
  }
}
---

{
  (prev || next) && (
    <nav class="pagination-post" id="pagination">
      {prev && (
        <div class:list={['prev-post', next ? 'pull-left' : 'pull-full']}>
          <a href={prev.href}>
            <img {...coverAttrs(prev, 'prev-cover', 'cover of previous post')} />
            <div class="pagination-info">
              <div class="label">{_p('pagination.prev')}</div>
              <div class="prev_info">{prev.title}</div>
            </div>
          </a>
        </div>
      )}
      {next && (
        <div class:list={['next-post', prev ? 'pull-right' : 'pull-full']}>
          <a href={next.href}>
            <img {...coverAttrs(next, 'next-cover', 'cover of next post')} />
            <div class="pagination-info">
              <div class="label">{_p('pagination.next')}</div>
              <div class="next_info">{next.title}</div>
            </div>
          </a>
        </div>
      )}
    </nav>
  )
}
