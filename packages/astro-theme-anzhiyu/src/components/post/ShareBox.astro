---
/**
 * ShareBox.astro — 文章分享区（P2-8 建立，P5-2 改为委托 third-party/share/index）。
 *
 * 上游 `layout/includes/post/post-copyright.pug:42 / :63` 调用
 * `third-party/share/index.pug`，由它按 `theme.sharejs.enable` / `theme.addtoany.enable`
 * 二选一出 `.post_share`。P5-2 直接把渲染交给 `third-party/share/index.astro`，
 * 本组件只负责把上游的 `url_for(page.cover || theme.avatar.img)` 算好传进去
 * （third-party 的 renderShareJs 本身不做 url_for）。
 */
import { createUrlFor } from '../../layouts/site.ts'
import ShareIndex from '../third-party/share/index.astro'
import { getThemeConfig } from '../../layouts/theme-context.ts'
import type { PreparedPost } from './post-list.ts'

interface Props {
  post: PreparedPost
}

const { post } = Astro.props
const theme = getThemeConfig()
const urlFor = createUrlFor('/')
const avatar = (theme.avatar as { img?: string }).img ?? ''

/** 上游 `url_for(page.cover || theme.avatar.img)`。 */
const image =
  typeof post.cover === 'string' && post.cover !== '' ? post.cover : avatar
---

<ShareIndex cover={urlFor(image)} />
