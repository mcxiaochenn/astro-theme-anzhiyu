---
/**
 * ShareBox.astro — 上游 `layout/includes/third-party/share/index.pug` +
 * `share/share-js.pug`（P2-8）。
 *
 * 基准配置：`sharejs.enable: true`、`addtoany.enable: false`，所以只走 share.js 分支。
 * `data-image` 取 `page.cover || theme.avatar.img`；`data-sites` 取 `sharejs.sites`。
 *
 * 资源 URL 与 baseline 一致（上游 `theme.asset.sharejs_css` / `theme.asset.sharejs`
 * 由主题的 asset 表生成，基准产物是 butterfly-extsrc@1.1.3）。Phase 4 资源层接管后
 * 应改为读取同一张 asset 表；现在直接写字面量，避免引入不存在的配置键。
 */
import { getThemeConfig } from '../../layouts/theme-context.ts'
import { createUrlFor } from '../../layouts/site.ts'
import type { PreparedPost } from './post-list.ts'

interface Props {
  post: PreparedPost
}

const { post } = Astro.props
const theme = getThemeConfig()
const urlFor = createUrlFor('/')

const sharejs = theme.sharejs as { enable?: boolean; sites?: string }
const avatar = (theme.avatar as { img?: string }).img ?? ''

const enabled = sharejs.enable === true
const image = urlFor(typeof post.cover === 'string' && post.cover !== '' ? post.cover : avatar)
const sites = sharejs.sites ?? ''

const SHAREJS_CSS =
  'https://cdn.cbd.int/butterfly-extsrc@1.1.3/sharejs/dist/css/share.min.css'
const SHAREJS_JS =
  'https://cdn.cbd.int/butterfly-extsrc@1.1.3/sharejs/dist/js/social-share.min.js'
---

{
  enabled && (
    <div class="post_share">
      <div class="social-share" data-image={image} data-sites={sites} />
      <link
        rel="stylesheet"
        href={SHAREJS_CSS}
        media="print"
        onload="this.media='all'"
      />
      <script is:inline src={SHAREJS_JS} defer />
    </div>
  )
}
