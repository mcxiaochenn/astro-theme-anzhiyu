---
/**
 * CategoryBar.astro — `#recent-posts` 顶部的分类条（P2-7）。
 *
 * 上游模板：`layout/includes/categoryGroup.pug`：
 *
 *   #categoryBar
 *     #category-bar.category-bar
 *       #catalog-bar
 *         #catalog-list
 *           .catalog-list-item(id='首页')
 *             a(href="/") 首页
 *           != catalog_list("categories")            ← scripts/helpers/catalog_list.js
 *         .category-bar-next#category-bar-next       ← onclick 横向滚动
 *           i.anzhiyufont.anzhiyu-icon-angle-double-right
 *         a.catalog-more(href="/categories/") 更多
 *
 * `catalog_list.js` 输出 `<div class="catalog-list-item" id="/<item.path>"><a href="/<item.path>">…`，
 * 注意 **不经过 url_for**：baseline 里分类路径是中文原文（未 percent-encode），
 * 与卡片标签链接（走 url_for 编码）不同。
 *
 * 分类的展示顺序由基准站 `reproducible.js` 固定为 name 码点升序，
 * `collectCategoryBarItems()` 已经按这个口径排好（见 post-list.ts）。
 */
import type { CategoryBarItem } from './post-list.ts'
import { createUrlFor } from '../../layouts/site.ts'

interface Props {
  items: CategoryBarItem[]
}

const { items } = Astro.props

/** 站内链接前缀（子路径部署跟随 Astro base）。 */
const urlFor = createUrlFor(import.meta.env.BASE_URL || '/')

/** `catalog_list.js` 的 `id="/${item.path}"` 与 `href="/${item.path}"`。 */
const pathOf = (item: CategoryBarItem): string => `/${item.path}`
---

<div id="categoryBar">
  <div id="category-bar" class="category-bar">
    <div id="catalog-bar">
      <div id="catalog-list">
        <div class="catalog-list-item" id="首页">
          <a href={urlFor('/')}>首页</a>
        </div>
        {
          items.map((item) => (
            <div class="catalog-list-item" id={pathOf(item)}>
              <a href={urlFor(pathOf(item))}>{item.name}</a>
            </div>
          ))
        }
      </div>
      <div
        class="category-bar-next"
        id="category-bar-next"
        onclick="anzhiyu.scrollCategoryBarToRight()"
      >
        <i class="anzhiyufont anzhiyu-icon-angle-double-right" />
      </div>
      <a class="catalog-more" href={urlFor('/categories/')}>更多</a>
    </div>
  </div>
</div>
