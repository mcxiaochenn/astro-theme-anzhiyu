---
/**
 * AdditionalJs.astro — 上游 `layout/includes/additional-js.pug` 的子树（P4-1/P4-3）。
 *
 * 挂载点：BaseLayout 里 `layout.pug:88` 的 `div`（`#rightmenu-mask` 之后、
 * `#popup-window` 之前）。**整棵子树都在这个 div 里**，所以组件本身输出 `<div>`，
 * 由 BaseLayout 直接放置。
 *
 * 顺序与上游逐行一致（当前配置命中的分支）：
 *   utils → main → tw_cn → fancybox → instantpage → lazyload → snackbar →
 *   canvas#universe + dark.js → log-js → random.js → `.js-pjax`
 *   (people 内联 + input#page-type) → visitorMail → waterfall → qrcode →
 *   ali_iconfont_css → aplayer(css/js/meting) → [pjax 由 ClientRouter 取代] → accesskey
 *
 * 关键取舍：
 *   - **不再加载上游 Pjax**：`pjax@0.2.8` + 它的初始化内联块由 `head/runtime.ts`
 *     映射到 `<ClientRouter />`（astro:before-swap → pjax:send，astro:page-load →
 *     pjax:complete + refreshFn）。因此这里少 2 个节点，属登记在案的差异。
 *   - 上游 `script[data-pjax]` 的重执行语义用 `data-astro-rerun` 表达（P1.5 §3.2）；
 *     当前命中的只有 waterfall。
 *   - `theme.asset` 的取值走 `config/assets.ts`：internal=local（`/js/...`），
 *     third_party=cbd（`https://cdn.cbd.int/...`）。
 */
import { getThemeConfig } from '../../layouts/theme-context.ts'
import { createUrlFor, type SiteConfig } from '../../layouts/site.ts'
import { resolveAssets } from '../../config/assets.ts'
import { buildLogJs } from './log-js.ts'

interface Props {
  site: SiteConfig
  isHome?: boolean
  pageType?: 'post' | 'page'
  /** 上游 `page.type || (is_post ? 'post' : (is_category ? 'categories' : 'anzhiyu'))`。 */
  pageTypeValue?: string
}

const { site, isHome = false, pageType = 'page', pageTypeValue } = Astro.props

const theme = getThemeConfig()
const urlFor = createUrlFor(site.root ?? '/')
const assets = resolveAssets(theme)
const assetUrl = (key: string) => urlFor(assets[key] ?? '')

/** looseObject 区块的安全读取。 */
function obj(section: unknown): Record<string, unknown> {
  return section && typeof section === 'object' ? (section as Record<string, unknown>) : {}
}
function flag(section: unknown, key: string, fallback = false): boolean {
  const value = obj(section)[key]
  return typeof value === 'boolean' ? value : fallback
}
function str(section: unknown, key: string, fallback = ''): string {
  const value = obj(section)[key]
  return typeof value === 'string' ? value : fallback
}

const translateEnabled = flag(theme.translate, 'enable')
const fancyboxEnabled = theme.fancybox === true
const mediumZoomEnabled = theme.medium_zoom === true
const instantpageEnabled = theme.instantpage === true
const lazyloadEnabled = flag(theme.lazyload, 'enable')
const snackbarEnabled = flag(theme.snackbar, 'enable')
const panguEnabled = flag(theme.pangu, 'enable')
const universeEnabled = flag(theme.universe, 'enable')
const consoleEnabled = flag(theme.console, 'enable')
const visitorMailEnabled = flag(theme.visitorMail, 'enable')
const rightClickMenuEnabled = flag(theme.rightClickMenu, 'enable')
const aplayerEnabled = flag(theme.aplayerInject, 'enable')
const aplayerPerPage = flag(theme.aplayerInject, 'per_page')
const accesskeyEnabled = flag(theme.accesskey, 'enable')
const peoplecanvasEnabled = flag(theme.peoplecanvas, 'enable')
const aliIcons = obj(theme.icons)
const aliIconfontJs = str(aliIcons, 'ali_iconfont_js')
const mainTone = obj(theme.mainTone)

/** 上游 `theme.asset.meting_api`（插件表里没有，默认 undefined）。 */
const metingApi = typeof assets.meting_api === 'string' ? assets.meting_api : ''

/** 上游 `layout/includes/anzhiyu/log-js.pug` 的四个插值。 */
const footer = obj(theme.footer)
const footerOwner = obj(footer.owner)
const footerRuntime = obj(footer.runtime)
/** `get_version('tags')` 的等价：上游版本号 1.7.1（见 config/assets.ts 的 INTERNAL_VERSION）。 */
const themeVersion = '1.7.1'
const logScript = consoleEnabled
  ? buildLogJs({
      author: site.author ?? '',
      since: (footerOwner.since as string | number | undefined) ?? '',
      launchTime: str(footerRuntime, 'launch_time'),
      version: themeVersion,
    })
  : ''

/** 上游 `page.type` 的等价：BaseLayout 传 `pageTypeValue`，缺省按 page/post 推导。 */
const resolvedPageType = pageTypeValue ?? (pageType === 'post' ? 'post' : 'anzhiyu')

/** peoplecanvas 内联脚本（additional-js.pug:57-65）。 */
const peopleScript = `if (typeof gsap === "object") {
  getScript("${assetUrl('people_js')}", {defer:true})
} else {
  getScript("${assetUrl('gsap_js')}").then(()=>{
    getScript("${assetUrl('people_js')}", {defer:true})
  });
}`
---

<div>
  <script is:inline src={assetUrl('utils')}></script>
  <script is:inline src={assetUrl('main')}></script>

  {translateEnabled && <script is:inline src={assetUrl('translate')}></script>}

  {mediumZoomEnabled
    ? <script is:inline src={assetUrl('medium_zoom')}></script>
    : fancyboxEnabled && <script is:inline src={assetUrl('fancybox')}></script>}

  {instantpageEnabled && <script is:inline src={assetUrl('instantpage')} type="module"></script>}
  {lazyloadEnabled && <script is:inline src={assetUrl('lazyload')}></script>}
  {snackbarEnabled && <script is:inline src={assetUrl('snackbar')}></script>}

  {panguEnabled && (
    <script is:inline set:html={`pangu.spacingElementByClassName('post-content')`}></script>
  )}

  {metingApi && <script is:inline set:html={`var meting_api = "${metingApi}";`}></script>}

  {universeEnabled && (
    <>
      <canvas id="universe"></canvas>
      <script is:inline async src="https://npm.elemecdn.com/anzhiyu-theme-static@1.0.0/dark/dark.js"></script>
    </>
  )}

  {consoleEnabled && <script is:inline set:html={logScript}></script>}

  <script is:inline async src="/anzhiyu/random.js"></script>

  <div class="js-pjax">
    {peoplecanvasEnabled && isHome && <script is:inline set:html={peopleScript}></script>}
    <input type="hidden" name="page-type" id="page-type" value={resolvedPageType} />
  </div>

  {visitorMailEnabled && (
    <script is:inline set:html={`var visitorMail = "${str(theme.visitorMail, 'mail')}";`}></script>
  )}

  <script is:inline async data-pjax data-astro-rerun src={assetUrl('waterfall')}></script>
  <script is:inline src="https://cdn.cbd.int/qrcodejs@1.0.0/qrcode.min.js"></script>

  {rightClickMenuEnabled && <script is:inline src={assetUrl('right_click_menu_js')}></script>}

  <link rel="stylesheet" href={assetUrl('ali_iconfont_css')} />
  {aliIconfontJs && <script is:inline async src={aliIconfontJs}></script>}

  {aplayerEnabled && (Boolean(theme.pjax.enable) || aplayerPerPage) && (
    <>
      <link rel="stylesheet" href={assetUrl('aplayer_css')} media="print" onload="this.media='all'" />
      <script is:inline src={assetUrl('aplayer_js')}></script>
      <script is:inline src={assetUrl('meting_js')}></script>
    </>
  )}

  {accesskeyEnabled && <script is:inline charset="UTF-8" src={assetUrl('accesskey_js')}></script>}
</div>
