{
  "name": "astro-theme-anzhiyu",
  "version": "1.0.0",
  "private": true,
  "description": "Anzhiyu（Hexo hexo-theme-anzhiyu）博客主题的 Astro 移植版 · 模板仓：Use this template / clone 后改 theme.config.yml、替换 src/content/ 即可运行",
  "type": "module",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcxiaochenn/astro-theme-anzhiyu.git"
  },
  "homepage": "https://github.com/mcxiaochenn/astro-theme-anzhiyu#readme",
  "bugs": {
    "url": "https://github.com/mcxiaochenn/astro-theme-anzhiyu/issues"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "theme",
    "blog",
    "anzhiyu",
    "butterfly",
    "hexo"
  ],
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "verify": "node scripts/verify-css.mjs",
    "compare-vars": "node scripts/compare-css-vars.mjs",
    "check:upstream-delta": "node scripts/check-upstream-delta.mjs",
    "check:upstream-sync": "node scripts/check-upstream-sync.mjs",
    "diff:html": "node scripts/diff-html.mjs",
    "baseline:extract": "node scripts/extract-baseline-html.mjs",
    "test:e2e": "playwright test",
    "test:remark": "node tests/remark-hexo-tag/run.mjs",
    "test:remark-fixtures": "node tests/remark-hexo-tag/render-fixtures.mjs",
    "accept:migration": "node scripts/accept-migration.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:loader": "node scripts/check-loader.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:helpers": "node scripts/check-helpers.mjs",
    "check:date": "node scripts/check-date.mjs",
    "check:slugger": "node scripts/check-slugger.mjs",
    "check:third-party": "node scripts/check-third-party.mjs",
    "gen:defaults": "node scripts/gen-defaults.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@vite-pwa/astro": "^2.0.4",
    "astro": "^7.4.13",
    "highlight.js": "^11.12.0",
    "stylus": "^0.64.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "playwright": "1.65.1"
  }
}
