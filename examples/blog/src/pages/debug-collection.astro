---
/**
 * P2-1 临时验证页：证明 fixtures/ 的 10 篇内容能被内容集合读到。
 *
 * Phase 2 后续会被真实页面（首页 / 文章页 / 归档页）替换，此页只做三件事：
 * 1. 列出集合里全部条目（期望 10 条）与 id；
 * 2. 按 slug/id 取一篇（longform-hexo-astro）并读出 frontmatter；
 * 3. 确认 about 页被识别为独立页面（layout: page + type: about），
 *    并用渲染结果验证 unified 处理器下的 GFM 表格 / 删除线 / 脚注。
 */
import { getCollection, getEntry, render } from 'astro:content'

const entries = await getCollection('posts')
const ids = entries.map((entry) => entry.id).sort()
const articles = entries.filter((entry) => entry.data.layout !== 'page')
const pages = entries.filter((entry) => entry.data.layout === 'page')
const about = entries.find((entry) => entry.data.type === 'about')

const targetId = 'longform-hexo-astro'
const target = await getEntry('posts', targetId)
const targetRendered = target ? await render(target) : undefined
const targetHtml = target?.rendered?.html ?? ''
const footnote = /<section[^>]*data-footnotes[^>]*>[\s\S]*?<\/section>/.exec(targetHtml)?.[0] ?? ''

const report = {
  '集合 posts 条目数': entries.length,
  '集合 posts 的 id（排序后）': ids,
  '内容来源 filePath 样例': entries.slice(0, 3).map((entry) => entry.filePath),
  '所有 filePath 都指向 ../../fixtures/（未复制）': entries.every((entry) => entry.filePath?.startsWith('../../fixtures/')),
  '文章数（layout !== page）': articles.length,
  '独立页面数（layout === page）': pages.length,
  '独立页面 id': pages.map((entry) => entry.id),
  'about 是否存在': Boolean(about),
  'about.layout': about?.data.layout,
  'about.type': about?.data.type,
  'getEntry("longform-hexo-astro") 命中': Boolean(target),
  '取到的 id': target?.id,
  '取到的 title': target?.data.title,
  '取到的 date（Hexo 语义，ISO）': target?.data.date?.toISOString() ?? null,
  '取到的 tags': target?.data.tags,
  '渲染 headings 数': targetRendered?.headings.length ?? 0,
  '渲染 HTML 含 <table>': targetHtml.includes('<table>'),
  '渲染 HTML 含 <del>': targetHtml.includes('<del>'),
  '渲染 HTML 含 GFM 脚注区块（data-footnotes）': targetHtml.includes('data-footnotes'),
  '渲染 HTML 保留行内公式原文 mc^2': targetHtml.includes('mc^2'),
  '脚注区块 HTML 片段': footnote,
}

// 构建日志里直接能看到「10 条」与 about 的类型识别
console.log(`[debug-collection] 集合 posts 条目数 = ${entries.length}`)
console.log(`[debug-collection] ids = ${ids.join(', ')}`)
console.log(`[debug-collection] 文章 = ${articles.length} 篇 / 独立页面 = ${pages.length} 个（${pages.map((entry) => entry.id).join(', ')}）`)
console.log(`[debug-collection] about 页识别: layout=${about?.data.layout} type=${about?.data.type}`)
console.log(`[debug-collection] getEntry('${targetId}') = ${target?.data.title} / date=${target?.data.date?.toISOString()}`)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>P2-1 内容集合验证</title>
  </head>
  <body>
    <h1>P2-1 内容集合验证（临时页面）</h1>
    <p>数据源：<code>fixtures/*.md</code>，经 glob loader 直接读取，未复制。</p>
    <pre id="debug-collection-output">{JSON.stringify(report, null, 2)}</pre>
    <h2>渲染探针：长文 fixture 的正文片段</h2>
    {
      targetHtml ? (
        <div id="debug-rendered-probe" set:html={targetHtml} />
      ) : (
        <p id="debug-rendered-probe">未取到 longform-hexo-astro</p>
      )
    }
    <p>条目渲染总数：{entries.length}</p>
  </body>
</html>
