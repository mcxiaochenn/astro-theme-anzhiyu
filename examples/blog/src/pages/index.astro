---
/**
 * 首页 · 第 1 页（P2-7）
 *
 * 上游模板：`layout/index.pug`
 *
 *   #recent-posts.recent-posts
 *     include includes/categoryGroup.pug      → <CategoryBar />
 *     +postUI                                 → <PostCard /> × per_page
 *     include includes/pagination.pug         → <Pagination />
 *
 * 分页模型：Hexo `_config.yml` 的 `index_generator.per_page: 6`，
 * 第 1 页由本文件生成（`/`），第 2..N 页由 `[...page].astro` 生成（`/page/2/`...）。
 * 两个页面共用 `components/post/post-list.ts` 的排序 / 切页 / 摘要语义，只是取第几页不同。
 *
 * 排序（复刻 `hexo-generator-index` + `.baseline-work/scripts/reproducible.js`）：
 * sticky 降序 → date 降序 → 同日期 path 码点升序。
 *
 * 站点元数据仍以页面常量传入（Phase 7 的迁移脚本把 Hexo `_config.yml` 落成站点配置层后，
 * 这份常量应删除；`[...page].astro` 里有一份同样的常量，届时一并删）。
 */
import BaseLayout from 'astro-theme-anzhiyu/layouts/BaseLayout.astro'
import PostCard from 'astro-theme-anzhiyu/components/post/PostCard.astro'
import Pagination from 'astro-theme-anzhiyu/components/post/Pagination.astro'
import CategoryBar from 'astro-theme-anzhiyu/components/post/CategoryBar.astro'
import {
  collectCategoryBarItems,
  paginatePosts,
  preparePosts,
} from 'astro-theme-anzhiyu/components/post/post-list.ts'
import { postHrefOf } from 'astro-theme-anzhiyu/utils/url-utils.ts'
import type { EssayGroup } from 'astro-theme-anzhiyu/components/page/types.ts'
import '../styles/upstream/index.styl'
import { getCollection } from 'astro:content'

import { SITE_IDENTITY } from '../data/site-identity.ts'
import { getSiteData } from '../data/site-data.ts'

/** 站点级元数据（基准站身份，对应上游 `config.*`）——集中定义见 src/data/site-identity.ts。 */
const site = SITE_IDENTITY

const entries = await getCollection('posts')
// 文章 URL 统一走站点 permalink 解析器（fixture 未配置 → 默认日期形态；迁移站由
// site.config.ts 注入源站 permalink，见 P7-4）。
const posts = preparePosts(entries, { resolvePostHref: postHrefOf(site) })
const { total, pages } = paginatePosts(posts)
const pagePosts = pages[0] ?? []
const categoryBarItems = collectCategoryBarItems(posts)

/** `site.data.essay` 等价物（bbTimeList 数据源，A6；home_essay 组门控在组件内）。 */
const essayData = getSiteData<EssayGroup[]>('essay')
---

<BaseLayout site={site} isHome essay={essayData}>
  <div id="recent-posts" class="recent-posts">
    <CategoryBar items={categoryBarItems} />
    {
      pagePosts.map((post, index) => (
        <PostCard post={post} index={index} language={site.language} isHome showNew />
      ))
    }
    <Pagination current={1} total={total} isHome format="page/%d/#content-inner" />
  </div>
</BaseLayout>
